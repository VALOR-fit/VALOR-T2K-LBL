
#define DrawOscFit true
#define DrawNuisFit false

#define DrawOscPull false
#define DrawNuisPull false

#define DrawOscRes false
#define DrawNuisRes false

#define NBinsFitPar 200
#define NBinsPull 200

const char * hierarchy = "normal";
const char * dmsqscheme = "abs23";
const char * mixparamchoice = "sinsqtheta";
const char * config_file = "analysis_configuration.xml";
const char * hypothesis = "3f_osc",   // "3f_osc", "4f_sterile_osc", "5f_sterile_osc

// Declare Histograms

TString *NameFitParAll;

TH1F **hFitParAll;
TH1F **hPullAll;
TH1F **hResAll;

TCanvas **cFitParAll;
TCanvas **cPullAll;
TCanvas **cResAll;

char name[200];

TLatex *DrawName(char *name,double x,double y){
  TLatex *tname = new TLatex(x,y,name);
  tname->SetTextSize(0.08);
  tname->Draw();
}

double calc_pull_osc(double centval,double fitval,double fiterr){
  double pull = (fitval-centval)/fiterr; 
  return pull;
}

double calc_res_osc(double centval,double fitval){
  double res = (fitval-centval)/fitval; 
  return res;
}

double calc_pull_nuis(double centval,double centerr,double fitval,double fiterr){
  double pull = (fitval-centval)/fiterr; 
  //double pull = (fitval-centval)/centerr; 

  cout << fitval << " - " << centval << " / " << fiterr << " = " << pull << endl;
  return pull;
}

void read_fit_data_sterile(const char * filename){

  using namespace std;
  using namespace t2kana;
  using namespace t2kana::conv;
  
  // Global options
  Opt::Instance()->gMassHierarchyAssumed = util::HierarchyFromString(hierarchy);
  Opt::Instance()->gOscDmsqScheme        = util::DmsqSchemeFromString(dmsqscheme);
  Opt::Instance()->gOscMixingParamChoice = util::MixingTypeFromString(mixparamchoice);
  if(Opt::Instance()->Undefined()) {
    cerr << "Global options not defined correctly. Exiting..." << endl;
    cerr << *Opt::Instance() << endl;
    exit(1);
  }

  // Analysis configuration
  const char * config = Form("%s/config/%s", gSystem->Getenv("T2KOSCANA"), config_file);
  
  SuperkExpectation * skexp = new SuperkExpectation;
  skexp->Read(config);
  PhysHypothesis ph(hypothesis); //initialisation is to no oscillations
  skexp->Generate(ph);
  
  // Object for storing input oscillation and nuisance params in each toy-MC
  PhysParamList * iparm = new PhysParamList;

  // Arrays for storing all pieces of fit data and the best-fit pdf (and its components) for each toy-MC.
  TObjArray * dat_array = new TObjArray; //only used to initialise branch
  TObjArray * pdf_array = new TObjArray; //only used to initialise branch
  dat_array->SetOwner(false);
  pdf_array->SetOwner(false);
  TObjArray * pdf_array1 = new TObjArray;
  pdf_array1->SetOwner(false);
  TObjArray * pdf_array2 = new TObjArray;
  pdf_array2->SetOwner(false);
  double fittime1, fittime2;
  int fitstatus1, fitstatus2;
  double chisq1, chisq2;

  // Fit parameter list
  FitParamList * fparm; //only used to initialise branch
  FitParamList * fparm1; //first fit (first octant)
  FitParamList * fparm2; //second fit (second octant)

  TFile *filein = new TFile(filename,"READ");
  TTree *fitnt = (TTree*) filein->Get("fitnt");
  
  // Create tree to store outputs
  fitnt->SetBranchAddress("fittime1",&fittime1);
  fitnt->SetBranchAddress("fittime2",&fittime2);
  fitnt->SetBranchAddress("fitstatus1",&fitstatus1);
  fitnt->SetBranchAddress("fitstatus2",&fitstatus2);
  fitnt->SetBranchAddress("chisq1",&chisq1);
  fitnt->SetBranchAddress("chisq2",&chisq2);
  fitnt->SetBranchAddress("best_fit_params",      &fparm);
  fitnt->SetBranchAddress("best_fit_params_fit1", &fparm1);
  fitnt->SetBranchAddress("best_fit_params_fit2", &fparm2);
  fitnt->SetBranchAddress("input_params",         &iparm);
  fitnt->SetBranchAddress("data",                 &dat_array);
  fitnt->SetBranchAddress("best_fit_pdf",         &pdf_array);
  fitnt->SetBranchAddress("best_fit_pdf_fit1",    &pdf_array1);
  fitnt->SetBranchAddress("best_fit_pdf_fit2",    &pdf_array2);
  //TBranch * br_fparm     = fitnt->GetBranch("best_fit_params");
  //TBranch * br_bf_array  = fitnt->GetBranch("best_fit_pdf");

  // Initialize Histograms

  cout << endl;
  cout << "Initialize Histograms" << endl;
  cout << endl;

  fitnt->GetEntry(0); // Get Tree general informations

  double max=-999.;
  double min=-999.;

  int np = fparm->GetNumberParameters();

  NameFitParAll = new TString[np];

  cFitParAll = new TCanvas* [np];
  cPullAll = new TCanvas* [np];
  cPullOsc = new TCanvas* [np];
  cResAll = new TCanvas* [np];
  cResOsc = new TCanvas* [np];

  hPullAll = new TH1F*[np];
  hPullOsc = new TH1F*[np];
  hPullNuis = new TH1F*[np];

  hResAll = new TH1F*[np];
  hResOsc = new TH1F*[np];
  hResNuis = new TH1F*[np];
 
  hFitParAll = new TH1F*[np];
  hFitParOsc = new TH1F*[np];
  hFitParNuis = new TH1F*[np];

  int npfree = 0;
  for(int ip = 0; ip < np; ip++) {
    conv::PhysParamId_t p = fparm->WhichParam(ip);

    // Fitted distributions
    max = fparm->MaxValue(p);
    min = fparm->MinValue(p);
    sprintf(name,fparm->Name(p).c_str());
    hFitParAll[ip] = new TH1F(name,name,NBinsFitPar,min,max);

    // Pull distributions
    string pullname = "pull_";
    pullname.append(fparm->Name(p));
    sprintf(name,pullname.c_str());
    hPullAll[ip] = new TH1F(name,name,NBinsPull,-5,5);    
    
    // Residual distributions
    string resname = "res_";
    resname.append(fparm->Name(p));
    sprintf(name,resname.c_str());
    hResAll[ip] = new TH1F(name,name,NBinsPull,-5,5);    
  }

  // Loop on the tree events
  
  int NEntries = fitnt->GetEntries();  
  for(int itoy=0; itoy<NEntries; itoy++) {
    fitnt->GetEntry(itoy);
    
    if(itoy==0) fparm->Print();
    
    // Fill the histograms
    
    int np = fparm->GetNumberParameters();
    int npfree = 0;
    for(int ip = 0; ip < np; ip++) {
      conv::PhysParamId_t p = fparm->WhichParam(ip);

      double centval=-999.;
      double centerr=-999.;
      double pull=-999.;

      double bestfitval = fparm->BestFitValue(p);
      double bestfiterr = fparm->MigradError(p);
      
      // Fitted parameters
      hFitParAll[ip]->Fill(bestfitval); 
      
      // Pulls	

      if(!fparm->IsFixed(p)){
	
	if(p == conv::kPhypMixing13) {      
	  if(Opt::Instance()->gOscMixingParamChoice == conv::kNuMixSinsq2Theta){
	    centval = conv::kGlobFitSinsq2Theta13;
	    NameFitParAll[ip] = Form("sin^{2} 2 #theta_{13} = %0.4f",centval);	    
	  }
	  else if(Opt::Instance()->gOscMixingParamChoice == conv::kNuMixSinsqTheta){
	    centval = conv::kGlobFitSinsqTheta13;
	    NameFitParAll[ip] = Form("sin^{2} #theta_{13} = %0.4f",centval);	    
	  }
	}
	else if(p == conv::kPhypMixing12) {
	  if(Opt::Instance()->gOscMixingParamChoice == conv::kNuMixSinsq2Theta){
	    centval = conv::kGlobFitSinsq2Theta12;
	    NameFitParAll[ip] = Form("sin^{2} 2 #theta_{12} = %0.1f",centval);	    
	  }
	  else if(Opt::Instance()->gOscMixingParamChoice == conv::kNuMixSinsqTheta){
	    centval = conv::kGlobFitSinsqTheta12;
	    NameFitParAll[ip] = Form("sin^{2} #theta_{12} = %0.1f",centval);	    
	  }
	}
	else if(p == conv::kPhypMixing23) {
	  if(Opt::Instance()->gOscMixingParamChoice == conv::kNuMixSinsq2Theta){
	    centval = conv::conv::kGlobFitSinsq2Theta23;
	    NameFitParAll[ip] = Form("sin^{2} 2 #theta_{12} = %0.1f",centval);	    
	  }
	  else if(Opt::Instance()->gOscMixingParamChoice == conv::kNuMixSinsqTheta){
	    centval = conv::conv::kGlobFitSinsqTheta23;
	    NameFitParAll[ip] = Form("sin^{2} #theta_{12} = %0.1f",centval);	    
	  }
	}
	else if(p == conv::kPhypDm23sq) {
	  centval = conv::kGlobFitDm23sq;
	  NameFitParAll[ip] = Form("|#Delta m^{2}_{23}| = %0.4f",centval);	    
	}
	else if(p == conv::kPhypDm12sq) {
	  centval = conv::kGlobFitDm12sq;
	  NameFitParAll[ip] = Form("|#Delta m^{2}_{12}| = %0.1f",centval);	    
	}
	else if(p == conv::kPhypDeltaCP) {
	  centval = conv::kGlobFitDeltaCP;
	  NameFitParAll[ip] = Form("#delta_{CP} = %0.1f",centval);	    
	}
	else if(util::IsBANFF(p)){
	  centval = skexp->GetBANFF()->BestFitValue(p);
	  centerr = skexp->GetBANFF()->OneSigmaError(p);


	  //if(p==conv::kNuisBANFF00){
	  //cout << bestfitval << " " << bestfiterr << endl;
	  //cout << centval << " " << centerr << endl;
	  //cout << endl;
	  //}
	  

	}
	else if(util::IsXSec(p)) {
	  //"nominal best fit" is 0
	  //"1 sigma error" is 1
	  centval = 0;
	  centerr = 1;
	}	
	else if(p == conv::kNuisSuperkEnergyScale) {
	  //"nominal best fit" is 0
	  //"1 sigma error" is 1
	  centval = 0;
	  centerr = 1;
	}
	else if(util::IsSKDetFSI(p)) {
	  //"nominal best fit" is 1
	  centval = 1;
	  centerr = skexp->GetSuperkDetectorFSI()->OneSigmaError(p);
	}
	else {
	  cerr << "Unknown pull for parameter " << util::AsStringCompact(p) << endl;
	}

	
	
	
	
	if(fparm->IsNuisance(p)){
	  if(p==conv::kNuisBANFF00){


	    centval = iparm->Value(p);
	    //cout << centval << endl;
	    cout << *iparm << endl;

	    pull = calc_pull_nuis(centval,centerr,bestfitval,bestfiterr);
	  }
	}
	else{
	  pull = calc_pull_osc(centval,bestfitval,bestfiterr);
	}

	hPullAll[ip]->Fill(pull);

	// Residuals
	
	double res = calc_res_osc(centval,bestfitval);
	hResAll[ip]->Fill(res);

      } // !IsFixed
      
    } // loop over the parameters
  } // end itoy
  
  // Draw histograms
  int np = fparm->GetNumberParameters();
  int npfree = 0;
  for(int ip = 0; ip < np; ip++) {
    conv::PhysParamId_t p = fparm->WhichParam(ip);
    
    // Fit parameters
    if(!fparm->IsNuisance(p) && !fparm->IsFixed(p) && DrawOscFit){ // Oscillations    
      sprintf(name,fparm->Name(p).c_str());
      cFitParAll[ip] = new TCanvas(name,name);
      cFitParAll[ip]->cd();
      hFitParAll[ip]->Draw();
      
      double x = fparm->MinValue(p);
      double y = hFitParAll[ip]->GetMaximum()*0.75;
      DrawName(NameFitParAll[ip].Data(),x,y);    
      double mean = hFitParAll[ip]->GetMean();
      double rms = hFitParAll[ip]->GetRMS();
      char *namemean = "Mean = %f";
      sprintf(name,namemean,mean);
      DrawName(name,x,y*0.8);
      char *namerms = "RMS = %f";
      sprintf(name,namerms,rms);
      DrawName(name,x,y*0.7);
    }
    else if (fparm->IsNuisance(p) && DrawNuisFit){ // Nuisances
      sprintf(name,fparm->Name(p).c_str());
      cFitParAll[ip] = new TCanvas(name,name);
      cFitParAll[ip]->cd();
      hFitParAll[ip]->Draw();
 
      double x = fparm->MinValue(p);
      double y = hFitParAll[ip]->GetMaximum()*0.75;
      DrawName(NameFitParAll[ip].Data(),x,y);    
      double mean = hFitParAll[ip]->GetMean();
      double rms = hFitParAll[ip]->GetRMS();
      char *namemean = "Mean = %f";
      sprintf(name,namemean,mean);
      DrawName(name,x,y*0.8);
      char *namerms = "RMS = %f";
      sprintf(name,namerms,rms);
      DrawName(name,x,y*0.7);
    }
   
    // Pulls

    if(!fparm->IsNuisance(p) && !fparm->IsFixed(p) && DrawOscPull){     
      string pullname = "pull_";
      pullname.append(fparm->Name(p));
      sprintf(name,pullname.c_str());
      cPullAll[ip] = new TCanvas(name,name);
      cPullAll[ip]->cd();
      hPullAll[ip]->Draw();

      double x = -5.;
      double y = hPullAll[ip]->GetMaximum();

      DrawName(NameFitParAll[ip].Data(),x,y);

      double mean = hPullAll[ip]->GetMean();
      double rms = hPullAll[ip]->GetRMS();
      char *namemean = "Mean = %f";
      sprintf(name,namemean,mean);
      DrawName(name,x,y*0.8);
      char *namerms = "RMS = %f";
      sprintf(name,namerms,rms);
      DrawName(name,x,y*0.6);
    }
    else if (fparm->IsNuisance(p) && DrawNuisPull){
      string pullname = "pull_";
      pullname.append(fparm->Name(p));
      sprintf(name,pullname.c_str());
      cPullAll[ip] = new TCanvas(name,name);
      cPullAll[ip]->cd();
      hPullAll[ip]->Draw();
      
      double x = -5.;
      double y = hPullAll[ip]->GetMaximum();
      DrawName(name,x,y);
      
      double mean = hPullAll[ip]->GetMean();
      double rms = hPullAll[ip]->GetRMS();
      char *namemean = "Mean = %f";
      sprintf(name,namemean,mean);
      DrawName(name,x,y*0.8);
      char *namerms = "RMS = %f";
      sprintf(name,namerms,rms);
      DrawName(name,x,y*0.6);


      if(p!=conv::kNuisBANFF00) return;

    }

    // Residuals
    if(!fparm->IsNuisance(p) && !fparm->IsFixed(p) && DrawOscRes){     
      string resname = "res_";
      resname.append(fparm->Name(p));
      sprintf(name,resname.c_str());
      cResAll[ip] = new TCanvas(name,name);
      cResAll[ip]->cd();
      hResAll[ip]->Draw();
      DrawName(NameFitParAll[ip].Data(),-5,5);
    }
    else if (fparm->IsNuisance(p) && DrawNuisRes){
    }

  }
  
  return;
}


