  <systematics name="dummy_systematics">
    <group name="flux">
      <format> test/marginalisation/flux.xml </format>
      
      <covariance_matrix>
        <filename>   test/flux.root </filename>
        <objname>    flux_cov    </objname>    
        <objtype>    TMatrixD             </objtype>
      </covariance_matrix> 
    </group>
    
    <group name="interaction">
      <format> test/marginalisation/interaction.xml </format>
      <covariance_matrix>
         <filename>   test/interaction.root </filename>
         <objname>    int_cov    </objname>    
         <objtype>    TMatrixD          </objtype>
      </covariance_matrix>
    </group>
    
    <group name="detector">
      <format> test/marginalisation/detector.xml </format>
      <covariance_matrix>
         <filename>   test/detector.root </filename>
         <objname>    det_cov          </objname>    
         <objtype>    TMatrixD          </objtype>
      </covariance_matrix>
    </group>
    
