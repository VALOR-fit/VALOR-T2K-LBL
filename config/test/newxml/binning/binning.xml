<?xml version="1.0" encoding="ISO-8859-1"?>
<!--
	All of the potential binnings associated with a sample are specified
	within a single sample_binning element.
-->
<sample_binning>
	<!-- Single Mondrian binning scheme for reco quantities -->
	<reco_optimized>test/newxml/binning/mondrian/reco/Ereco_yreco.xml</reco_optimized>
	<!-- Single edge-to-edge binning scheme for reco quantities -->
	<reco_simple>test/newxml/binning/e2e/reco/Ereco_yreco.xml</reco_simple>
	<!--
		Single edge-to-edge binning scheme for true quantities. This is
		used both for optimized and simple templates
	-->
	<true_simple>
		<!--
			The default binning applies to all modes unless a mode binning
			scheme is specified explicitly below
		-->
		<default>test/newxml/binning/e2e/true/Etrue.xml</default>
	</true_simple>
	<!-- Binning scheme for xsec reco -->
	<xsec_reco>test/newxml/binning/e2e/reco/Ereco_yreco.xml</xsec_reco>
</sample_binning>
