<?xml version="1.0" encoding="ISO-8859-1"?>

<binning>

   <space>
       Ereco,Thetareco
   </space>
             
   <type> 
      edge-to-edge 
   </type>

   <!--
    NOTE: For e-like samples the upper edge of the highest energy Ereco bin is 1.25GeV. The SK MC tree will contain
    events with large Erec values than this, but we ignore them because MC studies show that these are intrinsic nue +
    NC events rather than oscillated nue events. See e.g. https://t2k.org/docs/technotes/355/v1r4 figure 14
   -->

   <Ereco_binning>
       <bin_size> variable </bin_size>
       <nbins>    9        </nbins>
       <bin_edges>
           0.0, 0.45, 0.55, 0.65, 0.75, 0.85, 0.95, 1.05, 1.15, 1.25
       </bin_edges>
   </Ereco_binning>

   <Thetareco_binning>
       <bin_size> variable </bin_size>
       <nbins>    3        </nbins>
       <bin_edges>
           0., 60., 120., 180.
       </bin_edges>
   </Thetareco_binning>

</binning>

