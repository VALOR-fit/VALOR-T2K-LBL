<?xml version="1.0" encoding="ISO-8859-1"?>

<sample_binning>

  <!-- Single edge-to-edge binning scheme for reco quantities -->
  <reco_optimized>
    binning/e2e/reco/t2k_e2e_Ereco_mulike.xml
  </reco_optimized>

  <!-- Single edge-to-edge binning scheme for reco quantities -->
  <reco_simple>
    binning/e2e/reco/t2k_e2e_Ereco_mulike.xml
  </reco_simple>

  <!-- Single edge-to-edge binning scheme for true quantities.
       Used both for optimized and simple templates -->
  <true_simple>
    <!-- Applies to all modes unless a mode binning scheme
         is specified explicitly below -->
    <default>
      binning/e2e/true/t2k_e2e_Etrue_run10.xml
    </default>
  </true_simple>

  <xsec_reco>
    binning/e2e/reco/t2k_xsec_binning_e2e_Ereco_Thetareco_mulike.xml
  </xsec_reco>
  
  <xsec_true>
    <!-- Mode dependent binning -->
        <element name="sk_fhc_right_sign_e">
          <coarse_modes> unoscnueCC, nueNC                                                       </coarse_modes>
          <binning>      binning/e2e/true/t2k_xsec_binning_Etrue_rightsign_nue_modes.xml         </binning>
        </element>

        <element name="sk_fhc_wrong_sign_e">
          <coarse_modes> unoscnuebarCC, nuebarNC                                                 </coarse_modes>
          <binning>      binning/e2e/true/t2k_xsec_binning_Etrue_wrongsign_nue_modes.xml         </binning>
        </element>

        <element name="sk_fhc_right_sign_mu">
          <coarse_modes> numuCC, numuNC, oscnueCC                                                </coarse_modes>
          <binning>      binning/e2e/true/t2k_xsec_binning_Etrue_rightsign_numu+oscnue_modes.xml </binning>
        </element>

        <element name="sk_fhc_wrong_sign_mu">
          <coarse_modes> numubarCC, numubarNC, oscnuebarCC                                       </coarse_modes>
          <binning>      binning/e2e/true/t2k_xsec_binning_Etrue_wrongsign_numu+oscnue_modes.xml </binning>
        </element>
  </xsec_true>

</sample_binning>
