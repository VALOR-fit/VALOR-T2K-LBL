<?xml version="1.0" encoding="ISO-8859-1"?>

<messenger_config>

  <!-- 
    Defines the priority levels for VALOR message streams.
    The priority (in descending importance order) can be 
    FATAL, ALERT, CRIT, ERROR, WARN, NOTICE, INFO, DEBUG.
   -->

  <priority msgstream="Messenger">              DEBUG    </priority>
  <priority msgstream="XML">                    NOTICE   </priority>
  <priority msgstream="Parser">                 NOTICE   </priority>
  <priority msgstream="NuOsc3Flavour">          NOTICE   </priority>
  <priority msgstream="Reg">                    NOTICE   </priority>
  <priority msgstream="SuperkDetectorFSI">      DEBUG    </priority>
  <priority msgstream="SuperkMC">               DEBUG    </priority>
  <priority msgstream="SuperkExp">              DEBUG    </priority>  
  <priority msgstream="CorrelatedSystematics">  DEBUG    </priority>
  <priority msgstream="UtlFitParamListFactory"> DEBUG    </priority>
  <priority msgstream="NuXSec">                 ERROR    </priority>
  
</messenger_config>
