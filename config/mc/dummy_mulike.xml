<?xml version="1.0"?>

<analysis_inputs analysis="dummy_WC" version="1" detector="SuperK">

<!--
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Assumed exposure for various beam configurations
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
-->

<data>
  <exposure> 
    <jparc_fhc>
      1.0e+21
    </jparc_fhc>
    <jparc_rhc>
      0.0
    </jparc_rhc>
  </exposure>
</data>

<!--
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Information about the detector configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
-->

<!-- This is (real detector fiducial mass) / (simulated fiducial mass) -->
<fiducial_mass>
  1.
</fiducial_mass>


<!--
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Input MC templates
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
-->

<mc>

  <!-- Whether we will read MC events from a VALOR-format TTree (true), or from stored MC templates (false)  -->
  <using_dst_format> 
     true
  </using_dst_format>

  <dst>
    <jparc_fhc>
       <filename> dummy_data/mc/valor_format/dummy_valor_dst_v1.root  </filename>
       <objname>  valor_dst                                           </objname>
       <objtype>  TTree                                               </objtype>
    </jparc_fhc>
    <jparc_rhc>
        <filename> nonexistent.root </filename>
        <objname>  nonexistent      </objname>
        <objtype>  TTree            </objtype>
    </jparc_rhc>
  </dst>
  
  <template>
    <filename> nonexistent.root </filename>
    <tag> pass                  </tag>
  </template>
  
  <!-- in kg, for calculating CCinc xsec-->
  <interaction_mass> 
    -999 
  </interaction_mass>

</mc>


<!--
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Modelist
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
-->
<modelist>        modelists/dummy.xml        </modelist>
<coarse_modelist> modelists/coarse/dummy.xml </coarse_modelist>


<!--
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
External Tuning Histograms
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
-->

<!--    Pre-calculated event-by-event weights can be applied the read MC events.
<tuning>

    <tuning_group name="event-by-event_flux_tuning">
        <type>      event-by-event                                  </type>
        <operation> multiply                                        </operation
        <file>      mc/tuning/dummy_event_by_event_flux_tuning.xml  </file>
    </tuning_group>

</tuning>
-->

<!--
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Splines

    On T2K we allow splines to go outside of their limits during both the validation and the actual analysis.
     The spline behaviour slightly outside of the limits has been studied, and the behaviour is sensible.
     Also, the splines go out to 3 sigma either side of the nominal param values (as of July 2019),
     therefore any throws outside of the limits will be negligible.

    TODO: By default in VALOR, splines are not allowed to vary outside of their limits. To enable this,
    TODO: configure the SDK with the enable-spline-stupidity flag as well as setting within_limits to false below.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
-->

<splines>
  <folder>          dummy_data/xsec/valor_format                  </folder>
  <pattern>         splines_spline2018v1_[BEAM]_[SAMPLE].root     </pattern>
  <stored_as>       TObjArray                                     </stored_as>
  <array_pattern>   spl_[MODE]_[PARAM]                            </array_pattern>
  <method>          curr_tweak                                    </method>           <!-- This uses weight = spline->Eval(current - untuned) -->
  <type>            TSpline3                                      </type>             <!-- Can use either ROOT's TSpline3, or various GSL splines. See Interpolator.h -->
  <sort_knot_order> false                                         </sort_knot_order>  <!-- Sometimes we get splines with out-of-order knots. These knots are ignored by default. Setting this to true re-orders the splines so that all the knots are in order, which changes the spline behaviour -->
  <within_limits>   true                                          </within_limits>    <!-- Setting this to false allows extrapolation beyond the spline limits. WARNING: This can cause unexpected behaviour, so should only be used if the splines have been verified to have sensible behaviour outside of their range! -->
  <allow_negative>  true                                          </allow_negative>   <!-- Splines that go negative are no longer replaced with flat splines, but the weight cannot go below 0 -->
  <set_neg_wght_to> 2e-10                                         </set_neg_wght_to>  <!-- When we would get a negative weight from a spline, force it to this instead. -->
</splines>

<!--
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Default binning
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
-->
<default_binning> binning/dummy_mulike_bins.xml </default_binning>

</analysis_inputs>


