<?xml version="1.0"?>

<analysis_inputs analysis="DUNE-NDFDFIT" version="2016b" detector="FDv1">

<!--
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Assumed exposure for various beam configurations
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
-->

<data>
  <exposure> 
    <lbnf_fhc>
     5.1518e+21 
    </lbnf_fhc>
    <lbnf_rhc>
     5.1518e+21      
    </lbnf_rhc>
  </exposure>
</data>

<!--
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Information about the detector configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
-->

<fiducial_mass>
40
</fiducial_mass>


<!--
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Input MC templates
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
-->

<mc>
  <using_dst_format> 
     true 
  </using_dst_format> 

  <dst> 
    <lbnf_fhc>
       <filename> dune/fdfit/2016b/fastmc/fhc_fastmc_minidst.root </filename> 
       <objname>  valor_dune_nd_mini_dst </objname> 
       <objtype>  TTree    </objtype> 
    </lbnf_fhc>
    <lbnf_rhc>
       <filename> dune/fdfit/2016b/fastmc/rhc_fastmc_minidst.root </filename> 
       <objname>  valor_dune_nd_mini_dst  </objname> 
       <objtype>  TTree     </objtype> 
    </lbnf_rhc>
  </dst>
  
  <template>
    <filename> dune/ndfit/2016b/fd/nonexistent.root </filename>
    <tag> pass </tag>
  </template>
  
  <!-- in kg, for calculating CCinc xsec-->
  <interaction_mass> 
    -999 
  </interaction_mass>

</mc>

<splines>
  <folder>  dune/ndfit/2016b/fd/splines </folder>
  <pattern> valor_splines_[BEAM]_[SAMPLE]_[PARAM].root    </pattern>
</splines>

</analysis_inputs>


