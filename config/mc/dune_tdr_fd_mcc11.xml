<?xml version="1.0"?>

<analysis_inputs analysis="DUNE-NDFDFIT" version="2016b" detector="FDv1">

<!--
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Assumed exposure for various beam configurations
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
-->

<data>
  <exposure> 
    <lbnf_fhc>
      3.85e+21
    </lbnf_fhc>
    <lbnf_rhc>
      3.85e+21
    </lbnf_rhc>
  </exposure>
</data>

<!--
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Information about the detector configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
-->

<fiducial_mass>
  35.398 <!-- simulated mass was 1.13kt. Desired mass is 40kt -->
</fiducial_mass>


<!--
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Input MC templates
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
-->

<mc>
  <using_dst_format> 
     true 
  </using_dst_format> 

  <dst> 
    <lbnf_fhc>
       <filename> dune/tdr/valor_fd_fhc_mcc11_v4.root </filename> 
       <objname>  valor_dune_caf_minidst </objname> 
       <objtype>  TTree    </objtype> 
    </lbnf_fhc>
    <lbnf_rhc>
       <filename> dune/tdr/valor_fd_rhc_mcc11_v4.root </filename> 
       <objname>  valor_dune_caf_minidst  </objname> 
       <objtype>  TTree     </objtype> 
    </lbnf_rhc>
  </dst>
  
  <template>
    <filename> dune/ndfit/2016b/fd/nonexistent.root </filename>
    <tag> pass </tag>
  </template>
  
  <!-- in kg, for calculating CCinc xsec-->
  <interaction_mass> 
    -999 
  </interaction_mass>

</mc>

<!--
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Splines
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
-->

<splines>
  <folder>  dune/tdr/splines </folder>
  <pattern> valor_splines_[BEAM]_[SAMPLE]_[PARAM].root    </pattern>
</splines>

</analysis_inputs>


