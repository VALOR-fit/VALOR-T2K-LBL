  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  BANFF inputs 
  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  -->

  <banff>
       <!--
        Central values from BANFF fit
       -->
       <best_fit_values>
          <filename>   inputs/official/2012/banff/postfit_banff_v5_osc_marg_numu.root  </filename>
          <objname>    postfit_params   </objname>
          <objtype>    TVectorD         </objtype>
        </best_fit_values>
       <!--
        Covariance of fit parameters
       -->
       <covariance_matrix>
          <filename>   inputs/official/2012/banff/postfit_banff_v5_osc_marg_numu.root  </filename>
          <objname>    postfit_cov      </objname>
          <objtype>    TMatrixD         </objtype>
        </covariance_matrix>     
  </banff>

  <!--
  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  Neutrino cross section weight splines
  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  -->

  <xsec>
      <weight_splines>
          <filename>
               inputs/official/2012/xsec/fake_splines_v0.root
          </filename>
      </weight_splines>
      <splines>
	  <pf>
	       0.13
	  </pf>
	  <sf>
	       1
	  </sf>
	  <wshape>
	       0.52
	  </wshape>
	  <ccothshape>
	       0.4
	  </ccothshape>
