  <!--
  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  SuperK detector systematics
  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  -->

  <detector_systematics>
     <superk>
         <energy_scale_relative_error>
            <one_mu_ring>
               0.023  
            </one_mu_ring>
            <one_e_ring>
               <!-- not added yet -->
            </one_e_ring>
         </energy_scale_relative_error>
         <efficiency_relative_error>  
            <one_mu_ring>
               <ccqe>
                  <other_error>   0.017  </other_error>          
                  <rc_error>          
                     <filename>  inputs/official/2012/superk/err/sk_ccqe_rc_err_covariance.root </filename>
                     <objname>   ccqe_rc_err_covariance  </objname>
                     <objtype>   TMatrixD </objtype>
                  </rc_error>                     
                  <rc_ereco_high_bin1>   0.4  </rc_ereco_high_bin1>          
                  <rc_ereco_high_bin2>   1.1  </rc_ereco_high_bin2>   
               </ccqe>
               <ccnonqe>   0.200 </ccnonqe>
               <nc>        1.110 </nc>
               <nuecc>     1.000 </nuecc>
            </one_mu_ring>
            <one_e_ring>
               <!-- not added yet -->
            </one_e_ring>
         </efficiency_relative_error>  
     </superk>
  </detector_systematics>

