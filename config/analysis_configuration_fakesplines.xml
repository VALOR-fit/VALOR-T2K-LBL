           </numu>
           <numubar>
             <pot> 
                6.3258298E+24
             </pot>
             <one_mu_ring>
                <filename>   inputs/official/2012/superk/mc/neut/11c/superk_1RmuT_numubar.root  </filename>
                <objname>    selection_tree   </objname>
