  <prior>
    <params>    mixing23, dm23sq                                                                                       </params>       <!-- NOTE: The first param must correspond to the x-axis of the prior hist, and the second param is the y-axis. -->
    <type>      user                                                                                                   </type>
    <file_nh>   fc/likelihood_surfaces/fit_dataAsimov_run1-10_normal_mixing23_dm23sq_reactor_0_1_result_smeared.root   </file_nh>
    <file_ih>   fc/likelihood_surfaces/fit_dataAsimov_run1-10_inverted_mixing23_dm23sq_reactor_0_1_result_smeared.root </file_ih>
    <hist_name> likelihood                                                                                             </hist_name>
    <scheme>    sinsqtheta, abs23                                                                                      </scheme>
  </prior>

  <prior>
    <params> mixing13    </params>
    <type>   gaus        </type>
    <mean>   0.0853      </mean>
    <sigma>  0.0027      </sigma>
    <scheme> sinsq2theta </scheme>
  </prior>

  <prior>
    <params> mixing12    </params>
    <type>   gaus        </type>
    <mean>   0.851       </mean>
    <sigma>  0.020       </sigma>
    <scheme> sinsq2theta </scheme>
  </prior>

  <prior>
    <params> dm12sq  </params>
    <type>   gaus    </type>
    <mean>   7.53E-5 </mean>
    <sigma>  0.18E-5 </sigma>
    <!-- NOTE: No need to set a scheme for dm12sq, as the mass splitting scheme only applies to dm23sq -->
  </prior>

  <penalty>
    <params> mixing13    </params>
    <type>   gaus        </type>
    <mean>   0.0853      </mean>
    <sigma>  0.0027      </sigma>
    <scheme> sinsq2theta </scheme>
  </penalty>
</prior_list>