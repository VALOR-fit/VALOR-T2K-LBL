<?xml version="1.0"?>

<prior_list name="run1-9d_fc">

  <prior>
    <params> cpv                      </params>
    <type>   flat                     </type>
    <low>    -3.14159265358979312e+00 </low>
    <high>   +3.14159265358979312e+00 </high>
    <scheme> delta                    </scheme>
    <!-- NOTE: The scheme given here is just used to define the prior, i.e. is used when throwing the parameter.
               Afterwards, the thrown value is converted to the scheme set in Opt::Instance -->
  </prior>

  <prior>
    <params>    mixing23, dm23sq                                                                           </params>       <!-- NOTE: The first param must correspond to the x-axis of the prior hist, and the second param is the y-axis. -->
    <type>      user                                                                                       </type>
    <file_nh>   fc/likelihood_surfaces/fit_oa2018_normal_reactor_mixing23_dmsq23_fc_smeared_contour.root   </file_nh>
    <file_ih>   fc/likelihood_surfaces/fit_oa2018_inverted_reactor_mixing23_dmsq23_fc_smeared_contour.root </file_ih>
    <hist_name> likelihood_2D                                                                              </hist_name>
    <scheme>    sinsqtheta, abs23                                                                          </scheme>
  </prior>

  <prior>
    <params> mixing13    </params>
    <type>   gaus        </type>
    <mean>   0.0830      </mean>
    <sigma>  0.0031      </sigma>
    <scheme> sinsq2theta </scheme>
  </prior>

  <prior>
    <params> mixing12    </params>
    <type>   gaus        </type>
    <mean>   0.851       </mean>
    <sigma>  0.020       </sigma>
    <scheme> sinsq2theta </scheme>
  </prior>

  <prior>
    <params> dm12sq  </params>
    <type>   gaus    </type>
    <mean>   7.53E-5 </mean>
    <sigma>  0.18E-5 </sigma>
    <!-- NOTE: No need to set a scheme for dm12sq, as the mass splitting scheme only applies to dm23sq -->
  </prior>
</prior_list>