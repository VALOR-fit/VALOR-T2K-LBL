<?xml version="1.0"?>

<prior_list name="oa2021_reactor">

  <prior>
    <params> cpv                      </params>
    <type>   flat                     </type>
    <low>    -3.14159265358979312e+00 </low>
    <high>   +3.14159265358979312e+00 </high>
    <scheme> delta                    </scheme>
    <!-- NOTE: The scheme given here is just used to define the prior, i.e. is used when throwing the parameter.
               Afterwards, the thrown value is converted to the scheme set in Opt::Instance -->
  </prior>

  <prior>
    <params> dm23sq </params>
    <type>   flat   </type>
    <low>    2.3E-3 </low>
    <high>   2.7E-3 </high>
    <scheme> abs23  </scheme>
  </prior>

  <prior>
    <params> mixing23    </params>
    <type>   flat        </type>
    <low>    0.38         </low>
    <high>   0.62         </high>
    <scheme> sinsqtheta  </scheme>
  </prior>

  <prior>
    <params> mixing13    </params>
    <type>   gaus        </type>
    <mean>   0.0220      </mean>
    <sigma>  0.0007      </sigma>
    <scheme> sinsqtheta </scheme>
  </prior>

  <prior>
    <params> mixing12    </params>
    <type>   gaus        </type>
    <mean>   0.307       </mean>
    <sigma>  0.013       </sigma>
    <scheme> sinsqtheta </scheme>
  </prior>

  <prior>
    <params> dm12sq  </params>
    <type>   gaus    </type>
    <mean>   7.53E-5 </mean>
    <sigma>  0.18E-5 </sigma>
    <!-- NOTE: No need to set a scheme for dm12sq, as the mass splitting scheme only applies to dm23sq -->
  </prior>

  <penalty>
    <params> mixing13    </params>
    <type>   gaus        </type>
    <mean>   0.0220      </mean>
    <sigma>  0.0007      </sigma>
    <scheme> sinsqtheta </scheme>
  </penalty>
</prior_list>