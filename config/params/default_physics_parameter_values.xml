<param_list name="default_physics_param_values">

  <!--
    EXPLANATION: This file specifies default values for physics parameters, all of which can be
    overwritten by reading in another parameter XML file containing parameters with the same simple name.
    For a explanation of what each node is, see Parameter.h
  -->

  <!--
     NOTE: The values specified for any physics parameters in this file must correspond to these schemes,
     which must also match the schemes set in Opt::Instance()
  -->
  <schemes>
    <mixing> sinsqtheta </mixing>
    <phase>  delta      </phase>
    <Dmsq>   abs23      </Dmsq>
  </schemes>

