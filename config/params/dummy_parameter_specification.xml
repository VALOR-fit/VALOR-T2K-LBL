<?xml version="1.0"?>
<param_list name="dummy">
  <!-- ==================================================================================== -->
  <param>
    <name>
      <simple>  flux_numu00                                 </simple>
      <long>    Far detector numu flux; 0.0 - 1.0 GeV       </long>
      <rootex>  Far detector #nu_{#mu} flux; 0.0 - 1.0 GeV  </rootex>
      <tex>     Far detector \nu_{\mu} flux; 0.0 - 1.0 GeV  </tex>
    </name>
    
    <apply_to_range>
      <Etrue>  0.0, 1.0  </Etrue>
    </apply_to_range>
    
    <type>  normalisation  </type>
    
    <categories>
      <category>  flux  </category>
    </categories>
    
    <apply_to>
      <detector>    SuperK  </detector>
      <beam>        FHC     </beam>
      <selection>   all     </selection>
      <reac_type>   all     </reac_type>
      <flav_init>   numu    </flav_init>
      <flav_final>  nu any  </flav_final>
      <target>      all     </target>
    </apply_to>
    
    <limits>  0.0, inf  </limits>

    <!-- Options used to set the FitParamList -->

    <!-- The init val, error, step size and range will be updated based on the
    covariance matrix and associated initial values vector -->
    <update_from_cov_matrix> true </update_from_cov_matrix>

    <!-- The values specified for the range are in units of sigmas away from
    the initial value. The range will be recalculated using the init value
    and error read from the covariance matrix & vector, if applicable -->
    <range_mode> sigma </range_mode>

    <!-- This is not to be confused with the physical limits above, this is
    an optimised range used for searching a narrower area than the physical
    limits. Internally, this is combined with the physical limits so that
    both ranges are used and the parameter never takes unphysical values -->
    <range> -5, 5 </range>

    <!-- The step size value below is specified as a fraction of the total
    range. This is updated when the range is updated using the covariance
    matrix -->
    <step_mode> frac </step_mode>
    <step> 0.01 </step>

  </param>



  <!-- ==================================================================================== -->
  <param>
    <name>
      <simple>  flux_numu01                                 </simple>
      <long>    Far detector numu flux; 1.0 - 2.0 GeV       </long>
      <rootex>  Far detector #nu_{#mu} flux; 1.0 - 2.0 GeV  </rootex>
      <tex>     Far detector \nu_{\mu} flux; 1.0 - 2.0 GeV  </tex>
    </name>

    <apply_to_range>
      <Etrue>  1.0, 2.0  </Etrue>
    </apply_to_range>

    <type>  normalisation  </type>

    <categories>
      <category>  flux  </category>
    </categories>

    <apply_to>
      <detector>    SuperK  </detector>
      <beam>        FHC     </beam>
      <selection>   all     </selection>
      <reac_type>   all     </reac_type>
      <flav_init>   numu    </flav_init>
      <flav_final>  nu any  </flav_final>
      <target>      all     </target>
    </apply_to>

    <limits>  0.0, inf  </limits>

    <update_from_cov_matrix> true   </update_from_cov_matrix>
    <range_mode>             sigma  </range_mode>
    <range>                  -5, 5  </range>
    <step_mode>              frac   </step_mode>
    <step>                   0.01   </step>

  </param>



  <!-- ==================================================================================== -->
  <param>
    <name>
      <simple>  MAQE      </simple>
      <long>    Ma QE     </long>
      <rootex>  M_A^{QE}  </rootex>
      <tex>     M_A^{QE}  </tex>
    </name>
    
    <apply_to_range>
      <Etrue>  0, inf  </Etrue>
    </apply_to_range>
    
    <type>  response  </type>
    
    <categories>
      <category>  int  </category>
    </categories>
    
    <apply_to>
      <detector>    SuperK     </detector>
      <beam>        all        </beam>
      <selection>   all rings  </selection>
      <reac_type>   CC QE      </reac_type>
      <flav_init>   all        </flav_init>
      <flav_final>  all        </flav_final>
      <target>      all        </target>
    </apply_to>
    
    <limits>  0.0, inf  </limits>
    
    <update_from_cov_matrix> true  </update_from_cov_matrix>
    <range_mode>             sigma </range_mode>            
    <range>                  -5, 5 </range>                 
    <step_mode>              frac  </step_mode>             
    <step>                   0.01  </step>

  </param>



  <!-- ==================================================================================== -->
  <!-- TODO: remove this one?
  <param>
    <name>
      <simple>  nue_numu                           </simple>
      <long>    Norm; NuE To NuMu                  </long>
      <rootex>  Norm; {#nu_e #rightarrow #nu_#mu}  </rootex>
      <tex>     Norm, $\nu_{e}$ To $\nu_{\mu}$     </tex>
    </name>
    
    <apply_to_range>
      <Etrue>  0, inf  </Etrue>
    </apply_to_range>
    
    <type>  normalisation  </type>
    
    <categories>
      <category>  int  </category>
    </categories>
    
    <apply_to>
      <detector>    SuperK     </detector>
      <beam>        all        </beam>
      <selection>   all rings  </selection>
      <reac_type>   all CC     </reac_type>
      <flav_init>   nu any     </flav_init>
      <flav_final>  nue        </flav_final>
      <target>      all        </target>
    </apply_to>
    
    <limits>  0.0, inf  </limits>
    
    <update_from_cov_matrix> true  </update_from_cov_matrix>
    <range_mode>             sigma </range_mode>            
    <range>                  -5, 5 </range>                 
    <step_mode>              frac  </step_mode>             
    <step>                   0.01  </step>

  </param>
  -->



  <!-- ==================================================================================== -->
  <param>
    <name>
      <simple>  e_scale       </simple>
      <long>    energy scale  </long>
      <rootex>  E_{scale}     </rootex>
      <tex>     E_{scale      </tex>
    </name>
    
    <apply_to_range>
      <Ereco>  0, inf  </Ereco>
    </apply_to_range>
    
    <type>  lateral_post_osc  </type>
    
    <categories>
      <category>  det  </category>
    </categories>
    
    <apply_to>
      <detector>    SuperK  </detector>
      <beam>        all     </beam>
      <selection>   all     </selection>
      <reac_type>   all     </reac_type>
      <flav_init>   all     </flav_init>
      <flav_final>  all     </flav_final>
      <target>      all     </target>
    </apply_to>
    
    <limits>  -inf, inf  </limits>
    
    <update_from_cov_matrix> true  </update_from_cov_matrix>
    <range_mode>             sigma </range_mode>            
    <range>                  -5, 5 </range>                 
    <step_mode>              frac  </step_mode>             
    <step>                   0.01  </step>

</param>
  


</param_list>
