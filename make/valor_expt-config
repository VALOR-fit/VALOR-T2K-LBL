#!/bin/sh
# -*- sh-indentation: 3 -*-
#
# valor_expt-config a la ROOT's root-config
#

# VALOR/T2K top directory path:
topdir=$VALOR_EXPT

# VALOR/T2K libraries path:
libdir=$topdir/lib

# VALOR/T2K src top level directory:
srcdir=$topdir/src

# VALOR/T2K ROOT interpreter top level directory:
rootdir=$topdir/root

# VALOR/T2K libraries:
libs=" "

#VALOR/T2K genie-dependent libraries:
glibs=" "

#
# Usage
#

usage="\
Usage: valor_expt-config [--libs] [--libdir] [--glibs] [--srcdir] [--topdir] [--rootdir]" 

if test $# -eq 0; then
   echo "${usage}" 1>&2
   exit 1
fi

out=""

while test $# -gt 0; do
  case "$1" in
  -*=*) optarg=`echo "$1" | sed 's/[-_a-zA-Z0-9]*=//'` ;;
  *)    optarg= ;;
  esac

  case $1 in
    --topdir)
      out="$out $topdir"
      ;;
    --libdir)
      out="$out $libdir"
      ;;
    --srcdir)
      out="$out $srcdir"
      ;;
    --rootdir)
      out="$out $rootdir"
      ;;
    --libs)
      out="$out -L$libdir $libs"
      ;;
    --glibs)
      out="$out -L$libdir $glibs"
      ;;
  esac
  shift
done

echo $out
