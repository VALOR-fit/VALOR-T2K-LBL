# Costas Andreopoulos (Rutherford Lab.) <costas.andreopoulos \at stfc.ac.uk>
#

include $(VALOR_FMWK)/make/Make.config
include $(T2KOSCANA)/make/Make.config

ifndef OPT_WITH_CXX_USERDEF_FLAGS
 OPT_WITH_CXX_USERDEF_FLAGS=
endif

#-------------------------------------------------------------------
#                           ARCHITECTURE 
#-------------------------------------------------------------------
# As defined by ROOT
ARCH      = $(shell root-config --arch)  
ARCH_OK   = 
IS_MACOSX =


#-------------------------------------------------------------------
#                  VALOR APPLICATION-SPECIFIC CODE
#-------------------------------------------------------------------

# VALOR application release info
#
VALOR_APP_VERSION  = $(shell awk '{print $0}' $(T2KOSCANA)/VERSION)

# VALOR application include path
#
VALOR_APP_INCLUDES := -I$(T2KOSCANA)/fitter/

# VALOR application libraries
#
VALOR_APP_LIBRARIES = $(shell $(T2KOSCANA)/make/valor_t2xk-config --libs)

#-------------------------------------------------------------------
#                      VALOR FRAMEWORK CODE
#-------------------------------------------------------------------

# VALOR framework release info
#
VALOR_FMWK_VERSION  = $(shell awk '{print $0}' $(VALOR_FMWK)/VERSION)

# VALOR framework include path
#
VALOR_FMWK_INCLUDES  := -I$(VALOR_FMWK)/src/

# VALOR framework libraries
#
VALOR_FMWK_LIBRARIES = $(shell $(VALOR_FMWK)/make/valor_fmwk-config --libs)

#-------------------------------------------------------------------
#                              ROOT
#-------------------------------------------------------------------
# ROOT headers and libraries
ROOT_INCLUDES  = -I$(shell root-config --incdir)
ROOT_LIBRARIES = $(shell root-config --glibs) -lMinuit -lMinuit2 -lMathMore -lXMLIO -lXMLParser
ROOT_CINT_FLAGS = -c -p

#-------------------------------------------------------------------
#                             log4cpp
#-------------------------------------------------------------------

# log4cpp lib & include directory

ifdef OPT_WITH_LOG4CPP_INC
LOG_INC_DIR = $(OPT_WITH_LOG4CPP_INC)
else
LOG_INC_DIR = /opt/local/include
endif

ifdef OPT_WITH_LOG4CPP_LIB
LOG_LIB_DIR = $(OPT_WITH_LOG4CPP_LIB)
else
LOG_LIB_DIR = /opt/local/lib
endif

# log4cpp libraries and headers

LOG_INCLUDES  := -I$(LOG_INC_DIR)
LOG_LIBRARIES := -L$(LOG_LIB_DIR) -llog4cpp

#-------------------------------------------------------------------
#                             GSL
#-------------------------------------------------------------------
#
# GSL libraries and headers
GSL_INCLUDES := $(shell gsl-config --cflags)
GSL_LIBRARIES := $(shell gsl-config --libs)


#-------------------------------------------------------------------
#                   PROFILING / DEBUGING OPTIONS
#-------------------------------------------------------------------
# Linking in the Google Profiling Tool library
#
#GPROF_LIBRARIES = 
#ifeq ($(strip $(OPT_ENABLE_PROFILER)),YES)
#  ifdef OPT_WITH_PROFILER_LIB
#    GPROF_LIBRARIES += -L$(OPT_WITH_PROFILER_LIB) -lprofiler
#  else
#    GPROF_LIBRARIES += -L/usr/local/lib -lprofiler
#  endif
#endif
#

#-------------------------------------------------------------------
#                       Some global variables
#-------------------------------------------------------------------
MAKE   := make
RM      = rm -f
MKDIR   = mkdir -p
CAT     = cat
SYMLINK = ln -sf
COPY    = cp
INSTALL = @INSTALL@

# AR, ARFLAGS and RANLIB are for manipulating an archive
AR        = ar
ARFLAGS   = rv
RANLIB    = ranlib

#-------------------------------------------------------------------
#                        COMPILER OPTIONS
#-------------------------------------------------------------------

ifeq ($(OPT_WITH_COMPILER),$(filter $(OPT_WITH_COMPILER),clang clang++))
  # --clang
  CXX           = clang++
  CC            = clang
  LD            = clang++
else ifeq ($(OPT_WITH_COMPILER),$(filter $(OPT_WITH_COMPILER),gcc g++))
  # -- gcc
  CXX = g++
  CC  = gcc
  LD  = g++
else
  $(error OPT_WITH_COMPILER not set correctly!)
endif

APPLE_CLANG := $(shell $(CXX) -v 2>&1 | sed -n "s/.*clang//p" | cut -d . -f 1)
ifneq ($(APPLE_CLANG),)
USING_CLANG  = YES
endif

# get gcc version & split in '.' delimited tokens (major/minor/revison num.)
CXXVRS      = $(shell $(CXX) -dumpversion)
CXXVRS_MAJ  = $(shell awk 'BEGIN {\
		str="$(CXXVRS)"; split(str, tk, "."); print tk[1]}')
CXXVRS_MIN  = $(shell awk 'BEGIN {\
		str="$(CXXVRS)"; split(str, tk, "."); print tk[2]}')
CXXVRS_REV  = $(shell awk 'BEGIN {\
		str="$(CXXVRS)"; split(str, tk, "."); print tk[3]}')
# gcc version >= 4.1.0 ?
GCC_GE_4_1_0  = $(shell awk 'BEGIN {\
		if($(CXXVRS_MAJ)>=4 && $(CXXVRS_MIN)>0) print "YES"}')
# gcc version >= 4.2.1 ?
GCC_GE_4_2_1  = $(shell awk 'BEGIN {\
		if($(CXXVRS_MAJ)>=4 && $(CXXVRS_MIN)>0 && $(CXXVRS_REV)>=0) print "YES"}') 

# MAC OS X with gcc, 32-bit mode
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
ifeq ($(strip $(ARCH)),macosx) 
ARCH_OK       = YES
IS_MACOSX     = YES
CXXFLAGS      = -pipe -W -Wall -std=c++11 -Wno-long-double \
		-fsigned-char -fno-common -flat_namespace \
		$(OPT_WITH_CXX_DEBUG_FLAG) \
		$(OPT_WITH_CXX_OPTIMIZ_FLAG) \
		$(OPT_WITH_CXX_USERDEF_FLAGS) \
	  $(OPT_WITH_CXX_MISC_FLAGS)
ifeq ($(strip $(GCC_GE_4_1_0)), YES) 
  CXXFLAGS += -Wno-strict-aliasing 
endif
LDFLAGS       = -bind_at_load
SOFLAGS       = -dynamiclib -flat_namespace \
		-single_module -undefined dynamic_lookup
DllSuf       := dylib
DllLinkSuf   := so
StaticLibSuf := a
ObjSuf       := o
SrcSuf       := cxx
FORT         := g77
FORTOPTS     := $(FFLAGS) -g -c -O -DLINUX $(F77INCS) -fno-second-underscore
RANLIB       := ranlib
SOCMD         = $(LD)
OutPutOpt     = -o
SOMINF        =
EXTRALIBS     = 
endif

# MAC OS X with gcc, 64-bit mode
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
ifeq ($(strip $(ARCH)),macosx64) 
OSX_VERSION = $(shell sw_vers | grep 'ProductVersion:' | grep -o '[0-9]*\.[0-9]*\.[0-9]*')  
OSXVRS_MAJ  = $(shell awk 'BEGIN {\
		str="$(OSX_VERSION)"; split(str, tk, "."); print tk[1]}')
OSXVRS_MIN  = $(shell awk 'BEGIN {\
		str="$(OSX_VERSION)"; split(str, tk, "."); print tk[2]}')
OSXVRS_REV  = $(shell awk 'BEGIN {\
		str="$(OSX_VERSION)"; split(str, tk, "."); print tk[3]}')
# osx version >= 10.6 ?
OSX_GE_10_6_0  = $(shell awk 'BEGIN {\
		if($(OSXVRS_MAJ)>=10 && $(OSXVRS_MIN)>=6) print "YES"}')
# osx version >= 10.9 ?
OSX_GE_10_9_0  = $(shell awk 'BEGIN {\
		if($(OSXVRS_MAJ)>=10 && $(OSXVRS_MIN)>=9) print "YES"}')
ARCH_OK       = YES
IS_MACOSX     = YES
CXXFLAGS      = -m64 -pipe -Wshadow -W -Wall -std=c++11 -Wno-overloaded-virtual \
		-fsigned-char -fno-common \
		$(OPT_WITH_CXX_DEBUG_FLAG) \
		$(OPT_WITH_CXX_OPTIMIZ_FLAG) \
		$(OPT_WITH_CXX_USERDEF_FLAGS) \
	  $(OPT_WITH_CXX_MISC_FLAGS)
ifneq ($(strip $(GCC_GE_4_2_1)), YES) 
  ifneq ($(USING_CLANG), YES)
    CXXFLAGS   += -flat_namespace
  endif
endif
ifeq ($(GCC_GE_4_1_0),YES)
  ifeq ($(USING_CLANG),YES)
    ifeq ($(OSX_GE_10_9_0),YES)
      CXXFLAGS += -stdlib=libc++  -mmacosx-version-min=10.9
    else ifeq ($(OSX_GE_10_6_0),YES)
      CXXFLAGS += -stdlib=libstdc++  -mmacosx-version-min=10.6
    endif
  endif
  CXXFLAGS += -Wno-strict-aliasing
endif
LDFLAGS       = -bind_at_load
SOFLAGS       = -dynamiclib \
		-single_module -undefined dynamic_lookup
ifneq ($(strip $(GCC_GE_4_2_1)), YES) 
  SOFLAGS    += -flat_namespace
endif
DllSuf       := dylib
DllLinkSuf   := so
StaticLibSuf := a
ObjSuf       := o
SrcSuf       := cxx
FORT         := g77
FORTOPTS     := $(FFLAGS) -g -c -O -DLINUX $(F77INCS) -fno-second-underscore
RANLIB       := ranlib
SOCMD         = $(LD)
OutPutOpt     = -o
SOMINF        =
EXTRALIBS     = 
endif

# LINUX / 32-bit x86 / with gcc
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
ifeq ($(strip $(ARCH)),linux) 
ARCH_OK       = YES
CXXFLAGS      = -Wall -std=c++11 -fPIC \
		$(OPT_WITH_CXX_DEBUG_FLAG) \
		$(OPT_WITH_CXX_OPTIMIZ_FLAG) \
		$(OPT_WITH_CXX_USERDEF_FLAGS) \
		$(OPT_WITH_CXX_MISC_FLAGS)
ifeq ($(strip $(GCC_GE_4_1_0)), YES) 
  CXXFLAGS += -Wno-strict-aliasing 
endif
LDFLAGS       = $(OPT_WITH_CXX_DEBUG_FLAG) -Wl,--no-as-needed
SOFLAGS       = $(OPT_WITH_CXX_DEBUG_FLAG) -shared
DllSuf       := so
DllLinkSuf   := 
StaticLibSuf := a
ObjSuf       := o
SrcSuf       := cxx
FORT         := g77
FORTOPTS     := $(FFLAGS) -g -c -O -DLINUX $(F77INCS) -fno-second-underscore
RANLIB       := ranlib
SOCMD         = $(LD)
OutPutOpt     = -o
SOMINF        =
EXTRALIBS     = -lnsl
endif

# LINUX / 64-bit x86 / with gcc
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
ifeq (linuxx8664,$(findstring linuxx8664,$(strip $(ARCH)))) 
ARCH_OK       = YES
CXXFLAGS      = -Wall -std=c++11 -fPIC \
		$(OPT_WITH_CXX_DEBUG_FLAG) \
		$(OPT_WITH_CXX_OPTIMIZ_FLAG) \
		$(OPT_WITH_CXX_USERDEF_FLAGS) \
		$(OPT_WITH_CXX_MISC_FLAGS)
ifeq ($(strip $(GCC_GE_4_1_0)), YES) 
  CXXFLAGS += -Wno-strict-aliasing 
endif
LDFLAGS       = $(OPT_WITH_CXX_DEBUG_FLAG) $(OPT_WITH_CXX_MISC_FLAGS) -Wl,--no-as-needed
SOFLAGS       = $(OPT_WITH_CXX_DEBUG_FLAG) $(OPT_WITH_CXX_MISC_FLAGS) -shared
DllSuf       := so
DllLinkSuf   := 
StaticLibSuf := a
ObjSuf       := o
SrcSuf       := cxx
FORT         := g77
FORTOPTS     := $(FFLAGS) -g -c -O -DLINUX $(F77INCS) -fno-second-underscore
RANLIB       := ranlib
SOCMD         = $(LD)
OutPutOpt     = -o
SOMINF        =
EXTRALIBS     = -lnsl
endif

#-------------------------------------------------------------------
#                            SUMMING-UP
#-------------------------------------------------------------------

# includes and libraries needed to compile programs. 

VALOR_INCLUDES := $(VALOR_APP_INCLUDES) \
                  $(VALOR_FMWK_INCLUDES)

INCLUDES  := $(VALOR_APP_INCLUDES) \
             $(VALOR_FMWK_INCLUDES) \
             $(LOG_INCLUDES) \
             $(ROOT_INCLUDES) \
             $(LINUX_SYS_INCLUDES)\
             $(GSL_INCLUDES)

LIBRARIES := $(SYSLIBS) \
             $(VALOR_APP_LIBRARIES) \
             $(VALOR_FMWK_LIBRARIES) \
             $(LOG_LIBRARIES) \
             $(ROOT_LIBRARIES) \
             $(GPROF_LIBRARIES) \
             $(GSL_LIBRARIES) \
             $(OPT_WITH_MISC_LIBS)

# Default compiler and preprocessor flags

CXXFLAGS := $(ENV_CXXFLAGS) $(CXXFLAGS)
CPPFLAGS  = $(INCLUDES)
CFLAGS    = $(OPT_WITH_CXX_DEBUG_FLAG)

#-------------------------------------------------------------------
#                            MAKE RULES
#-------------------------------------------------------------------

.SUFFIXES : .inc .cxx

#.cc.o:
#	$(CXX) -c -o $@ $(CXXFLAGS) $(CPPFLAGS) $<

#.cxx.o:
#	$(CXX) -c -o $@ $(CXXFLAGS) $(CPPFLAGS) $<

.cc.o:
	$(CXX) -c $(CXXFLAGS) $(CPPFLAGS) $<

.cxx.o:
	$(CXX) -c $(CXXFLAGS) $(CPPFLAGS) ${T2KCOMPILE} $<

.C.o:
	$(CXX) -c -o $@ $(CXXFLAGS) $(CPPFLAGS) $<

.c.o:
	$(CC) -c -o $@ $(CXXFLAGS) $(CPPFLAGS) $<

.F.o :
	$(FORT) $(FORTOPTS) -o $@ $<

.f.o :
	$(FORT) $(FORTOPTS) -o $@ $<

.F.a :
	$(FORT) $(FORTOPTS) -o $*.o $<
	$(AR) $(ARFLAGS) $@ $*.o
	$(RANLIB) $@
	$(RM) $*.o

.f.a :
	$(FORT) $(FORTOPTS) -o $*.o $<
	$(AR) $(ARFLAGS) $@ $*.o
	$(RANLIB) $@
	$(RM) $*.o

# Print variable name for debugging MakeFile, eg make print-INCLUDES
print-%  : ; @echo $* = $($*)
