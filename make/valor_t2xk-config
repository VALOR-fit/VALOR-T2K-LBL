#!/bin/sh
# -*- sh-indentation: 3 -*-
#
# valor_t2xk-config a la ROOT's root-config
#

# VALOR/T2XK top directory path:
topdir=$T2KOSCANA

# VALOR/T2XK libraries path:
libdir=$T2KOSCANA/lib

# VALOR/T2XK src top level directory:
srcdir=$T2KOSCANA/fitter

# VALOR/T2XK libraries:
libs="-L$libdir -lT2KNuOsc"

#
# Usage
#

usage="\
Usage: valor_t2xk-config [--libs] [--libdir] [--srcdir] [--topdir]" 

if test $# -eq 0; then
   echo "${usage}" 1>&2
   exit 1
fi

out=""

while test $# -gt 0; do
  case "$1" in
  -*=*) optarg=`echo "$1" | sed 's/[-_a-zA-Z0-9]*=//'` ;;
  *)    optarg= ;;
  esac

  case $1 in
    --topdir)
      out="$out $topdir"
      ;;
    --libdir)
      out="$out $libdir"
      ;;
    --srcdir)
      out="$out $srcdir"
      ;;
    --libs)
      out="$out $libs"
      ;;
  esac
  shift
done

echo $out
