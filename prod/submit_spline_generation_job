#!/usr/bin/perl

#
#-------------------------------------------------------------------------------------------------------------------------------
# Submit a batch of spline generation jobs
#
# Inputs
#  --resource               : Computer resource, <RAL_HTC, RAL_HTCPBS, RAL_PBS, Oxford_PBS, interactive>. Default: interactive.
#  --output                 : Name for output files. Default: "valor_splines_[BEAM]_[SAMPLE]_[PARAM].root"
#  --beam                   : Beam type (LBNF_FHC,LBNF_RHC)
#  --input                  : File containing the input MC DST
#  --format                 : File format (lartpc, hpgartpc, fgt). Default: lartpc
#  --cpu-time               : Required CPU time. Default: "6:00:00" for RAL, "11:50:00" for Oxford.
#  --job-dir                : Directory for job scripts and outputs. Default: `pwd`.
#  --dune-softw-dir         : VALOR/DUNE code top-level directory. Default: $VALOR_EXPT.
#  --fmwk-softw-dir         : VALOR/FMWK code top-level directory. Default: $VALOR_FMWK
#
# S. Dennis & C. Andreopoulos
# University of Liverpool & STFC/RAL
#-------------------------------------------------------------------------------------------------------------------------------
#

use File::Path;
use Cwd 'abs_path';
#~ use strict;

$iarg=0;
foreach (@ARGV) {
     
  if($iarg % 2 == 1) {$iarg++; next;} # only even arguments are flags, the odd ones are values
  
  if   ($_ eq '--resource'               ) { $resource            = $ARGV[$iarg+1]; }
  elsif($_ eq '--output'                 ) { $output              = $ARGV[$iarg+1]; }
  elsif($_ eq '--input'                  ) { $input               = $ARGV[$iarg+1]; }
  elsif($_ eq '--detector'               ) { $detector            = $ARGV[$iarg+1]; }
  elsif($_ eq '--beam'                   ) { $beam                = $ARGV[$iarg+1]; }
  elsif($_ eq '--format'                 ) { $format              = $ARGV[$iarg+1]; }
  elsif($_ eq '--cpu-time'               ) { $cput                = $ARGV[$iarg+1]; }
  elsif($_ eq '--physics-hypothesis'     ) { $fitparamlist        = $ARGV[$iarg+1]; }
  elsif($_ eq '--job-dir'                ) { $job_dir             = $ARGV[$iarg+1]; }
  elsif($_ eq '--dune-softw-dir'         ) { $dune_softw_dir      = $ARGV[$iarg+1]; }
  elsif($_ eq '--fmwk-softw-dir'         ) { $fmwk_softw_dir      = $ARGV[$iarg+1]; }
  
  else {
    print "Unrecognised argument ".$_."\n"; exit;
  }
  $iarg++;
}

die("Must have an input file specified.") unless defined $input;
die("Must have an beam type specified." ) unless defined $beam;

$resource               = "interactive"                                           unless defined $resource;
$output                 = "valor_splines_[BEAM]_[SAMPLE]_[PARAM].root"            unless defined $output;
$format                 = "lartpc"                                                unless defined $format;
$job_dir                = `pwd`                                                   unless defined $job_dir;
$dune_softw_dir         = $ENV{'VALOR_EXPT'}                                      unless defined $dune_softw_dir;
$fmwk_softw_dir         = $ENV{'VALOR_FMWK'}                                      unless defined $fmwk_softw_dir;
$detector               = "dune_nd"                                               unless defined $detector;

chomp($job_dir);

if( !defined $cput ) {
  if($resource =~ "RAL"       ) { $cput =  "6:00:00"; }
  if($resource =~ "Oxford"    ) { $cput = "11:50:00"; }
  if($resource =~ "Liverpool" ) { $cput = "17:50:00"; }
}

mkpath ($job_dir, {verbose => 1, mode=>0777}); 
die("$job_dir doesn't exist") unless -d $job_dir;

$job_dir = abs_path($job_dir);

$jobID = 0;

# Should do this more sensibly - make a macro that gives us this list?
my @beams = ("LBNF_FHC", "LBNE_RHC");
my @samples = (
  #~ "numuCCincl"     ,
  "numuCC0pi1trk"   ,
  "numuCC0pi2trk"   ,
  "numuCC0piNtrk"   ,
  "numuCC3trkDelta" ,
  "numuCC1piC"     ,
  #~ "numuCC2piC"  ,
  "numuCC1pi0"     ,
  "numuCC1piC1pi0" ,
  "numuCCoth"      ,
  "nueCC0pi"       ,  
  "nueCC1piC"      ,  
  "nueCC1pi0"      ,  
  "nueCCoth"       ,  
  "numuCCWS0pi"       ,  
  "numuCCWS1piC"      ,  
  "numuCCWS1pi0"      ,  
  "numuCCWSoth"       ,  
  "NC0pi"       ,  
  "NC1piC"      ,  
  "NC1pi0"      ,  
  "NCoth"       ,  
  "NeutrinoElec"     ,
  "InvMuDecay"       ,
  "nueCCinclWS"      
#  "nueCCincl"      ,
#  "numuCCinclWS" ,
#  "NCincl"         ,
  #~ "NC1piC"         ,
  #~ "NC1pi0"         ,
  #~ "NCoth"          ,
);
my @params = (
  "MFP_pi"     ,
  "MFP_N"      ,
  "FrCEx_pi"   ,
  #~ "FrElas_pi"  ,
  "FrInel_pi"  ,
  "FrAbs_pi"   ,
  "FrPiProd_pi",
  "FrCEx_N"    ,
  #~ "FrElas_N"   ,
  "FrInel_N"   ,
  "FrAbs_N"    ,
  "FrPiProd_N" ,
);

#~ foreach my $beam (@beams) {
foreach my $sample (@samples) {
  foreach my $param (@params) {
    
    print "Submitting run: ${jobID} with $beam $sample $params\n";

    $program = "valor_dune-make_response_functions";
    
    $arguments   = " --systematic $param --sample $sample --beam $beam --detector $detector --input $input --output $output --format $format";
    
    $command = $program." ".$arguments;
    print "Running: $command \n";
    
    #
    # HTCondor @ RAL
    #
    if($resource eq "RAL" || $resource eq "RAL_HTC") {
      $fullprogram = abs_path(`which $program`);
      $arguments =~ s/\"/\\\"/g;        # All double quotes must be escaped for Condor
      $arguments =~ s/\'//g;            # and apparently single quotes are unnecessary but break it
      $jobname = "valorspl-${beam}-${jobID}";
      $cndfn = "$job_dir/${jobname}.condor";
      open(BATCH_SCRIPT, ">".$cndfn) or die("Cannot create the Condor batch script");
      print BATCH_SCRIPT "Executable               = $fullprogram \n";
      print BATCH_SCRIPT "Arguments                = $arguments \n";
      print BATCH_SCRIPT "initialdir               = $job_dir \n";
      print BATCH_SCRIPT "Error                    = ${jobname}_\$\(Process\).err \n";
      print BATCH_SCRIPT "Output                   = ${jobname}_\$\(Process\).out \n";
      print BATCH_SCRIPT "Universe                 = vanilla \n";
      print BATCH_SCRIPT "Getenv                   = True \n";
      print BATCH_SCRIPT "should_transfer_files    = YES \n";
      print BATCH_SCRIPT "when_to_transfer_output  = ON_EXIT \n";
      print BATCH_SCRIPT "\nqueue\n";    
      close(BATCH_SCRIPT);
      system("condor_submit",$cndfn);
    }

    #
    # PBS (or HTCondor with PBS-like interface) @ RAL
    #
    elsif($resource eq "RAL_PBS" || $resource eq "RAL_HTCPBS") {    
       $batch_script = "$job_dir/$tag-${jobID}.pbs";
       open(BATCH_SCRIPT, ">$batch_script") or die("Can not create the PBS batch script");
       print BATCH_SCRIPT "#!/bin/bash \n";
       print BATCH_SCRIPT "#PBS -N $tag-${jobID} \n";
       print BATCH_SCRIPT "#PBS -l cput=$cput \n";
       print BATCH_SCRIPT "#PBS -o $job_dir/$tag-${jobID}.pbs.out \n";
       print BATCH_SCRIPT "#PBS -e $job_dir/$tag-${jobID}.pbs.err \n";
       print BATCH_SCRIPT "#PBS -q prod \n";
       print BATCH_SCRIPT "#PBS -V \n";
       print BATCH_SCRIPT "#PBS -l walltime=$cput \n";
       print BATCH_SCRIPT "source $fmwk_softw_dir/setup/setup_at_ral_no_cvmfs.sh \n";
       print BATCH_SCRIPT "source $dune_softw_dir/setup/setup_at_ral_no_cvmfs.sh \n";
       print BATCH_SCRIPT "cd $job_dir \n";
  #    print BATCH_SCRIPT "source $dune_softw_dir/setup/setup_at_cvmfs.sh $dune_softw_dir $fmwk_softw_dir\n";
       print BATCH_SCRIPT "$command \n";
       close(BATCH_SCRIPT);
       $job_submission_command = "qsub";
       if($resource eq "RAL_HTCPBS") {
           $job_submission_command = "condor_qsub";
       }
       `$job_submission_command -q prod $job_dir/$tag-${jobID}.pbs`;
    }

    #
    # Oxford/PBS
    #
    elsif($resource eq "Oxford_PBS") {
       open(BATCH_SCRIPT, ">$job_dir/$tag-${jobID}.pbs") or die("Can not create the PBS batch script");
       print BATCH_SCRIPT "#!/bin/bash \n";
       print BATCH_SCRIPT "#PBS -N $tag-${jobID} \n";
       print BATCH_SCRIPT "#PBS -l cput=$cput \n";
       print BATCH_SCRIPT "#PBS -o $job_dir/$tag-${jobID}.pbs.out \n";
       print BATCH_SCRIPT "#PBS -e $job_dir/$tag-${jobID}.pbs.err \n";
       print BATCH_SCRIPT "cd $job_dir \n";
       print BATCH_SCRIPT "source $dune_softw_dir/setup/setup_at_oxford.sh $dune_softw_dir $fmwk_softw_dir\n";
       print BATCH_SCRIPT "$command \n";
       close(BATCH_SCRIPT);
       `qsub $job_dir/$tag-${jobID}.pbs`;
    }
    
    #
    # Liverpool
    #
    elsif($resource eq "Liverpool_PBS") {
       open(BATCH_SCRIPT, ">$job_dir/$tag-${jobID}.pbs") or die("Can not create the PBS batch script");
       print BATCH_SCRIPT "#!/bin/bash \n";
       print BATCH_SCRIPT "#PBS -q all64 \n";
       print BATCH_SCRIPT "#PBS -N $tag-${jobID} \n";
       print BATCH_SCRIPT "#PBS -l cput=$cput \n";
       print BATCH_SCRIPT "#PBS -o $job_dir/$tag-${jobID}.pbs.out \n";
       print BATCH_SCRIPT "#PBS -e $job_dir/$tag-${jobID}.pbs.err \n";
       print BATCH_SCRIPT "cd $job_dir \n";
       print BATCH_SCRIPT "source $dune_softw_dir/setup/setup_at_cvmfs.sh $dune_softw_dir $fmwk_softw_dir\n";
       print BATCH_SCRIPT "$command \n";
       close(BATCH_SCRIPT);
       `qsub $job_dir/$tag-${jobID}.pbs`;
    }

    #
    # interactive
    #
    elsif($resource eq "interactive") {
       system($command);
    }
    
    else {
      print "Unknown resource $resource\n";
      exit;
    }

    ${jobID}++;
  }
}
