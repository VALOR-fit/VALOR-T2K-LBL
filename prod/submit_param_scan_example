#!/usr/bin/perl
#
#
#-------------------------------------------------------------------------------------------------------------------------------
# Submit the jobs to scan across 1 or 2 parameters
#
# Inputs
#  --resource               : Computer resource, <RAL, Oxford, Grid, ETH-Monch, interactive>. Default: interactive.
#  --tag                    : Tag for output files. Default: "param_scan".
#  --npoints                : Number of points you want to consider for deltaCP. Default: 50
#  --param1                 : Parameter to scan. Default: deltaCP
#  --min-value1             : Min param value for the sensitivity study. Default: -pi
#  --max-value1             : Max param value for the sensitivity study. Default: +pi
#  --log-param1             : Should we loop over the parameter range using log scaling?
#  --param2                 : Parameter to scan. Default, for 1D scan: "none"
#  --min-value2             : Min param value for the sensitivity study. Default, will crash if no range is given when a second parameter: "none"
#  --max-value2             : Max param value for the sensitivity study. Default, will crash if no range is given when a second parameter: "none"
#  --log-param2             : Should we loop over the parameter range using log scaling?
#  --discovery              : If enabled, change the true parameter used for generating data, not the fixed value. Default: false
#  --cpu-time               : Required CPU time. Default: "8:00:00" for RAL, "11:50:00" for Oxford.
#  --physics-hypothesis     : Specifies the physics hypothesis. Default: "3f_osc"
#  --hierarchy              : Specifies the mass hierarchy option. Default: "normal"
#  --fit-option             : Option passed to fitter. Default: "minuit".
#  --store-spectra          : Store the generated toy MC and best-fit spectra? Default: false.
#  --load-prior-from-file   : Get a ND fit covariance from an ND-fitted output file [ - ] 
#  --pot-override           : Override the default POT in the config file with this value (for every beam mode) (default -999, use config POT)

#  --job-dir                : Directory for job scripts and outputs. Default: `pwd`.
#  --dune-softw-dir         : VALOR/DUNE code top-level directory. Default: $VALOR_EXPT
#  --fmwk-softw-dir         : VALOR/FMWK code top-level directory. Default: $VALOR_FMWK
#  --config-file            : Analysis configuration file. Default: "default_config.xml"
#  --mesg-thresholds        : Message thresholds file. Default: "verbosity.xml"
#  [--ncores ]              : Number of cores-per-job to request and thus threads to use (requires C++11) [ 1 ]
#

# Probably need to add true OA params?

#
# Example usage: 
#  submit_param_scan --resource interactive --tag sbn_proposal_disap --physics-hypothesis eff_sterile_osc --config-file analysis/sbnd_proposal.xml --param1 sinsq2thMuMu --min-value1 1E-3 --max-value1 1 --log-param1 1 --param2 dm41sq --min-value2 1E-2 --max-value2 1E2 --log-param2 1 --discovery 1
#
# Steve Dennis
#-------------------------------------------------------------------------------------------------------------------------------
#
# FNAL Specific:
# 
# Make sure to select a group i.e sbnd. Also the config file must be in the valor config folder. 
#
# For questions ask Dominic Barker 
#-------------------------------------------------------------------------------------------------------------------------------

use File::Path;
use Cwd 'abs_path';

sub log10 {
  my $n = shift;
  return log($n)/log(10);
}

# What the null hypothesis value for a discovery plot is. Might have to become a command line argument?
$param_nullhyp1 = 0;
$param_nullhyp2 = 0;

$iarg=0;
foreach (@ARGV) {
  
  if($iarg % 2 == 1) {$iarg++; next;} # only even arguments are flags, the odd ones are values
  
  if   ($_ eq '--resource'               ) { $resource             = $ARGV[$iarg+1]; }
  elsif($_ eq '--ncores'                 ) { $ncores               = $ARGV[$iarg+1]; }
  elsif($_ eq '--tag'                    ) { $tag                  = $ARGV[$iarg+1]; }
  elsif($_ eq '--npoints1'               ) { $npoints1             = $ARGV[$iarg+1]; }
  elsif($_ eq '--param1'                 ) { $param1               = $ARGV[$iarg+1]; }
  elsif($_ eq '--min-value1'             ) { $min_value1           = $ARGV[$iarg+1]; }
  elsif($_ eq '--max-value1'             ) { $max_value1           = $ARGV[$iarg+1]; }
  elsif($_ eq '--log-param1'             ) { $log_param1           = $ARGV[$iarg+1]; }
  elsif($_ eq '--npoints2'               ) { $npoints2             = $ARGV[$iarg+1]; }
  elsif($_ eq '--param2'                 ) { $param2               = $ARGV[$iarg+1]; }
  elsif($_ eq '--min-value2'             ) { $min_value2           = $ARGV[$iarg+1]; }
  elsif($_ eq '--max-value2'             ) { $max_value2           = $ARGV[$iarg+1]; }
  elsif($_ eq '--log-param2'             ) { $log_param2           = $ARGV[$iarg+1]; }
  elsif($_ eq '--discovery'              ) { $discovery            = $ARGV[$iarg+1]; }
  elsif($_ eq '--cpu-time'               ) { $cput                 = $ARGV[$iarg+1]; }
  elsif($_ eq '--physics-hypothesis'     ) { $fitparamlist         = $ARGV[$iarg+1]; }
  elsif($_ eq '--hierarchy'              ) { $mhchoice             = $ARGV[$iarg+1]; }
  elsif($_ eq '--fit-option'             ) { $fitoption            = $ARGV[$iarg+1]; }
  elsif($_ eq '--store-spectra'          ) { $store_spectra        = $ARGV[$iarg+1]; }
  elsif($_ eq '--load-prior-from-file'   ) { $prior_file           = $ARGV[$iarg+1]; }
  elsif($_ eq '--pot-override'           ) { $pot_override         = $ARGV[$iarg+1]; }
  elsif($_ eq '--job-dir'                ) { $job_dir              = $ARGV[$iarg+1]; }
  elsif($_ eq '--dune-softw-dir'         ) { $dune_softw_dir       = $ARGV[$iarg+1]; }
  elsif($_ eq '--fmwk-softw-dir'         ) { $fmwk_softw_dir       = $ARGV[$iarg+1]; }
  elsif($_ eq '--config-file'            ) { $config_file          = $ARGV[$iarg+1]; }
  elsif($_ eq '--mesg-thresholds'        ) { $mesg_thresholds      = $ARGV[$iarg+1]; }
  elsif($_ eq '--tarball'                ) { $tarball              = $ARGV[$iarg+1]; }
  elsif($_ eq '--group'                  ) { $group                = $ARGV[$iarg+1]; }
  elsif($_ eq '--memory'                 ) { $memory               = $ARGV[$iarg+1]; }
  elsif($_ eq '--disk'                   ) { $disk                 = $ARGV[$iarg+1]; }
  else {
    print "Unrecognised argument ".$_."\n"; exit;
  }
  $iarg++;
}
$resource               = "interactive"                           unless defined $resource;
$tag                    = "param_scan"                            unless defined $tag;
$npoints1               = 50                                      unless defined $npoints1;
$param1                 = "cpv"                                   unless defined $param1;
$min_value1             = -3.141592653589793                      unless defined $min_value1;
$max_value1             = 3.141592653589793                       unless defined $max_value1;
$log_param1             = 0                                       unless defined $log_param1;
$npoints2               = 50                                      unless defined $npoints2;
$param2                 = "none"                                  unless defined $param2;
$min_value2             = "none"                                  unless defined $min_value2;
$max_value2             = "none"                                  unless defined $max_value2;
$log_param2             = 0                                       unless defined $log_param2;
$discovery              = 0                                       unless defined $discovery;
$fitparamlist           = "3f_osc"                                unless defined $fitparamlist;
$mhchoice               = "normal"                                unless defined $mhchoice;
$fitoption              = "minuit"                                unless defined $fitoption;
$store_spectra          = 0                                       unless defined $store_spectra;
$prior_file             = "-"                                     unless defined $prior_file;
$ncores                 = 1                                       unless defined $ncores;
$pot_override           = -999                                    unless defined $pot_override;
$group                  = ""                                      unless defined $group;
$job_dir                = `pwd`                                   unless defined $job_dir;
$dune_softw_dir         = $ENV{'VALOR_EXPT'}                      unless defined $dune_softw_dir;
$fmwk_softw_dir         = $ENV{'VALOR_FMWK'}                      unless defined $fmwk_softw_dir;
$config_file            = "default_config.xml"                    unless defined $config_file;
$memory                 = "8000MB"                                unless defined $memory; 
$disk                   = "40GB"                                  unless defined $disk;
#$mesg_thresholds        = $ENV{'VALOR_EXPT'}."/config/verbosity.xml"              unless defined $mesg_thresholds;
$mesg_thresholds        = "verbosity.xml"                         unless defined $mesg_thresholds;
$param_values    = "prefit-errors"; #not randomized-all now, Asimov dataset! 

chomp($job_dir);

if( !defined $cput ) {
    if($resource =~ "RAL"    ) { $cput =  "8:00:00"; }
    if($resource eq "Oxford" ) { $cput = "11:50:00"; }
    if($resource eq "fnal"   ) { $cput = "8h"; }
}

mkpath ($job_dir, {verbose => 1, mode=>0777}); 
die("$job_dir doesn't exist") unless -d $job_dir;

$job_dir = abs_path($job_dir);

## Only look for 2nd parameter if param2 != none
$only1dscan = 0;
if ($param2 eq "none") {
  $only1dscan = 1;
}

if ((!$only1dscan) && (($min_value2 eq "none") || ($max_value2 eq "none"))) {
  print "If there is a second parameter you must define min_value2 & max_value2, was given $min_value2 and $max_value2 \n";
  exit;
}

if ($npoints1 <= 1) {
  print "npoints1 must be 2 or greater, was given $npoints1";
  exit;
}
if ((!$only1dscan) && ($npoints2 <= 1)) {
  print "npoints2 must be 2 or greater, was given $npoints2";
  exit;
};

$step1 = ($max_value1-$min_value1)/($npoints1-1);
if ($log_param1) {
  $step1=(log10($max_value1)-log10($min_value1))/($npoints1-1);
}

if(!$only1dscan) {
  $step2 = ($max_value2-$min_value2)/($npoints2-1);
  if ($log_param2) {
    $step2=(log10($max_value2)-log10($min_value2))/($npoints2-1);
  }
}


$jobID = 0;

for($ipoint1 = 0; $ipoint1 < $npoints1; $ipoint1++) {
    
    $program   = "valor_dune-run_fit";
    
    $param_val1 = $min_value1 + $ipoint1*$step1;
    
    if($log_param1) {
	$param_val1 = 10**($step1*($ipoint1)+log10($min_value1));
    }
    
    for($ipoint2 = 0; $ipoint2 < $npoints2; $ipoint2++) {
	
	if ($only1dscan) {
	    print "Submitting 1D point: $ipoint1 as job $jobID";
	    print " with $param1 = $param_val1 \n";
	}
	else {
		$param_val2 = $min_value2 + ($ipoint2)*$step2;
		if($log_param2) {
		    $param_val2 = 10**($step2*($ipoint2)+log10($min_value2));
		}
		
		print "Submitting point: $ipoint1 - $ipoint2 as job $jobID";
		print " with $param1 = $param_val1 and $param2 = $param_val2\n";
	}
	
	#
	# Perform all fits
	# Fixing the parameter each value in the scan
	
	$standard_options = " --run $jobID --ntoymc 1  --physics-hypothesis $fitparamlist".
	    " --param-values-option  $param_values --fitter $fitoption".
	    " --config $config_file --mesg-thresholds $mesg_thresholds --without-stat-fluct ".
	    " --$mhchoice --load-prior-from-file $prior_file --pot-override $pot_override ";
	
	if (!$discovery) {
	    $arguments = "--tag $tag-$param1-$param2 ".
		"--first-octant ".$standard_options.
		" --fix-at-$param1 $param_val1 ".
		" --fix-$param1 ";
	    if (!$only1dscan) {
		$arguments = $arguments.
		    " --fix-at-$param2 $param_val2 ".
		    " --fix-$param2 ";
	    }
	}
	else {
	    $arguments = "--tag $tag-$param1-$param2 ".
		"--first-octant ".$standard_options.
		" --input-$param1 $param_val1 ".
		" --fix-at-$param1 $param_nullhyp1 ".
		" --fix-$param1 ";
	    if (!$only1dscan) {
		$arguments = $arguments.
		    " --input-$param2 $param_val2 ".
		    " --fix-at-$param2 $param_nullhyp2 ".
		    " --fix-$param2 ";
	    }
	}
	
	
	$command = $program." ".$arguments;
	
	print "Running: $command \n";
	
	if($resource eq "fnal"){

	    #Create script for running the file
	    $jobname = "${tag}-${param1}-${param2}-${jobID}";
	    $shellfn = "$job_dir/${jobname}.sh";
	    open(shell,">".$shellfn);
	    print shell "$command \n";
	    close(shell);
	    
	    #Run jobsub
	    system("do_jobsub_submission --shellscript $shellfn --group $group --jobdir $job_dir --cputime $cput --memory $memory --disk $disk");
	}
  
	#
	# HTCondor @ RAL
	#
	
	if($resource eq "RAL" || $resource eq "RAL_HTC") {
	    $fullprogram = abs_path(`which $program`);
	    chomp($fullprogram);
	    
	    $fmwk_setup_script = "$fmwk_softw_dir/setup/setup_at_cvmfs_root6.sh";
	    $dune_setup_script = "$dune_softw_dir/setup/setup_at_cvmfs_root6.sh";
	    
	    $jobname = "${tag}-${param1}-${param2}-${jobID}";
	    $shellfn = "$job_dir/${jobname}.sh";
	    
		open(shell,">".$shellfn);
	    print shell "hostname \n";
	    print shell "date \n";
	    print shell "source $fmwk_setup_script \n";
	    print shell "source $dune_setup_script \n";
	    print shell "$command \n";
	    print shell "date \n";
	    close(shell);
		
	    $default_cnd_options =
		"Executable               = /bin/bash \n".
		"initialdir               = $job_dir \n".
		"Universe                 = vanilla \n".
		"Getenv                   = False \n".
		"should_transfer_files    = YES \n".
		"when_to_transfer_output  = ON_EXIT \n".
		(ncores > 1 ? "request_cpus             = $ncores \n":"").
		"\nqueue\n";
	    
	    $cndfn = "$job_dir/${jobname}.condor";
	    open(CND, ">".$cndfn) or die("Cannot create the Condor batch script");
	    print CND "Arguments                = $shellfn \n";
	    print CND "Error                    = ${jobname}_\$\(Process\).err \n";
	    print CND "Output                   = ${jobname}_\$\(Process\).out \n";
	    print CND $default_cnd_options;
	    close(CND);
	    system("condor_submit",$cndfn);
	    
	}
	
	#
	# interactive
	#
	if($resource eq "interactive") {
	    system($command);
	}
	
	$jobID++;
	
	# If we're scanning 1D, break the second loop
	if ($only1dscan) {last;}
    } # for point2
} # for point1




