#!/usr/bin/perl


#-------------------------------------------------------------------------------------------------------------------------------
# Submit a batch of run_build_toys.cxx jobs
#
# Inputs
#  --resource               : Computer resource, <Liverpool_Slurm, cedar, interactive>. Default: interactive
#  --cpu-time               : Requested CPU time
#  --mem                    : Requested memory
#  --job-dir                : Directory for job scripts and outputs. Default: `pwd`
#  --softw-dir              : Oscillation code top-level directory. Default: `VALOR_EXPT` environment variable
#  --fmwk-dir               : SDK top-level directory. Default: `VALOR_FMWK` environment variable
#  --time-command           : Time the jobs
#
#  --gen-fakedata           : Generate fake data toys instead of marginalisation toys.
# 														 Default: generate marginalisation toys							   # TODO: Implement & allow params to be fixed + syst set to nominal for generating Asimov
#  --stat-fluct             : Apply statistical fluctuations to the generated toys
#  --rand-syst              : Randomise non-fixed parameters
#  --ntoys                  : The number of toys to build in each job
#  --batch                  : The batch number, used to offset the seeds when generating additional toys
#  --par1                   : The 1st un-marginalised parameter of interest
#  --par2                   : The 2nd un-marginalised parameter of interest (optional)
#  --npt-par1               : Number of points of the 1st fit parameter to scan
#  --npt-par2               : Number of points of the 2nd fit parameter to scan
#  --min-par1               : Minimum value of the 1st fit parameter
#  --min-par2               : Minimum value of the 2nd fit parameter
#  --max-par1               : Maximum value of the 1st fit parameter
#  --max-par2               : Maximum value of the 2nd fit parameter
#  --npt-job-par1           : Number of points of the 1st fit parameter to run in each job	# TODO: Not yet implemented
#  --npt-job-par2           : Number of points of the 2nd fit parameter to run in each job	# TODO: Not yet implemented
#  --prior-file             : Config file containing the priors used to throw toys
#  --store-mode-arrays      : If true, stores both the total PDF arrays and those broken down by
#                             mode contributions. If false, only store the total PDF arrays.
#
#  --tag                    : Naming tag for output files
#  --config                 : Analysis configuration file from the config/analysis directory
#  --physics-hypothesis     : Physics hypothesis name (see UtlParam.cxx)
#  --fit-param-opt          : Options used when setting up the FitParamList
#  --param-values-option    : Decide how to set the values of physics params used for toy-MC generation
#  --mesg-thresholds        : Message thresholds config file
#  --store-specra           : Store toy-MC/best-fit spectra?
#  --rethrow-unphysical     : Toys that are generated with unphysical parameter values are rethrown
#  --use-simple-binning     : Update the simple binning MC templates
#  --save-throws-to-tree    : Save all toy parameter values to a tree
#
#  --dmsq-scheme            : abs23 or fogli
#  --hierarchy              : normal or inverted
#  --marg-hierarchy         : Marginalise the mass hierarchy			# TODO: Not yet implemented
#  --mix-param-choice       : sinsq2theta or sinsqtheta
#  --mix-param-octant       : one or two
#
#  --seed-syst              : Seed used for randomising systematic parameters
#  --seed-osc               : Seed used for randomising oscillation parameters
#  --seed-stat              : Seed used for randomising statistical fluctuations
#  --seed-other             : Seed used for randomising things that are not parameters
#
#  --gen-fc-toys            : Generate Feldman-Cousins toys instead of marginalisation toys.
#                             Structurally, these are identical to marginalisation toys and can be generated in the same
#                             way, but are typically generated at a fewer number of grid points and the toys are used in
#                             different ways after they've been generated. So reuse this script, for convenience and
#                             to reduce maintenance.
#
#  --use-t2k-presets        : Use hard-coded T2K values for the number of toys, parameter ranges, job grouping,
#                             CPU time etc. for the parameter(s) of interest
#
#
#  --read-throws-from       : If this is specified, then read throws from this file instead of generating toys.
#                             This is used e.g. to convert T2K legacy toy throws into SDK marginalisation toys.
#  --read-throws-param-map  : If using --read-throws-from, also specify this argument, which is used to convert
#                             SDK parameter names into the parameter names used by the toy_throw_file_to_read.
#
# F.Bench
#-------------------------------------------------------------------------------------------------------------------------------
#

use File::Path;
use Cwd 'abs_path';

#
# Read command line arguments
#

$iarg=0;
foreach (@ARGV) {
  if($iarg % 2 == 1) {$iarg++; next;}

     if($_ eq '--resource'             ) { $resource              = $ARGV[$iarg+1]; }
  elsif($_ eq '--cpu-time'             ) { $cput                  = $ARGV[$iarg+1]; }
  elsif($_ eq '--mem'                  ) { $mem                   = $ARGV[$iarg+1]; }
  elsif($_ eq '--job-dir'              ) { $job_dir               = $ARGV[$iarg+1]; }
  elsif($_ eq '--softw-dir'            ) { $softw_dir             = $ARGV[$iarg+1]; }
  elsif($_ eq '--fmwk-dir'             ) { $fmwk_dir              = $ARGV[$iarg+1]; }
  elsif($_ eq '--time-command'         ) { $time_command          = $ARGV[$iarg+1]; }
  elsif($_ eq '--gen-fakedata'         ) { $gen_fakedata          = $ARGV[$iarg+1]; }
  elsif($_ eq '--stat-fluct'           ) { $stat_fluct            = $ARGV[$iarg+1]; }
  elsif($_ eq '--rand-syst'            ) { $rand_syst             = $ARGV[$iarg+1]; }
  elsif($_ eq '--ntoys'                ) { $ntoys                 = $ARGV[$iarg+1]; }
  elsif($_ eq '--batch'                ) { $batch                 = $ARGV[$iarg+1]; }
  elsif($_ eq '--par1'                 ) { $par1                  = $ARGV[$iarg+1]; }
  elsif($_ eq '--par2'                 ) { $par2                  = $ARGV[$iarg+1]; }
  elsif($_ eq '--npt-par1'             ) { $npt_par1              = $ARGV[$iarg+1]; }
  elsif($_ eq '--npt-par2'             ) { $npt_par2              = $ARGV[$iarg+1]; }
  elsif($_ eq '--min-par1'             ) { $min_par1              = $ARGV[$iarg+1]; }
  elsif($_ eq '--min-par2'             ) { $min_par2              = $ARGV[$iarg+1]; }
  elsif($_ eq '--max-par1'             ) { $max_par1              = $ARGV[$iarg+1]; }
  elsif($_ eq '--max-par2'             ) { $max_par2              = $ARGV[$iarg+1]; }
  elsif($_ eq '--npt-job-par1'         ) { $npt_job_par1          = $ARGV[$iarg+1]; }
  elsif($_ eq '--npt-job-par2'         ) { $npt_job_par2          = $ARGV[$iarg+1]; }
  elsif($_ eq '--prior-file'           ) { $prior_file            = $ARGV[$iarg+1]; }
  elsif($_ eq '--store-mode-arrays'    ) { $store_mode_arrays     = $ARGV[$iarg+1]; }
  elsif($_ eq '--tag'                  ) { $tag                   = $ARGV[$iarg+1]; }
  elsif($_ eq '--config'               ) { $config                = $ARGV[$iarg+1]; }
  elsif($_ eq '--physics-hypothesis'   ) { $fit_param_list        = $ARGV[$iarg+1]; }
  elsif($_ eq '--fit-param-opt'        ) { $fit_param_opt         = $ARGV[$iarg+1]; }
  elsif($_ eq '--param-values-option'  ) { $param_values_option   = $ARGV[$iarg+1]; }
  elsif($_ eq '--mesg-thresholds'      ) { $mesg_thresholds       = $ARGV[$iarg+1]; }
  elsif($_ eq '--store-specra'         ) { $store_specra          = $ARGV[$iarg+1]; }
  elsif($_ eq '--rethrow-unphysical'   ) { $rethrow_unphysical    = $ARGV[$iarg+1]; }
  elsif($_ eq '--use-simple-binning'   ) { $use_simple_binning    = $ARGV[$iarg+1]; }
  elsif($_ eq '--save-throws-to-tree'  ) { $save_throws           = $ARGV[$iarg+1]; }
  elsif($_ eq '--dmsq-scheme'          ) { $dmsq_scheme           = $ARGV[$iarg+1]; }
  elsif($_ eq '--hierarchy'            ) { $hierarchy             = $ARGV[$iarg+1]; }
  elsif($_ eq '--marg-hierarchy'       ) { $marg_hierarchy        = $ARGV[$iarg+1]; }
  elsif($_ eq '--mix-param-choice'     ) { $mix_param_choice      = $ARGV[$iarg+1]; }
  elsif($_ eq '--mix-param-octant'     ) { $mix_param_octant      = $ARGV[$iarg+1]; }
  elsif($_ eq '--seed-syst'            ) { $seed_syst             = $ARGV[$iarg+1]; }
  elsif($_ eq '--seed-osc'             ) { $seed_osc              = $ARGV[$iarg+1]; }
  elsif($_ eq '--seed-stat'            ) { $seed_stat             = $ARGV[$iarg+1]; }
  elsif($_ eq '--seed-other'           ) { $seed_other            = $ARGV[$iarg+1]; }
  elsif($_ eq '--use-t2k-presets'      ) { $use_t2k_presets       = $ARGV[$iarg+1]; }
  elsif($_ eq '--gen-fc-toys'          ) { $gen_fc_toys           = $ARGV[$iarg+1]; }
  elsif($_ eq '--read-throws-from'     ) { $read_throws_from      = $ARGV[$iarg+1]; }
  elsif($_ eq '--read-throws-param-map') { $read_throws_param_map = $ARGV[$iarg+1]; }

  else {
      print "Unrecognised argument ".$_."\n"; exit;
  }
  $iarg++;
}

#
# Set unspecfied arguments to their default values
#

$resource              = "interactive"                                                       unless defined $resource;
$cput                  = "8:00:00"                                                           unless (defined $cput || $use_t2k_presets == 1);
$mem                   = "3500M"                                                             unless (defined $mem  || $use_t2k_presets == 1);
$job_dir               = $ENV{'PWD'}                                                         unless defined $job_dir;
$softw_dir             = $ENV{'VALOR_EXPT'}                                                  unless defined $softw_dir;
$fmwk_dir              = $ENV{'VALOR_FMWK'}                                                  unless defined $fmwk_dir;
$time_command          = 0                                                                   unless defined $time_command;
$gen_fakedata          = 0                                                                   unless defined $gen_fakedata;
$stat_fluct            = 0                                                                   unless defined $stat_fluct;
$rand_syst             = 1                                                                   unless defined $rand_syst;
$ntoys                 = 40000                                                               unless (defined $ntoys || $use_t2k_presets == 1);
$batch                 = 1                                                                   unless defined $batch;
$par1                  = "cpv"                                                               unless defined $par1;
$par2                  = "none"                                                              unless defined $par2;
$npt_par1              = 101                                                                 unless (defined $npt_par1 || $use_t2k_presets == 1);
$npt_par2              = 0.                                                                  unless (defined $npt_par2 || $use_t2k_presets == 1);
$min_par1              = -3.14159265358979312e+00                                            unless (defined $min_par1 || $use_t2k_presets == 1);
$min_par2              = 0.                                                                  unless (defined $min_par2 || $use_t2k_presets == 1);
$max_par1              = +3.14159265358979312e+00                                            unless (defined $max_par1 || $use_t2k_presets == 1);
$max_par2              = 0                                                                   unless (defined $max_par2 || $use_t2k_presets == 1);
$prior_file            = ""                                                                  unless defined $prior_file;
$store_mode_arrays     = 0                                                                   unless defined $store_mode_arrays;
$npt_job_par1          = 1                                                                   unless (defined $npt_job_par1 || $use_t2k_presets == 1);
$npt_job_par2          = 1                                                                   unless (defined $npt_job_par2 || $use_t2k_presets == 1);
$fit_param_list        = "3f_osc"                                                            unless defined $fit_param_list;
$fit_param_opt         = ""                                                                  unless defined $fit_param_opt;
$param_values_option   = "randomize-all\\;prefit-errors"                                     unless defined $param_values_option;
$mesg_thresholds       = "verbosity.xml"                                                     unless defined $mesg_thresholds;
$store_specra          = 0                                                                   unless defined $store_specra;
$rethrow_unphysical    = 1                                                                   unless defined $rethrow_unphysical;
$use_simple_binning    = 0                                                                   unless defined $use_simple_binning;
$save_throws           = 0                                                                   unless defined $save_throws;
$dmsq_scheme           = "auto"                                                              unless defined $dmsq_scheme;
$hierarchy             = "normal"                                                            unless defined $hierarchy;
$marg_hierarchy        = 0                                                                   unless defined $marg_hierarchy;
$mix_param_choice      = "sinsqtheta"                                                        unless defined $mix_param_choice;
$mix_param_octant      = "two"                                                               unless defined $mix_param_octant;
$seed_syst             = 0                                                                   unless defined $seed_syst;
$seed_osc              = 0                                                                   unless defined $seed_osc;
$seed_stat             = 0                                                                   unless defined $seed_stat;
$seed_other            = 0                                                                   unless defined $seed_other;
$tag                   = "toys"                                                              unless defined $tag;
$config                = "analysis/t2k_analysis_configuration_oa2018_run1-9d_v1_postfit.xml" unless defined $config;
$gen_fc_toys           = 0                                                                   unless defined $gen_fc_toys;
$read_throws_from      = "NONE"                                                              unless defined $read_throws_from;
$read_throws_param_map = "NONE"                                                              unless defined $read_throws_param_map;

# If we have only a single parameter of interest defined, set the options for par2 appropriately
if($par2 eq "none") {
	$min_par2     = 0.;
	$max_par2     = 0.;
	$npt_par2     = 1;
	$npt_job_par2 = 1;
}

# Add the hierarchy and the parameters of interest to the file tag
$tag = "${tag}_${hierarchy}_${par1}";
if($par2 != "") {
	$tag = "${tag}_${par2}";
}

#
# Apply hard-coded T2K presets where applicable
#

if($use_t2k_presets == 1) {

	# TODO: None of the T2K CPU time and memory presets have been tested in the migrated analysis yet

  # Are we using a reactor constraint or not?
  $use_reactors = 1;
  if (index($prior_file, "reactor") == -1) {
		$use_reactors = 0;
		$tag = "${tag}_t2k";
	}
	else {
	  $tag = "${tag}_reactor";
	}

	# Do we want to generate Feldman-Cousins fake data toys? If so, set presets accordingly
	if($gen_fc_toys == 1) {
		$gen_fakedata = 1;

	  if(!(($par1 eq "cpv") and ($par2 eq "none")) || $use_reactors == 0) {
	  	die("ERROR: FC presets for T2K are currently ony defined for 1D deltacp with reactors");
	  }

	  # For FC, statistical fluctuations must be turned on
    if($stat_fluct == 0) {
    	$stat_fluct = 1;
    	print "WARNING: Forcing statistical fluctuations to be applied to FC toys.\n";
    }
	}

	if($gen_fakedata == 1 && $stat_fluct == 0) {
		print "WARNING: Fake data toys are being generated WITHOUT statistical fluctuations applied. Is this intentional?";
	}
	if($gen_fakedata == 0 && $stat_fluct == 1) {
		print "WARNING: Marginalisation toys are being generated WITH statistical fluctuations applied. Is this intentional?";
	}

	# 1D fit - beta
  if(($par1 eq "beta") and ($par2 eq "none")) {
		if($use_reactors == 1) {
      $ntoys        = 200000      unless defined $ntoys;
      $cput         = "65:00:00"  unless defined $cput;
      $mem          = "10000M"    unless defined $mem;
    }
    else {
      $ntoys        = 400000      unless defined $ntoys;
      $cput         = "130:00:00" unless defined $cput;
      $mem          = "20000M"    unless defined $mem;
    }
    $npt_par1       = 2           unless defined $npt_par1;
    $min_par1       = 0           unless defined $min_par1;
    $max_par1       = 1           unless defined $max_par1;
    $npt_job_par1   = 1           unless defined $npt_job_par1;
    $marg_hierarchy = 1           unless defined $marg_hierarchy;
  } # 1D beta

  # 1D fit - CPV
	if(($par1 eq "cpv") and ($par2 eq "none")) {
		if($gen_fc_toys == 1) {
			# Feldman-Cousins presets
			$ntoys           = 10000                    unless defined $ntoys;
			$cput            = "3:00:00"                unless defined $cput;
      $mem             = "3500M"                  unless defined $mem;
      $npt_par1        = 9                        unless defined $npt_par1;
      $min_par1        = -3.14159265358979312e+00 unless defined $min_par1;
      $max_par1        = +3.14159265358979312e+00 unless defined $max_par1;
      $npt_job_par1    = 1                        unless defined $npt_job_par1;
		}
		else {
		  # Marginalisation presets
			if($use_reactors == 1) {
				$ntoys      = 40000                     unless defined $ntoys;
				$cput       = "10:00:00"                unless defined $cput;
				$mem        = "4000M"                  unless defined $mem;
			}
			else {
				$ntoys      = 80000                    unless defined $ntoys;
				$cput       = "15:00:00"               unless defined $cput;
				$mem        = "5000M"                  unless defined $mem;
			}
			$npt_par1     = 101                       unless defined $npt_par1;
			$min_par1     = -3.14159265358979312e+00  unless defined $min_par1;
			$max_par1     = +3.14159265358979312e+00  unless defined $max_par1;
			$npt_job_par1 = 1                         unless defined $npt_job_par1;
		}
	} # 1D CPV

  # 1D fit - sinsqth13
	if(($par1 eq "mixing13") and ($par2 eq "none")) {
		$ntoys        = 40000     unless defined $ntoys;
    $cput         = "8:00:00" unless defined $cput;
    $mem          = "3500M"   unless defined $mem;
		$npt_par1     = 101       unless defined $npt_par1;
		$min_par1     = 0.007     unless defined $min_par1;
		$max_par1     = 0.053     unless defined $max_par1;
		$npt_job_par1 = 1         unless defined $npt_job_par1;
	} # 1D sinsqth13

	# 1D fit - sinsqth23
	if(($par1 eq "mixing12") and ($par2 eq "none")) {
		if($use_reactors == 1) {
			$ntoys      = 40000      unless defined $ntoys;
			$cput       = "8:00:00"  unless defined $cput;
			$mem        = "4000M"    unless defined $mem;
		}
		else {
			$ntoys      = 80000      unless defined $ntoys;
			$cput       = "15:00:00" unless defined $cput;
			$mem        = "5500M"    unless defined $mem;
		}
		$npt_par1     = 101        unless defined $npt_par1;
		$min_par1     = 0.3        unless defined $min_par1;
		$max_par1     = 0.7        unless defined $max_par1;
		$npt_job_par1 = 1          unless defined $npt_job_par1;
	} # 1D sinsqth23

	# 1D fit - dmsq23
	if(($par1 eq "dmsq23") and ($par2 eq "none")) {
		if($use_reactors == 1) {
			$ntoys      = 40000      unless defined $ntoys;
			$cput       = "8:00:00"  unless defined $cput;
			$mem        = "4000M"    unless defined $mem;
		}
		else {
			$ntoys      = 80000      unless defined $ntoys;
			$cput       = "15:00:00" unless defined $cput;
			$mem        = "5500M"    unless defined $mem;
		}
		$npt_par1     = 101        unless defined $npt_par1;
		$min_par1     = 2.2e-3     unless defined $min_par1;
		$max_par1     = 2.8e-3     unless defined $max_par1;
		$npt_job_par1 = 1          unless defined $npt_job_par1;
	} # 1D dmsq23

	# 2D fit - sinsqth13 vs. CPV
	if( (($par1 eq "cpv") and ($par2 eq "mixing13")) or (($par1 eq "mixing13") and ($par2 eq "cpv")) ) {
	  if($par1 eq "cpv") {
	 	  $par1 = "mixing13";
	 	  $par2 = "cpv";
	  }
		if($use_reactors == 1) {
			$ntoys      = 10000                    unless defined $ntoys;
			$cput       = "35:00:00"               unless defined $cput;
			$mem        = "4096M"                  unless defined $mem;
			$min_par1   = 0.015                    unless defined $min_par1;
      $max_par1   = 0.036                    unless defined $max_par1;
		}
		else {
			$ntoys      = 20000                    unless defined $ntoys;
			$cput       = "40:00:00"               unless defined $cput;
			$mem        = "5120M"                  unless defined $mem;
			$min_par1   = 0.007                    unless defined $min_par1;
      $max_par1   = 0.053                    unless defined $max_par1;
		}
		$npt_par1     = 81                       unless defined $npt_par1;
		$npt_job_par1 = 4                        unless defined $npt_job_par1;
		$min_par2     = -3.14159265358979312e+00 unless defined $min_par2;
    $max_par2     = +3.14159265358979312e+00 unless defined $max_par2;
    $npt_par2     = 51                       unless defined $npt_par2;
    $npt_job_par2 = 3                        unless defined $npt_job_par2;
	} # 2D sinsqth13 vs. CPV

  # 2D fit - sinsqth23 vs. dmsq23
	if( (($par1 eq "dmsq23") and ($par2 eq "mixing23")) or (($par1 eq "mixing23") and ($par2 eq "dmsq23")) ) {
		if($par1 eq "dmsq23") {
			$par1 = "mixing23";
			$par2 = "dmsq23";
		}
		if($use_reactors == 1) {
			$ntoys      = 10000      unless defined $ntoys;
			$cput       = "20:00:00" unless defined $cput;
			$mem        = "4096M"    unless defined $mem;
		}
		else {
			$ntoys      = 20000      unless defined $ntoys;
			$cput       = "40:00:00" unless defined $cput;
			$mem        = "5120M"    unless defined $mem;
		}
		$npt_par1     = 81         unless defined $npt_par1;
		$min_par1     = 0.3        unless defined $min_par1;
    $max_par1     = 0.7        unless defined $max_par1;
		$npt_job_par1 = 4          unless defined $npt_job_par1;
		$min_par2     = 2.2e-3     unless defined $min_par2;
		$max_par2     = 2.8e-3     unless defined $max_par2;
		$npt_par2     = 51         unless defined $npt_par2;
		$npt_job_par2 = 3          unless defined $npt_job_par2;
	} # 2D sinsqth23 vs. dmsq23

	# 2D fit - sinsqth23 vs. cpv
	if( (($par1 eq "mixing23") and ($par2 eq "cpv")) or (($par1 eq "cpv") and ($par2 eq "mixing23")) ) {
		if($par1 eq "cpv") {
			$par1 = "mixing23";
			$par2 = "cpv";
		}
		if($use_reactors == 1) {
			$ntoys      = 10000                    unless defined $ntoys;
			$cput       = "20:00:00"               unless defined $cput;
			$mem        = "4096M"                  unless defined $mem;
		}
		else {
			$ntoys      = 20000                    unless defined $ntoys;
			$cput       = "40:00:00"               unless defined $cput;
			$mem        = "5120M"                  unless defined $mem;
		}
		$npt_par1     = 81                       unless defined $npt_par1;
		$min_par1     = 0.3                      unless defined $min_par1;
		$max_par1     = 0.7                      unless defined $max_par1;
		$npt_job_par1 = 4                        unless defined $npt_job_par1;
		$min_par2     = -3.14159265358979312e+00 unless defined $min_par2;
		$max_par2     = +3.14159265358979312e+00 unless defined $max_par2;
		$npt_par2     = 51                       unless defined $npt_par2;
		$npt_job_par2 = 3                        unless defined $npt_job_par2;
	} # 2D sinsqth23 vs. cpv
} # use T2K presets

# Make the job directory
mkpath ($job_dir, {verbose => 1, mode=>0777});
die("$job_dir doesn't exist") unless -d $job_dir;

#
# Submit jobs by looping over all point of both parameters of interest
#

$jobID=0;
$irun=0;
$step_par1 = 0;
$step_par2 = 0;
if($npt_par1 > 1) { $step_par1 = ($max_par1 - $min_par1) / ($npt_par1 - 1); }
if($npt_par2 > 1) { $step_par2 = ($max_par2 - $min_par2) / ($npt_par2 - 1); }

for($ibin1 = 0; $ibin1 < $npt_par1; $ibin1 = $ibin1_p1) {
  $val_par1 = $min_par1 + $ibin1 * $step_par1;
  for($ibin2 = 0; $ibin2 < $npt_par2; $ibin2 = $ibin2_p1) {
    $val_par2 = $min_par2 + $ibin2 * $step_par2;


    $ibin1_p1 = $ibin1 + $npt_job_par1;
    $ibin2_p1 = $ibin2 + $npt_job_par2;

        # loop in build_marg_toy is min <= bin <= max, avoid repetition of the last bin
    if( $ibin1_p1 == $ibin1 ){
      last;
    }
    if( $ibin2_p1 == $ibin2 ){
      last;
    }
		print "/////////////////////////////// \n \n";
		print "File output ID: $fileid \n";
		print "   - bin param 1: $ibin1 \n";
		print "   - bin param 2: $ibin2 \n";
		print "\n";

		# If we have only a single parameter of interest defined, set the options for par2 appropriately
		$sub_par2  = $par2;
		$sub_ibin2 = $ibin2;
    if($par2 eq "none") {
      $sub_par2  = "-";
    	$sub_ibin2 = -1;		# This tells the ToyBuilder class that we have a 1D fit
    }

		$program = "valor_dune-run_build_toys";

		$arguments = "--tag $tag --batch $batch --ntoys $ntoys --physics-hypothesis $fit_param_list " .
		             "--fit-param-opt $fit_param_opt --param-values-option $param_values_option --config $config " .
		             "--mesg-thresholds $mesg_thresholds --fit-param1 $par1 --fit-param1-value $val_par1 " .
		             "--fit-param1-bin $ibin1 --fit-param2 $sub_par2 --fit-param2-value $val_par2 " .
		             "--fit-param2-bin $sub_ibin2 --$hierarchy --$mix_param_choice --seed-toys-syst $seed_syst " .
		             "--seed-toys-osc $seed_osc --seed-toys-stat $seed_stat --seed-other $seed_other " .
		             "--prior-file $prior_file --read-throws-from $read_throws_from " .
		             "--read-throws-param-map $read_throws_param_map --dmsq-scheme $dmsq_scheme " .
                 "--npt-job-par1 $npt_job_par1 --npt-job-par2 $npt_job_par2 " .
                 "--npt-par1 $npt_par1 --npt-par2 $npt_par2 " . 
                 "--min-par1 $min_par1 --min-par2 $min_par2 " .
                 "--step-par1 $step_par1 --step-par2 $step_par2 ";


    if($store_specra       == 1)       { $arguments = "$arguments --store-spectra"      } else { $arguments = "$arguments --discard-spectra"    }
    if($rethrow_unphysical == 1)       { $arguments = "$arguments --rethrow-unphysical" } else { $arguments = "$arguments --accept-unphysical"  }
    if($use_simple_binning == 1)       { $arguments = "$arguments --use-simple-binning" } else { $arguments = "$arguments --no-simple-binning"  }
    if($save_throws        == 1)       { $arguments = "$arguments --save-throws"        } else { $arguments = "$arguments --discard-throws"     }
    if($gen_fakedata       == 1)       { $arguments = "$arguments --gen-fakedata-toys"  } else { $arguments = "$arguments --gen-marg-toys"      }
    if($stat_fluct         == 1)       { $arguments = "$arguments --with-stat-fluct"    } else { $arguments = "$arguments --without-stat-fluct" }
    if($rand_syst          == 1)       { $arguments = "$arguments --rand-syst"          } else { $arguments = "$arguments --without-rand-syst"  }
    if($store_mode_arrays  == 1)       { $arguments = "$arguments --store-mode-arrays"  } else { $arguments = "$arguments --skip-mode-arrays"   }
    if($mix_param_octant   eq "two")   { $arguments = "$arguments --second-octant"      } else { $arguments = "$arguments --first-octant"       }

		$command = "$program $arguments";
		print "$command \n";

		#
		# Liverpool_Slurm
		#
		if($resource eq "Liverpool_Slurm") {
		  open(Slurm, ">$job_dir/$tag.slurm") or die("Can not create the Slurm batch script");
		  print Slurm "#!/bin/bash \n";
		  print Slurm "#SBATCH -J $tag-$irun \n";
		  print Slurm "#SBATCH -o $job_dir/$tag-$irun.slurm.out \n";
		  print Slurm "#SBATCH -e $job_dir/$tag-$irun.slurm.err \n";
		  print Slurm "#SBATCH -t $cput \n";
		  print Slurm "#SBATCH --mem=$mem \n";
		  print Slurm "cd $job_dir \n";
		  print Slurm "source $softw_dir/setup/setup_at_cvmfs_root6.sh $softw_dir $fmwk_dir\n";
		  if($time_command == 1) { print Slurm "/usr/bin/time $command \n"; }
		  else { print Slurm "$command \n"; }
		  close(Slurm);
		  `sbatch -p compute $job_dir/$tag.slurm`;
		}

	  if($resource eq "cedar") {

	 	  open(Slurm, ">$job_dir/$tag-$irun.slurm") or die("Can not create the Slurm batch script");
	 	  print Slurm "#!/bin/bash \n";
	 	  print Slurm "#SBATCH --account=def-tanaka-ac \n";		# A larger allocation is available on "rpp-tanaka-ab", but it's only available on cedar
	 	  print Slurm "#SBATCH --nodes=1 \n";
	 	  print Slurm "#SBATCH --time=$cput \n";
	 	  print Slurm "#SBATCH --mem=$mem \n";
	 	  print Slurm "#SBATCH --job-name=$tag-$irun \n";
	 	  print Slurm "#SBATCH -o $job_dir/$tag-$irun.slurm.out \n";
	 	  print Slurm "#SBATCH -e $job_dir/$tag-$irun.slurm.err \n";
	 	  print Slurm "cd $job_dir \n";
	 	  print Slurm "source $softw_dir/setup/setup_at_cedar_root6.sh $softw_dir $fmwk_dir\n";
	 	  if($time_command == 1) { print Slurm "time $command \n"; }
	 	  else { print Slurm "$command \n"; }
	 	  close(Slurm);
	 	  `sbatch $job_dir/$tag-$irun.slurm`;
	  }

		if($resource eq "cedar_opt")
		{
		  open(Slurm, ">$job_dir/temp_${irun}.txt") or die("Cannot create temp");
		  print Slurm "$command";
		  close(Slurm);
		  print Slurm "rm -rf \$node_dir \n";
		  open(Slurm, ">$job_dir/${tag}_${irun}.slurm") or die("Can not create the Slurm batch script");
		  print Slurm "#!/bin/bash \n";
		  print Slurm "#SBATCH --account=rpp-tanaka-ab \n";
		  print Slurm "#SBATCH --nodes=1 \n";
		  print Slurm "#SBATCH --time=$cput \n";
		  print Slurm "#SBATCH --mem=$mem \n";
		  print Slurm "#SBATCH --job-name=$tag-$irun \n";
		  print Slurm "#SBATCH -o $job_dir/$tag-$irun.slurm.out \n";
		  print Slurm "#SBATCH -e $job_dir/$tag-$irun.slurm.err \n";
		  print Slurm "the_command=\$(cat $job_dir/temp_${irun}.txt) \n";

			print Slurm "IFS=',' read -r -a tokens <<< \"\$the_command\" \n";
			print Slurm "rm -f $job_dir/temp_${irun}.txt \n";
			print Slurm "newarray=() \n";
			print Slurm "numtok=\$\{#tokens[@]\} \n";
			print Slurm "for (( i=0; i<\$\{#tokens[@]\}; i++ )); do \n";
			print Slurm "   if [ \$i == 5 ]; then \n";
			print Slurm "      tag=`eval echo -e \$\{tokens[i]\}` \n";
			print Slurm "      newarray+=\"\\\"\$\{SLURM_TMPDIR\}/${tag}\\\",\" \n";
			print Slurm "   elif [ \$i == \$\[\$\{numtok\} - 1\] ]; then \n";
			print Slurm "      newarray+=\"\$\{tokens[i]\}\" \n";
			print Slurm "   else \n";
			print Slurm "      newarray+=\"\$\{tokens[i]\},\" \n";
			print Slurm "   fi \n";
			print Slurm "done \n";

			print Slurm "cmd=\"\$\{newarray[*]\}\" \n";
			print Slurm "export node_dir=\$SLURM_TMPDIR \n";
			print Slurm "cd $job_dir \n";
			print Slurm "source $softw_dir/setup/setup_at_cedar_root6.sh $softw_dir $fmwk_dir\n";
			print Slurm "eval \"\$cmd\" \n";

			print Slurm "cp -r \$node_dir/* . \n";

			close(Slurm);
			`sbatch $job_dir/${tag}_${irun}.slurm`;
		}
    
		#
		# HTCondor @ RAL
		#
		
		if($resource eq "RAL" || $resource eq "RAL_HTC") {
		  $fullprogram = abs_path(`which $program`);
		  chomp($fullprogram);
		
		  $fmwk_setup_script = "$fmwk_dir/setup/setup_at_cvmfs_root6.sh";
		  $dune_setup_script = "$softw_dir/setup/setup_at_cvmfs_root6.sh";
		
		  $jobname = "${tag}-${par1}-${par2}_${jobID}";
		  $shellfn = "$job_dir/${jobname}.sh";
		
		  open(shell,">".$shellfn);
		  print shell "hostname \n";
		  print shell "date \n";
		  print shell "source $fmwk_setup_script \n";
		  print shell "source $dune_setup_script \n";
		  print shell "$command \n";
		  print shell "date \n";
		  close(shell);
		
		  $default_cnd_options =
		  "Executable               = /bin/bash \n".
		  "initialdir               = $job_dir \n".
		  "Universe                 = vanilla \n".
		  "Getenv                   = False \n".
		  "should_transfer_files    = YES \n".
		  "when_to_transfer_output  = ON_EXIT \n".
		  (ncores > 1 ? "request_cpus             = $ncores \n":"").
		  "\nqueue\n";
		  
		  $cndfn = "$job_dir/${jobname}.condor";
		  open(CND, ">".$cndfn) or die("Cannot create the Condor batch script");
		  print CND "Arguments                = $shellfn \n";
		  print CND "Error                    = ${jobname}.err \n";
		  print CND "Output                   = ${jobname}.out \n";
		  print CND $default_cnd_options;
		  close(CND);
		  system("condor_submit",$cndfn);
		  
		}

		#
		# Lancaster
		#
		if($resource eq "Lancaster") {
		    $fullprogram = `which $program`;
		    $fullprogram = `readlink -m $fullprogram`;
		    $arguments =~ s/\"/\\\"/g;        # All double quotes must be escaped for Condor
		    $arguments =~ s/\'//g;            # and apparently single quotes are unnecessary but break it
		    open(JDL, ">$job_dir/$tag-$irun.jdl") or die("Cannot create the JDL script");
		    print JDL "executable     = $fullprogram \n";
		    print JDL "universe       = vanilla \n";
		    print JDL "arguments      = $arguments \n";
		    print JDL "output         = $job_dir/$tag-$irun.out \n";
		    print JDL "error          = $job_dir/$tag-$irun.err \n";
		    print JDL "log            = $job_dir/$tag-$irun.log \n";
		    print JDL "request_memory = 4000 \n";
		    print JDL "getenv         = True \n";
		    print JDL "should_transfer_files    = YES \n";
		    print JDL "when_to_transfer_output  = ON_EXIT \n";
		    print JDL "queue 1 \n";
		    close(JDL);
		    `condor_submit $job_dir/$tag-$irun.jdl`;
		}

      # IFIC 
    #
    if($resource eq "IFIC") {
        open(PBS, ">$job_dir/$tag-$irun.pbs") or die("Cannot create the PBS batch script");
        print PBS "#!/bin/bash \n";
        print PBS "#PBS -N $tag-$irun \n";
        print PBS "#PBS -l mem=$mem \n";
        print PBS "#PBS -q long \n"; # Max walltime of for long - 24h, in case of 2D fit use long4
        print PBS "#PBS -l nodes=1:ppn=1 \n"; #use only ppn=1 
        print PBS "#PBS -o $job_dir/$tag-$irun.pbs.out \n";
        print PBS "#PBS -e $job_dir/$tag-$irun.pbs.err \n";
        print PBS "cd $job_dir \n";
        print PBS "source $softw_dir/setup/setup_at_cvmfs_root6.sh $softw_dir $fmwk_dir\n";
        print PBS "$command \n";
        close(PBS);
        `qsub $job_dir/$tag-$irun.pbs`;
    }

		#
		# interactive
		#
		if($resource eq "interactive") {
			system($command);
		}

	  $irun++;
	  $jobID++;

  } # freepar 0
  
} # freepar 1
