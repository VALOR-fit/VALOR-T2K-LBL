#!/usr/bin/perl

#
#---------------------------------------------------------------------------------------------------------------------------- 
# Submit a batch of run_fit_xml.C jobs
#
# Inputs
#  --resource               : Computer resource, <RAL, Oxford, Grid, interactive>. Default: "interactive"
#  --tag                    : Tag for output files. Default: "toyexptfits"
#  --nruns                  : Number of runs (jobs). Default: 1.
#  --nexpts                 : Number of experiments to fit. Default: 1.
#  --first-expt             : ID of first toy MC expt to fit in first job
#  --cpu-time               : default: "6:00:00" for RAL, "11:50:00" for Oxford
#  --fit-param-list         : Fit parameter list. Default: "nuosc3f_numudisapp_fix4+nuisance". See FitParamList.h for allowed options.
#  --fit-option             : Option passed to fitter. Default: "minuit".
#  --toy-expts-file         : XML file with toy MC experiments (including full path)
#  --store-toy-expts        : Store the generated toy MC expts? Default: No.                                
#  --store-bestfit-spectra  : Store the best-fit spectra? Default: No.               
#  --config-file            : Analysis configuration file from the config/ directory, default: "analysis_configuration.xml"
#  --job-dir                : Directory for job scripts and outputs, default: `pwd`
#  --softw-dir              : Oscillation code top-level directory, default: `pwd`
#  --grid-local-dir         :
#  --proxy-id               : Id used to delegate the proxy
#  --gridpath               :
#  --dmsq-scheme            : abs23 or fogli
#  --hierarchy              : normal or inverted
#  --mix-param-choice       : sinsq2theta or sinsqtheta
#  --mix-param-octant       : one or two
#  --dcp-value              : Number of pi to use as value of deltacp (when deltacp is not fit for). Default 0.
#  --rethrow-unphysical     : Check toys are physical and rethrow if not. Default true.
#
# C.Andreopoulos
#---------------------------------------------------------------------------------------------------------------------------- 
#

use File::Path;

$iarg=0;
foreach (@ARGV) {
  if($iarg % 2 == 1) {$iarg++; next;}
    
  if   ($_ eq '--resource'               ) { $resource              = $ARGV[$iarg+1]; }
  elsif($_ eq '--tag'                    ) { $tag                   = $ARGV[$iarg+1]; }
  elsif($_ eq '--nruns'                  ) { $nruns                 = $ARGV[$iarg+1]; }
  elsif($_ eq '--firstexpt'              ) { $firstexpt             = $ARGV[$iarg+1]; }
  elsif($_ eq '--lastexpt'               ) { $lastexpt              = $ARGV[$iarg+1]; }
  elsif($_ eq '--xml-file'               ) { $xmlfile               = $ARGV[$iarg+1]; }
  elsif($_ eq '--use-xml-file'           ) { $using_xml_file        = $ARGV[$iarg+1]; }
  elsif($_ eq '--dotoys'                 ) { $dotoys                = $ARGV[$iarg+1]; }

  elsif($_ eq '--input-mixing12'         ) { $input_mixing12        = $ARGV[$iarg+1]; }
  elsif($_ eq '--input-mixing13'         ) { $input_mixing13        = $ARGV[$iarg+1]; }
  elsif($_ eq '--input-mixing23'         ) { $input_mixing23        = $ARGV[$iarg+1]; }
  elsif($_ eq '--input-deltacp'          ) { $input_deltacp         = $ARGV[$iarg+1]; }
  elsif($_ eq '--input-dm12sq'           ) { $input_dm12sq          = $ARGV[$iarg+1]; }
  elsif($_ eq '--input-dm23sq'           ) { $input_dm23sq          = $ARGV[$iarg+1]; }
  elsif($_ eq '--input-mixing12-bar'     ) { $input_mixing12_bar    = $ARGV[$iarg+1]; }
  elsif($_ eq '--input-mixing13-bar'     ) { $input_mixing13_bar    = $ARGV[$iarg+1]; }
  elsif($_ eq '--input-mixing23-bar'     ) { $input_mixing23_bar    = $ARGV[$iarg+1]; }
  elsif($_ eq '--input-deltacp-bar'      ) { $input_deltacp_bar     = $ARGV[$iarg+1]; }
  elsif($_ eq '--input-dm12sq-bar'       ) { $input_dm12sq_bar      = $ARGV[$iarg+1]; }
  elsif($_ eq '--input-dm23sq-bar'       ) { $input_dm23sq_bar      = $ARGV[$iarg+1]; }

  elsif($_ eq '--config-file'            ) { $config_file           = $ARGV[$iarg+1]; }

  elsif($_ eq '--stat-fluctuations'      ) { $stat_fluctuations     = $ARGV[$iarg+1]; }
  elsif($_ eq '--tweak-systematics'      ) { $tweak_systematics     = $ARGV[$iarg+1]; }
  elsif($_ eq '--fit-param-list'         ) { $fitparamlist          = $ARGV[$iarg+1]; }
  elsif($_ eq '--fit-option'             ) { $fitoption             = $ARGV[$iarg+1]; }
  elsif($_ eq '--store-toy-expts'        ) { $store_toy_expts       = $ARGV[$iarg+1]; }
  elsif($_ eq '--store-bestfit-spectra'  ) { $store_bestfit_spectra = $ARGV[$iarg+1]; }
  elsif($_ eq '--dmsq-scheme'            ) { $dmsqscheme            = $ARGV[$iarg+1]; }
  elsif($_ eq '--hierarchy'              ) { $masshierarchy         = $ARGV[$iarg+1]; }
  elsif($_ eq '--mix-param-choice'       ) { $mixparamchoice        = $ARGV[$iarg+1]; }
  elsif($_ eq '--mix-param-octant'       ) { $mixparamoctant        = $ARGV[$iarg+1]; }
  elsif($_ eq '--dcp-value'              ) { $dcp_value             = $ARGV[$iarg+1]; }
  elsif($_ eq '--reactor'                ) { $reactor               = $ARGV[$iarg+1]; }
  elsif($_ eq '--tolerance'              ) { $tolerance             = $ARGV[$iarg+1]; }
  elsif($_ eq '--optfixparams'           ) { $optfixparams          = $ARGV[$iarg+1]; }
  elsif($_ eq '--rethrow-unphysical'     ) { $rethrow_unphysical    = $ARGV[$iarg+1]; }

  elsif($_ eq '--cpu-time'               ) { $cput                  = $ARGV[$iarg+1]; }
  elsif($_ eq '--job-dir'                ) { $job_dir               = $ARGV[$iarg+1]; }
  elsif($_ eq '--softw-dir'              ) { $softw_dir             = $ARGV[$iarg+1]; }
  elsif($_ eq '--grid-local-dir'         ) { $grid_local_dir        = $ARGV[$iarg+1]; }
  elsif($_ eq '--proxy-id'               ) { $proxy_id              = $ARGV[$iarg+1]; }
  elsif($_ eq '--gridpath'               ) { $gridpath              = $ARGV[$iarg+1]; }
  
  else {
    print "Unrecognised argument ".$_."\n"; exit;
  }
  $iarg++;
  
}

#die("Please specify a toy experiment file using --toy-expts-file") unless defined $toyexptsfile;

$resource               = "interactive"                        unless defined $resource;
$tag                    = "toyexptfits"                        unless defined $tag;

# when reading xml file: only firstexpt and lastexpt are used (index of the xml file)
# when making toys and fit together $nexpts = $lastexpt-$firstexpt + 1 (for each jobs)
# and $nruns is the number of jobs
 
$nruns                  = 200                                 unless defined $nruns;
$firstexpt              = 0                                   unless defined $firstexpt;
$lastexpt               = 20                                  unless defined $lastexpt; 

$xmlfile                = "toymc/Asimov/toymc_Asimov_T2Konly_NH-0.xml"                  unless defined $xmlfile;
$using_xml_file         = 0                                    unless defined $using_xml_file;
$dotoys                 = 1                                    unless defined $dotoys;

# joint fit t2k only
#$input_mixing12         = -99                                  unless defined $input_mixing12;
#$input_mixing13         = 0.0422                               unless defined $input_mixing13;
#$input_mixing23         = 0.524                                unless defined $input_mixing23;
#$input_deltacp          = 1.91                                 unless defined $input_deltacp;
#$input_dm12sq           = -99                                  unless defined $input_dm12sq;
#$input_dm23sq           = 2.51E-3                              unless defined $input_dm23sq;
#$input_mixing12_bar     = -99                                  unless defined $input_mixing12_bar;
#$input_mixing13_bar     = 0.0422                               unless defined $input_mixing13_bar;
#$input_mixing23_bar     = 0.524                                unless defined $input_mixing23_bar;
#$input_deltacp_bar      = 1.91                                 unless defined $input_deltacp_bar;
#$input_dm12sq_bar       = -99                                  unless defined $input_dm12sq_bar;
#$input_dm23sq_bar       = 2.51E-3                              unless defined $input_dm23sq_bar;

# joint fit w/ reactors
$input_mixing12         = -99                                  unless defined $input_mixing12;
$input_mixing13         = 0.0248                               unless defined $input_mixing13;
$input_mixing23         = 0.527                                unless defined $input_mixing23;
$input_deltacp          = -1.55                                unless defined $input_deltacp;
$input_dm12sq           = -99                                  unless defined $input_dm12sq;
$input_dm23sq           = 2.51E-3                              unless defined $input_dm23sq;

$input_mixing12_bar     = -99                                  unless defined $input_mixing12_bar;
$input_mixing13_bar     = 0.0248                               unless defined $input_mixing13_bar;
$input_mixing23_bar     = 0.527                                unless defined $input_mixing23_bar;
$input_deltacp_bar      = -1.55                                unless defined $input_deltacp_bar;
$input_dm12sq_bar       = -99                                  unless defined $input_dm12sq_bar;
$input_dm23sq_bar       = 2.51E-3                              unless defined $input_dm23sq_bar;
 
#$config_file            = "analysis_configuration_run1to6_test_app.xml"           unless defined $config_file;
#$config_file            = "analysis_configuration_run1to6_test.xml"           unless defined $config_file;
$config_file            = "analysis_configuration_1.7E20.xml"           unless defined $config_file;
#$config_file            = "analysis_configuration_1.7E20_prefit.xml"           unless defined $config_file;
#$config_file            = "analysis_configuration_2.5E20.xml"           unless defined $config_file;
#$config_file            = "analysis_configuration_2.5E20_prefit.xml"           unless defined $config_file;
 
$stat_fluctuations       = 1                                    unless defined $stat_fluctuations;
$tweak_systematics       = 1                                    unless defined $tweak_systematics;

#$fitparamlist           = "nuosc3f_12fix+nuisance"         unless defined $fitparamlist;
#$fitparamlist           = "nuosc3f_12fix"                    unless defined $fitparamlist;
#$fitparamlist           = "nuosc3fbar_fixnonbar_12fix"       unless defined $fitparamlist;
#$fitparamlist           = "nuosc3fbar_fixnonbar_12fix+nuisance"       unless defined $fitparamlist;
#$fitparamlist           = "nuosc3fbar_fixnonbar_fix5"       unless defined $fitparamlist;
#$fitparamlist           = "nuosc3fbar_fixnonbar_fix5+nuisance"       unless defined $fitparamlist;
$fitparamlist           = "nuosc3fbar_numudisapp_fixnonbar_fix4"       unless defined $fitparamlist;
#$fitparamlist           = "nuosc3fbar_numudisapp_fixnonbar_fix4+nuisance"       unless defined $fitparamlist;

#$fitoption              = "minuit"                               unless defined $fitoption;
$fitoption              = "minuit+hesse"                               unless defined $fitoption;
#$fitoption              = "minuit+minos"                               unless defined $fitoption;

$store_toy_expts        = 1                                      unless defined $store_toy_expts;
$store_bestfit_spectra  = 0                                      unless defined $store_bestfit_spectra;

$dmsqscheme             = "abs23"                                unless defined $dmsqscheme;
$masshierarchy          = "normal"                               unless defined $masshierarchy;
$mixparamchoice         = "sinsqtheta"                           unless defined $mixparamchoice;
$mixparamoctant         = "one"                                  unless defined $mixparamoctant;
$dcp_value              = 0                                      unless defined $dcp_value;
$reactor                = 0                                      unless defined $reactor;
$tolerance              = 0.01                                   unless defined $tolerance;
$rethrow_unphysical     = true                                   unless defined $rethrow_unphysical;
$gof_binning            = false                                   unless defined $gof_binning;
#$optfixparams            = "mixing23,dmsq32,dmsq12,mixing13,mixing12"      unless defined $optfixparams;  # list of the params to be fixed in the fit   
#$optfixparams            = "mixing23,dmsq32,dmsq12,mixing13,mixing12,deltacp"      unless defined $optfixparams;  # list of the params to be fixed in the fit   
$optfixparams            = "dmsq12,mixing12,deltacp,mixing13"    unless defined $optfixparams;  # list of the params to be fixed in the fit   

$softw_dir              = $ENV{'T2KOSCANA'}                    unless defined $softw_dir;
$job_dir                = `pwd`                                unless defined $job_dir;
$proxy_id               = "valor"                              unless defined $proxy_id;
$grid_local_dir         = `pwd`                                unless defined $grid_local_dir;

if( !defined $cput) {
  if($resource eq "RAL"   ) { $cput = "6:00:00";  }
  if($resource eq "Oxford") { $cput = "11:50:00"; }
}

print "$job_dir";
mkpath ($job_dir, {verbose => 1, mode=>0777}); 
die("$job_dir doesn't exist") unless -d $job_dir;


$irun  = 0;
$nexpts = $lastexpt - $firstexpt + 1; # total number of toys 
$first = $firstexpt;
$last  = $lastexpt;

while($irun < $nruns) {

  print "Submitting run: $irun \n";

  $batch_script  = "$tag-$irun.pbs";
  $job_name      = "$tag-$irun";

  if( $resource eq "Grid") { $macro_dir = "\$T2KOSCANA"; }
  else                     { $macro_dir = $softw_dir;    }

  $program = "root2k ";
  $arguments = "-q -l -b \'$macro_dir/macros/fit/run_fit_xml_toys_joint_bar.C(\"$tag\",$irun,$first,$last,\"$xmlfile\",$using_xml_file,$dotoys,$input_mixing12,$input_mixing13,$input_mixing23,$input_deltacp,$input_dm12sq,$input_dm23sq,$input_mixing12_bar,$input_mixing13_bar,$input_mixing23_bar,$input_deltacp_bar,$input_dm12sq_bar,$input_dm23sq_bar,\"$config_file\",$stat_fluctuations,$tweak_systematics,\"$fitparamlist\",\"$fitoption\",$store_toy_expts,$store_bestfit_spectra,\"$dmsqscheme\",\"$masshierarchy\",\"$mixparamchoice\",\"$mixparamoctant\",$dcp_value,$reactor,$tolerance,\"$optfixparams\",$rethrow_unphysical,$gof_binning)\'";
  $command = "$program $arguments";
  
  
  print "$command \n";

  #die("ciao");

  $first = $last  + 1;
  $last  = $first + $nexpts - 1;

  $ijob=$ijob+1;

  #
  # ETH (Monch cluster), $job_dir not used, $tag gives path/name of output file
  #
  if($resource eq "ETH-Monch") {
      open(PBS, ">/mnt/lnec/davides/VALOR/sbatch_files/run_fit-$irun.sbatch") or die("Can not create the sbatch script");
      print PBS "#!/bin/bash -l  \n";
      #print PBS "#SBATCH --partition=dphys_compute_wk  \n";
      print PBS "#SBATCH --partition=dphys_compute  \n";
      #print PBS "#SBATCH --partition=dphys_largemem  \n";
      print PBS "#SBATCH --nodes=1  \n";
      print PBS "#SBATCH --ntasks-per-node=1  \n";
      print PBS "#SBATCH --output=/mnt/lnec/davides/VALOR/outputs/out.%j.o  \n";
      print PBS "#SBATCH --error=/mnt/lnec/davides/VALOR/outputs/out.%j.e  \n";
      print PBS "$command \n";
      close(PBS);
      #`sbatch -t 23:59:00 /mnt/lnec/davides/VALOR/sbatch_files/run_fit-$irun.sbatch`;
      #`sbatch -t 2-00:00:00 /mnt/lnec/davides/VALOR/sbatch_files/run_fit-$irun.sbatch`;
      `sbatch -t 00:59:00 /mnt/lnec/davides/VALOR/sbatch_files/run_fit-$irun.sbatch`;
      #`sbatch -t 00:05:00 /mnt/lnec/davides/VALOR/sbatch_files/run_fit-$irun.sbatch`;
  }
  
  #
  # ETH (Brutus cluster)
  #
  if($resource eq "ETH-Brutus") {
      open(PBS, ">$job_dir/$tag-$ijob.sh") or die("Can not create the PBS batch script");
      print PBS "#!/bin/bash \n";
      #print PBS "#PBS -N $tag-$irun \n";
      #print PBS "#PBS -l cput=$cput \n";
      #print PBS "#PBS -o $job_dir/$tag-$irun.pbs.out \n";
      #print PBS "#PBS -e $job_dir/$tag-$irun.pbs.err \n";
      #print PBS "#PBS -q prod \n";
      #print PBS "#PBS -l walltime=$cput \n";
      #print PBS "cd $job_dir \n";
      #print PBS "source $softw_dir/setup/setup_at_ral.sh $softw_dir\n";
      print PBS "$command \n";
      close(PBS);
      `bsub -W 3:59 < $job_dir/$tag-$ijob.sh`;
      #`bsub -W 1:59 < $job_dir/$tag-$ijob.sh`;
      #`bsub -W 0:29 < $job_dir/$tag-$ijob.sh`;
  }
  
  #
  # RAL
  #
  if($resource eq "RAL") {
     $fullprogram = `which root2k`;
     $fullprogram = `readlink -m $fullprogram`;
     $arguments =~ s/\"/\\\"/g;        # All double quotes must be escaped for Condor
     $arguments =~ s/\'//g;            # and apparently single quotes are unnecessary but break it
     open(CND, ">$job_dir/$tag-$ijob.condor") or die("Cannot create the Condor batch script");
     print CND "Executable               = $fullprogram \n";
     print CND "Arguments                = $arguments \n";
     print CND "Error                    = $job_dir/toys_proc_$tag-${ijob}_\$\(Process\).err \n";
     print CND "Output                   = $job_dir/toys_proc_$tag-${ijob}_\$\(Process\).out \n";
     print CND "Universe                 = vanilla \n";
     print CND "Getenv                   = True \n";
     print CND "should_transfer_files    = YES \n";
     print CND "when_to_transfer_output  = ON_EXIT \n";
     print CND "\nqueue\n";
     
     close(CND);
     `condor_submit $job_dir/$tag-$ijob.condor`;
  }
  
  #
  # RAL (SL5 system)
  #
  if($resource eq "OLDRAL") {
     open(PBS, ">$job_dir/$batch_script") or die("Can not create the PBS batch script");
     print PBS "#!/bin/bash \n";
     print PBS "#PBS -N $job_name \n";
     print PBS "#PBS -l cput=$cput \n";
     print PBS "#PBS -l walltime=$cput \n";
     print PBS "#PBS -o $job_dir/$tag-$irun.pbs.out \n";
     print PBS "#PBS -e $job_dir/$tag-$irun.pbs.err \n";
     print PBS "cd $job_dir \n";
     print PBS "source $softw_dir/setup/setup_at_ral.sh $softw_dir \n";
     print PBS "$command \n";
     close(PBS);
     `qsub -q prod $job_dir/$batch_script`;
  }
  #
  # Oxford
  #
  if($resource eq "Oxford") {
      open(PBS, ">$job_dir/$batch_script") or die("Can not create the PBS batch script");
      print PBS "#!/bin/bash \n";
      print PBS "#PBS -N $job_name \n";
      print PBS "#PBS -l cput=$cput \n";
      print PBS "#PBS -o $job_dir/$tag-$irun.pbs.out \n";
      print PBS "#PBS -e $job_dir/$tag-$irun.pbs.err \n";
      print PBS "cd $job_dir \n";
      print PBS "source $softw_dir/setup/setup_at_oxford.sh $softw_dir \n";
      print PBS "$command \n";
      close(PBS);
     `qsub $job_dir/$batch_script`;
  }
  #
  # CONDOR at Lancs
  #
  if($resource eq "LancsCondor") {
      $fullprogram = `which root2k`;
      $fullprogram = `readlink -m $fullprogram`;
      $arguments =~ s/\"/\\\"/g;        # All double quotes must be escaped for Condor
      $arguments =~ s/\'//g;            # and apparently single quotes are unnecessary but break it
      open(CND, ">$job_dir/$tag-$ijob.condor") or die("Cannot create the Condor batch script");
      print CND "Executable               = $fullprogram \n";
      print CND "Arguments                = $arguments \n";
      print CND "Error                    = $job_dir/toys_proc_$tag-${ijob}_\$\(Process\).err \n";
      print CND "Output                   = $job_dir/toys_proc_$tag-${ijob}_\$\(Process\).out \n";
      print CND "Universe                 = vanilla \n";
      print CND "Getenv                   = True \n";
      print CND "should_transfer_files    = YES \n";
      print CND "when_to_transfer_output  = ON_EXIT \n";
      print CND "\nqueue\n";
     
      close(CND);
      `condor_submit $job_dir/$tag-$ijob.condor`;
  }
  #
  # Grid
  #
  if($resource eq "Grid") {
    die("gridpath isn't specified") unless defined $gridpath;
    # First write the JDL file
    open(JDL, ">$tag-$irun.jdl") or die("Can not create the JDL script");
    print JDL "Executable = \"$tag-$irun.sh\"; \n";
    print JDL "StdOutput = \"$tag-$irun.out\"; \n";
    print JDL "StdError = \"$tag-$irun.err\"; \n";
    print JDL "InputSandbox = {\"$tag-$irun.sh\"}; \n";
    print JDL "OutputSandbox = {\"$tag-$irun.out\",\"$tag-$irun.err\",\"$tag-$irun.root\"}; \n";
    print JDL "VirtualOrganisation = \"t2k.org\"; \n";
    print JDL "Requirements = other.GlueCEInfoHostName == \"heplnx206.pp.rl.ac.uk\" || other.GlueCEInfoHostName == \"heplnx207.pp.rl.ac.uk\" || other.GlueCEInfoHostName == \"heplnx208.pp.rl.ac.uk\"; \n";
    
    # Then write the executable for the JDL file
    open(SH, ">$tag-$irun.sh") or die("Can not create the .sh batch script");
    print SH "#!/bin/bash \n";
    print SH "# time as a UNIX timestamp \n" ;                                                                                                                                  
    print SH "T0=\"\$\(date +\%s)\"\n";
    print SH "# setup env vars \n";                                                                                                                                                               
    print SH "export LFC_HOST=lfc.gridpp.rl.ac.uk\n";
    print SH "export GLOBUS_FTP_CLIENT_GRIDFTP2=true\n";
    print SH "# trap error and remove code if error happens \n";
    print SH "P=\$PWD \n";
    print SH "echo \"*** Setting up environmental variables...\" \n";
    print SH "source $softw_dir/setup/setup_at_ral.sh $softw_dir \n";
    print SH "cd $grid_local_dir \n";
    print SH "echo \"*** Running the macro...\"\n";
    print SH "$command\n";
    print SH "# try to handle failure of the macro (exit \!= 0)\n";
    print SH "if \[ \"\$\?\" \= \"0\" \]; then\n";
    print SH "       lcg-cr -v --vo t2k.org file:./mockfit_$irun.root -l lfn:/grid/t2k.org/nd280/contrib/dealtry/$gridpath/mockfit_$irun.root -d srm://srm-t2k.gridpp.rl.ac.uk/castor/ads.rl.ac.uk/prod/t2k.org/nd280/contrib/dealtry/$gridpath/mockfit_$irun.root \n";
    print SH "       lcg-cr -v --vo t2k.org file:./$tag-run_$irun-expts_$irun_$irun.root -l lfn:/grid/t2k.org/nd280/contrib/dealtry/$gridpath/$tag-run_$irun-expts_$irun_$irun.root -d srm://srm-t2k.gridpp.rl.ac.uk/castor/ads.rl.ac.uk/prod/t2k.org/nd280/contrib/dealtry/$gridpath/$tag-run_$irun-expts_$irun_$irun.root \n";
    print SH "       echo \"*** Total time: \$\{T\}\"\n";
    print SH "       echo Done!\n";
    print SH "else\n";
    print SH "       echo Error happened!!!\n";
    print SH "       T=\"\$\(\(\$\(date +\%s\)-T0\)\)\"\n";
    print SH "       echo \"*** Total time: \$\{T\}\"\n";
    print SH "       exit\n";
    print SH "fi\n";
    print SH "#echo Done!\n";
  }

  #
  # interactive
  #
  if($resource eq "interactive") {
     system($command);
  }

  $irun++;
}

if($resource eq "Grid") {
  # Finally write the sh bash script to handle the job submission
  open(SH0, ">$tag.sh") or die("Can not create the .sh batch script");
  print SH0 "#!/bin/bash \n";
  print SH0 "echo \"*** Creating proxy...\" \n";
  print SH0 "voms-proxy-init -valid 100:0 -voms t2k.org \n";
  print SH0 "echo \"*** Submitting jobs to the GRID...\" \n";
  $irun = 0;
  while($irun < $nruns) {
    print SH0 "glite-wms-job-submit -a -c $softw_dir/production/grid/autowms.conf -o $tag.jid $tag-$irun.jdl\n";
    $irun++;
  }
  `chmod +x $tag.sh`;
  #`./$tag.sh`;
}
