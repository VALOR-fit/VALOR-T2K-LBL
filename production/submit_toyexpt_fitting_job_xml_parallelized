#!/usr/bin/perl

#
#-----------------------------------------------------------------------------------------------------------------------------
# Submit a batch of test_n_mock_data_fits_xml_parallelized.C jobs
#
# Inputs
#  --resource               : <RAL, IN2P3, Oxford, Grid, interactive>. Default: "interactive".
#  --tag                    :
#  --run                    : Default: 0
#  --expt-file              : XML file with expts
#  --nexpt                  : Experiment ID in input xml file
#  --cpu-time               : Default: "6:00:00" for RAL, "1500000" for IN2P3, "11:50:00" for Oxford.
#  --min-dm23sq-bin         : Default:   1.
#  --max-dm23sq-bin         : Default:  51.
#  --min-sinsq2theta23-bin  : Default:   1.
#  --max-sinsq2theta23-bin  : Default: 101.
#  --fit-param-list         : Fit parameter list. Default: "nuosc3f_numudisapp_fix4". See FitParamList.h for allowed options.
#  --fit-option             : Option passed to fitter. Default: "minuit".
#  --job-dir                : Directory for job scripts and outputs. Default: `pwd`.
#  --softw-dir              : Oscillation code top-level directory. Default: `pwd`.
#  --config-file            : Analysis configuration file from the config/ directory. Default: "analysis_configuration.xml".
#
# C.Andreopoulos
#----------------------------------------------------------------------------------------------------------------------------- 
#

use File::Path;

$iarg=0;
foreach (@ARGV) {
  if($_ eq '--resource'              ) { $resource              = $ARGV[$iarg+1]; }
  if($_ eq '--tag'                   ) { $tag                   = $ARGV[$iarg+1]; }
  if($_ eq '--run'                   ) { $run                   = $ARGV[$iarg+1]; }
  if($_ eq '--expt-file'             ) { $exptfile              = $ARGV[$iarg+1]; }
  if($_ eq '--nexpt'                 ) { $nexpt                 = $ARGV[$iarg+1]; }
  if($_ eq '--cpu-time'              ) { $cput                  = $ARGV[$iarg+1]; }
  if($_ eq '--min-dm23sq-bin'        ) { $min_dm23sq_bin        = $ARGV[$iarg+1]; }
  if($_ eq '--max-dm23sq-bin'        ) { $max_dm23sq_bin        = $ARGV[$iarg+1]; }
  if($_ eq '--min-sinsq2theta23-bin' ) { $min_sinsq2theta23_bin = $ARGV[$iarg+1]; }
  if($_ eq '--max-sinsq2theta23-bin' ) { $max_sinsq2theta23_bin = $ARGV[$iarg+1]; }
  if($_ eq '--fit-param-list'        ) { $fitparamlist          = $ARGV[$iarg+1]; }
  if($_ eq '--fit-option'            ) { $fitoption             = $ARGV[$iarg+1]; }
  if($_ eq '--job-dir'               ) { $job_dir               = $ARGV[$iarg+1]; }
  if($_ eq '--softw-dir'             ) { $softw_dir             = $ARGV[$iarg+1]; }
  if($_ eq '--config-file'           ) { $config_file           = $ARGV[$iarg+1]; }
  if($_ eq '--no-chisq-surface'      ) { $chisq2D               = 0;              }
  if($_ eq '--1Dchisq-mixing'        ) { $chisq1D_mix           = 1;              }
  if($_ eq '--1Dchisq-dm23sq'        ) { $chisq1D_dm            = 1;              }
  if($_ eq '--dm23sq-step'           ) { $dm23sq_step           = $ARGV[$iarg+1]; }
  if($_ eq '--mixing-step'           ) { $mixing_step           = $ARGV[$iarg+1]; }
  if($_ eq '--dm23sq-min'            ) { $dm23sq_min            = $ARGV[$iarg+1]; }
  if($_ eq '--mixing-min'            ) { $mixing_min            = $ARGV[$iarg+1]; }
  if($_ eq '--dm23sq-max'            ) { $dm23sq_max            = $ARGV[$iarg+1]; }
  if($_ eq '--mixing-max'            ) { $mixing_max            = $ARGV[$iarg+1]; }
  if($_ eq '--mixing-mode'           ) { $mixingmode            = $ARGV[$iarg+1]; }
  if($_ eq '--hierarchy-mode'        ) { $hierarchy             = $ARGV[$iarg+1]; }
  $iarg++;
}
$min_dm23sq_bin         = 1                             unless defined $min_dm23sq_bin;
$max_dm23sq_bin         = 41                            unless defined $max_dm23sq_bin; 
$min_sinsq2theta23_bin  = 32                            unless defined $min_sinsq2theta23_bin;
$max_sinsq2theta23_bin  = 32                           unless defined $max_sinsq2theta23_bin;
$resource               = "interactive"                 unless defined $resource;
$tag                    = "chisqsurf"                   unless defined $tag;
$run                    = 0                             unless defined $run;
$fitparamlist           = "nuosc3f_numudisapp_fix4+nuisance"     unless defined $fitparamlist;
$fitoption              = "minuit"                      unless defined $fitoption;
$job_dir                = `pwd`                         unless defined $job_dir;
$softw_dir              = `pwd`                         unless defined $softw_dir;
$config_file            = "analysis_configuration.xml"  unless defined $config_file;
$chisq2D                = 1                             unless defined $chisq2D;
$chisq1D_mix            = 0                             unless defined $chisq1D_mix;
$chisq1D_dm             = 0                             unless defined $chisq1D_dm;
$dm23sq_step            = 0.05E-3                       unless defined $dm23sq_step;
$mixing_step            = 0.005                         unless defined $mixing_step;
$dm23sq_min             = 1.5E-3                        unless defined $dm23sq_min;
$mixing_min             = 0.85                          unless defined $mixing_min;
$dm23sq_max             = 3.5E-3                        unless defined $dm23sq_max;
$mixing_max             = 1.000                         unless defined $mixing_max;
$mixingmode             = "2theta"                      unless defined $mixingmode;
$hierarchy              = "normal"                      unless defined $hierarchy;

die unless defined $exptfile;
die unless defined $nexpt;

if( !defined $cput) {
  if($resource eq "RAL"   ) { $cput = "6:00:00";  }
  if($resource eq "IN2P3" ) { $cput = 1500000;    }
  if($resource eq "Oxford") { $cput = "11:50:00"; }
}

mkpath ($job_dir, {verbose => 1, mode=>0777});
die("$job_dir doesn't exist") unless -d $job_dir;

if( $resource eq "Grid") { $macro_dir = "./";       }
else                     { $macro_dir = $softw_dir; }

for($mix23bin = $min_sinsq2theta23_bin; $mix23bin <= $max_sinsq2theta23_bin; $mix23bin++){
 for($dm23sqbin = $min_dm23sq_bin; $dm23sqbin <= $max_dm23sq_bin; $dm23sqbin++){

  print "Submitting $tag job for mix23 bin: $mix23bin and dm23sq bin: $dm23sqbin \n";

  $command  = "root2k -l -b -q \'$macro_dir/macros/fit/toymc/test_n_mock_data_fits_xml_parallelized.C(\"$tag\",$run,\"$exptfile\",$nexpt,$nexpt,\"$config_file\",\"$fitparamlist\",\"$fitoption\",\"\",$mix23bin,$dm23sqbin,$chisq2D,$mixing_min,$mixing_max,$dm23sq_min,$dm23sq_max,$chisq1D_mix,$mixing_step,$chisq1D_dm,$dm23sq_step,\"$mixingmode\",\"$hierarchy\")\'";
  print "$command \n";

  #
  # RAL
  #
  if($resource eq "RAL") {
     open(PBS, ">$job_dir/$tag-$nexpt-$mix23bin-$dm23sqbin.pbs") or die("Can not create the PBS batch script");
     print PBS "#!/bin/bash \n";
     print PBS "#PBS -N $tag-$nexpt-$mix23bin-$dm23sqbin \n";
     print PBS "#PBS -l walltime=$cput \n";
     print PBS "#PBS -l cput=$cput \n";
     print PBS "#PBS -o $job_dir/$tag-$nexpt-$mix23bin-$dm23sqbin.pbs.out \n";
     print PBS "#PBS -e $job_dir/$tag-$nexpt-$mix23bin-$dm23sqbin.pbs.err \n";
     print PBS "cd $job_dir/ \n";
     print PBS "source $softw_dir/setup/setup_at_ral.sh $softw_dir\n";
     print PBS "$command \n";
     close(PBS);
     `qsub -q prod $job_dir/$tag-$nexpt-$mix23bin-$dm23sqbin.pbs`;
  }
  #
  # IN2P3
  #
  if($resource eq "IN2P3") {
  }
  #
  # Oxford
  #
  if($resource eq "Oxford") {
      open(PBS, ">$job_dir/$tag-$nexpt-$mix23bin-$dm23sqbin.pbs") or die("Can not create the PBS batch script");
      print PBS "#!/bin/bash \n";
      print PBS "#PBS -N $tag-$nexpt-$mix23bin-$dm23sqbin \n";
      print PBS "#PBS -l cput=$cput \n";
      print PBS "#PBS -o $job_dir/$tag-$nexpt-$mix23bin-$dm23sqbin.pbs.out \n";
      print PBS "#PBS -e $job_dir/$tag-$nexpt-$mix23bin-$dm23sqbin.pbs.err \n";
      print PBS "cd $job_dir/ \n";
      print PBS "source $softw_dir/setup/setup_at_oxford.sh $softw_dir\n";
      print PBS "$command \n";
      close(PBS);
     `qsub $job_dir/$tag-$nexpt-$mix23bin-$dm23sqbin.pbs`;
  }
