  # Grid
  #
  if($resource eq "Grid") {
      # First write the JDL file
      open(JDL, ">$tag-$nexpt-$mix23bin-$dm23sqbin.jdl") or die("Can not create the JDL script");
      print JDL "Executable = \"$tag-$nexpt-$mix23bin-$dm23sqbin.sh\"; \n";
      print JDL "StdOutput = \"$tag-$nexpt-$mix23bin-$dm23sqbin.out\"; \n";
      print JDL "StdError = \"$tag-$nexpt-$mix23bin-$dm23sqbin.err\"; \n";
      print JDL "InputSandbox = {\"$tag-$nexpt-$mix23bin-$dm23sqbin.sh\",\"trunk_GRID.tar.gz\"}; \n";
      print JDL "OutputSandbox = {\"$tag-$nexpt-$mix23bin-$dm23sqbin.out\",\"$tag-$nexpt-$mix23bin-$dm23sqbin.err\",\"$tag-$nexpt-$mix23bin-$dm23sqbin.root\"}; \n";
      print JDL "VirtualOrganisation = \"t2k.org\"; \n";
      #print JDL "Requirements = RegExp(\"ic.ac.uk\", other.GlueCEUniqueId); \n";
      print JDL "Requirements = Member(\"VO-t2k.org-ND280-v10r11p17\",other.GlueHostApplicationSoftwareRunTimeEnvironment) && other.GlueCEPolicyMaxCPUTime > 600; \n";

      # Then write the executable for the JDL file
      open(SH, ">$tag-$nexpt-$mix23bin-$dm23sqbin.sh") or die("Can not create the .sh batch script");
      print SH "#!/bin/bash \n";
      print SH "# time as a UNIX timestamp \n" ;                                                                                                                                  
      print SH "T0=\"\$\(date +\%s)\"\n";
      print SH "# setup env vars \n";                                                                                                                                                               
      print SH "export LFC_HOST=lfc.gridpp.rl.ac.uk\n";
      print SH "export GLOBUS_FTP_CLIENT_GRIDFTP2=true\n";
      print SH "# trap error and remove code if error happens \n";
      print SH "P=\$PWD \n";
      print SH "#trap \'echo \"*** Error happened!!!\"; cd \$\{P\}; mv trunk_GRID/*.root .;echo \"*** Removing...\"; rm -fr trunk_GRID/; rm -fr trunk_GRID.tar.gz; ls -ltr; echo EXIT; exit\' ERR \n";
      print SH "# create temporal directory \n" ;
      print SH "echo \"*** Untaring code...\" \n";
      print SH "ls -ltr \n";
      print SH "tar xvfz trunk_GRID.tar.gz \n";
      print SH "echo \"*** Copying input files from GRID...\" \n";
      #print SH "lcg-cp -v --vo t2k.org lfn:/grid/t2k.org/contrib/lorena/inputs/data_new.xml file:./trunk_GRID/inputs/data.xml\n";
      #print SH "lcg-cp -v --vo t2k.org lfn:/grid/t2k.org/contrib/lorena/inputs/fakedata.xml file:./trunk_GRID/inputs/fakedata.xml\n";
      #print SH "lcg-cp -v --vo t2k.org lfn:/grid/t2k.org/contrib/lorena/inputs/official/2012/banff/postfit_banff_v8_osc_marg_MAQE.root file:./trunk_GRID/inputs/official/2012/banff/postfit_banff_v8_osc_marg_MAQE.root\n";
      print SH "lcg-cp -v --vo t2k.org lfn:/grid/t2k.org/contrib/lorena/inputs/official/2012/banff/postfit_banff_v8_osc_marg_MAQE_EBfix.root file:./trunk_GRID/inputs/official/2012/banff/postfit_banff_v8_osc_marg_MAQE_EBfix.root\n";
      print SH "lcg-cp -v --vo t2k.org lfn:/grid/t2k.org/contrib/lorena/inputs/official/2012/flux/11b_v3.2_run1-3c/sk_tuned11bv3.2_11anom_run1-run3c_fine.root file:./trunk_GRID/inputs/official/2012/flux/11b_v3.2_run1-3c/sk_tuned11bv3.2_11anom_run1-run3c_fine.root\n";
      print SH "lcg-cp -v --vo t2k.org lfn:/grid/t2k.org/contrib/lorena/inputs/official/2012/fsi/FSIandSIError_ICL_SKDetectorBinning.root file:./trunk_GRID/inputs/official/2012/fsi/FSIandSIError_ICL_SKDetectorBinning.root\n";
      print SH "lcg-cp -v --vo t2k.org lfn:/grid/t2k.org/contrib/lorena/inputs/official/2012/superk/err/sk_ccqe_rc_err_covariance.root file:./trunk_GRID/inputs/official/2012/superk/err/sk_ccqe_rc_err_covariance.root\n";
      print SH "lcg-cp -v --vo t2k.org lfn:/grid/t2k.org/contrib/lorena/inputs/official/2012/xsec/XSecSplinesCoarse2012_coarseEreco.root file:./trunk_GRID/inputs/official/2012/xsec/XSecSplinesCoarse2012_coarseEreco.root\n";
      print SH "lcg-cp -v --vo t2k.org lfn:/grid/t2k.org/contrib/lorena/inputs/official/2012/superk/mc/neut/11c/smallnt_numu_sk11c_flx11bv32fine_r1-3cfull_10acut.root file:./trunk_GRID/inputs/official/2012/superk/mc/neut/11c/smallnt_numu_sk11c_flx11bv32fine_r1-3cfull_10acut.root\n";
      #print SH "lcg-cp -v --vo t2k.org lfn:/grid/t2k.org/contrib/lorena/inputs/official/2012/superk/mc/neut/11c/superk_1ReT_numu.root file:./trunk_GRID/inputs/official/2012/superk/mc/neut/11c/superk_1ReT_numu.root\n";
      #print SH "lcg-cp -v --vo t2k.org lfn:/grid/t2k.org/contrib/lorena/inputs/official/2012/superk/mc/neut/11c/superk_1ReT_numubar.root file:./trunk_GRID/inputs/official/2012/superk/mc/neut/11c/superk_1ReT_numubar.root\n";
      #print SH "lcg-cp -v --vo t2k.org lfn:/grid/t2k.org/contrib/lorena/inputs/official/2012/superk/mc/neut/11c/superk_1ReT_nue.root file:./trunk_GRID/inputs/official/2012/superk/mc/neut/11c/superk_1ReT_nue.root\n";
      #print SH "lcg-cp -v --vo t2k.org lfn:/grid/t2k.org/contrib/lorena/inputs/official/2012/superk/mc/neut/11c/superk_1ReT_nuebar.root file:./trunk_GRID/inputs/official/2012/superk/mc/neut/11c/superk_1ReT_nuebar.root\n";
      #print SH "lcg-cp -v --vo t2k.org lfn:/grid/t2k.org/contrib/lorena/inputs/official/2012/superk/mc/neut/11c/superk_1ReT_nuesig.root file:./trunk_GRID/inputs/official/2012/superk/mc/neut/11c/superk_1ReT_nuesig.root\n";
      print SH "ls -ltr\n";
      print SH "ls -ltr trunk_GRID/\n";
      print SH "ls -ltr trunk_GRID/inputs/\n";
      print SH "ls -ltr trunk_GRID/inputs/*/*/*\n";
      print SH "ls -ltr trunk_GRID/inputs/*/*/*/*\n";
      print SH "ls -ltr trunk_GRID/inputs/*/*/*/*/*/*\n";
      print SH "T1=\"\$\(\(\$\(date +\%s\)-T0\)\)\"\n";
      print SH "echo \"*** Time in seconds for copying input files: \$\{T1\}\" \n";
      print SH "echo \"*** Setting up environmental variables...\" \n";
      print SH "source trunk_GRID/setup_at_grid.sh\n";
      print SH "echo \"*** Compiling the code...\"\n";
      print SH "cd trunk_GRID/\n";
      print SH "ls -ltr \$VO_T2K_ORG_SW_DIR/\n";
      print SH "ls -ltr \$VO_T2K_ORG_SW_DIR/nd280v10r11p17/ROOT/\n";
      print SH "ls -ltr \$VO_T2K_ORG_SW_DIR/nd280v10r11p17/ROOT/v5r30p02n01/\n";
      print SH "ls -ltr \$VO_T2K_ORG_SW_DIR/nd280v10r11p17/ROOT/v5r30p02n01/amd64_linux26/\n";
      print SH "pwd\n";
      print SH "which root\n";
      print SH "make clean\n";
      print SH "make\n";
      print SH "T=\"\$\(\(\$\(date + \%s\)-T0\)\)\"\n";
      print SH "echo \"*** Time to compile in seconds: \$\{T\}\"\n";
      print SH "echo \"*** Running the macro...\"\n";
      print SH "$command\n";
      print SH "# try to handle failure of the macro (exit \!= 0)\n";
      print SH "if \[ \"\$\?\" \= \"0\" \]; then\n";
      print SH "       cd ..\n";
      print SH "       mv trunk_GRID/*.root .\n";
      print SH "       echo \"*** Removing...\"\n";
      print SH "       rm -fr trunk_GRID/\n";
      print SH "       rm -fr trunk_GRID.tar.gz\n";
      print SH "       ls -ltr\n";
      print SH "       T=\"\$\(\(\$\(date +\%s\)-T0\)\)\"\n";
      print SH "       echo \"*** Total time: \$\{T\}\"\n";
      print SH "       echo Done!\n";
      print SH "else\n";
      print SH "       echo Error happened!!!\n";
      print SH "       cd ..\n";
      print SH "       mv trunk_GRID/*.root .\n";
      print SH "       echo \"*** Removing...\"\n";
      print SH "       rm -fr trunk_GRID/\n";
      print SH "       rm -fr trunk_GRID.tar.gz\n";
      print SH "       ls -ltr\n";
      print SH "       T=\"\$\(\(\$\(date +\%s\)-T0\)\)\"\n";
      print SH "       echo \"*** Total time: \$\{T\}\"\n";
      print SH "       exit\n";
      print SH "fi\n";
      print SH "#cd ..\n";
      print SH "#ls -ltr trunk_GRID/      \n";
      print SH "#echo \"*** Copying output file...\"\n";
      print SH "#mv trunk_GRID/*.root .\n";
      print SH "#ls -ltr\n";
      print SH "#echo \"*** Removing...\"\n";
      print SH "#rm -fr trunk_GRID/\n";
      print SH "#rm -fr trunk_GRID.tar.gz\n";
      print SH "#ls -ltr trunk_GRID/\n";
      print SH "#ls -ltr\n";
      print SH "#T=\"\$\(\(\$\(date +\%s\)-T0\)\)\"\n";
      print SH "#echo \"*** Total time: \$\{T\}\"\n";
      print SH "#echo Done!\n";
  }

  #
  # interactive
  #
  if($resource eq "interactive") {
     system($command);
  }

}#bins
}#bins


if($resource eq "Grid") {
    # Finally write the sh bash script to handle the job submission
    open(SH0, ">$tag.sh") or die("Can not create the .sh batch script");
    print SH0 "#!/bin/bash \n";
    print SH0 "echo \"*** Creating proxy...\" \n";
    print SH0 "voms-proxy-init -valid 99:0 -voms t2k.org\n";
    #print SH0 "export MYPROXY_SERVER=lcgrbp01.gridpp.rl.ac.uk\n";
    #print SH0 "myproxy-init -v -d -n -s \$MYPROXY_SERVER\n";
    #print SH0 "glite-wms-job-delegate-proxy -d $proxy_id -e https://lcgwms03.gridpp.rl.ac.uk:7443/glite_wms_wmproxy_server;\n";
    print SH0 "echo \"*** Preparing the code...\" \n";
    print SH0 "rm -fr trunk_GRID \n";
