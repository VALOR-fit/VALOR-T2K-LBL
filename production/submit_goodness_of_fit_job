#!/usr/bin/perl

#
#---------------------------------------------------------------------------------------------------------------------------- 
# Submit a batch of calculate_goodness_of_fit.C jobs
#
# Inputs
#  --resource               : Computer resource, <RAL, IN2P3, Oxford, Grid, interactive>. Default: "interactive"
#  --tag                    : Tag for output files. Default: "toyexptfits"
#  --toy-expts-file         : xml file with dataset in
#  --expt                   : Experiment from xml file to use
#  --data-fit-file          : ROOT file with result of fit_xml_seeded.C
#  --ntoys                  : Number of toys to use to calculate gof. Default 1000
#  --cpu-time               : default: "6:00:00" for RAL, "1500000" for IN2P3, "11:50:00" for Oxford
#  --fit-param-list         : Fit parameter list. Default: "numudisapp2f". See FitParamList.h for allowed options.
#  --fit-option             : Option passed to fitter. Default: "minuit".
#  --toy-expts-file         : XML file with toy MC experiments (including full path)
#  --job-dir                : Directory for job scripts and outputs, default: `pwd`
#  --softw-dir              : Oscillation code top-level directory, default: `pwd`
#  --config-file            : Analysis configuration file from the config/ directory, default: "analysis_configuration.xml"
#  --store-toy-expts        : Store the generated toy MC expts? Default: No.
#  --store-bestfit-spectra  : Store the best-fit spectra? Default: No.
#  --dmsq-scheme            : abs23 or fogli
#  --hierarchy              : normal or inverted
#  --mix-param-choice       : sinsq2theta or sinsqtheta
#  --mix-param-octant       : one or two
#
# C.Andreopoulos
#---------------------------------------------------------------------------------------------------------------------------- 
#

use File::Path;

$iarg=0;
foreach (@ARGV) {
  if($_ eq '--resource'       ) { $resource      = $ARGV[$iarg+1]; }
  if($_ eq '--tag'            ) { $tag           = $ARGV[$iarg+1]; }
  if($_ eq '--expt'           ) { $expt          = $ARGV[$iarg+1]; }
  if($_ eq '--cpu-time'       ) { $cput          = $ARGV[$iarg+1]; }
  if($_ eq '--fit-param-list' ) { $fitparamlist  = $ARGV[$iarg+1]; }
  if($_ eq '--fit-option'     ) { $fitoption     = $ARGV[$iarg+1]; }
  if($_ eq '--toy-expts-file' ) { $toyexptsfile  = $ARGV[$iarg+1]; }
  if($_ eq '--job-dir'        ) { $job_dir       = $ARGV[$iarg+1]; }
  if($_ eq '--softw-dir'      ) { $softw_dir     = $ARGV[$iarg+1]; }
  if($_ eq '--config-file'    ) { $config_file   = $ARGV[$iarg+1]; }
  if($_ eq '--data-fit-file'          ) { $datafit_file          = $ARGV[$iarg+1]; }
  if($_ eq '--ntoys'                  ) { $ntoys                 = $ARGV[$iarg+1]; }
  if($_ eq '--store-toy-expts'        ) { $store_toy_expts       = 1;              }
  if($_ eq '--store-bestfit-spectra'  ) { $store_bestfit_spectra = 1;              }
  if($_ eq '--dmsq-scheme'            ) { $dmsqscheme            = $ARGV[$iarg+1]; }
  if($_ eq '--hierarchy'              ) { $masshierarchy         = $ARGV[$iarg+1]; }
  if($_ eq '--mix-param-choice'       ) { $mixparamchoice        = $ARGV[$iarg+1]; }
  if($_ eq '--mix-param-octant'       ) { $mixparamoctant        = $ARGV[$iarg+1]; }
  #if($_ eq '--allow-2nu-unphysical'   ) { $apply_2nu_boundary    = 0;              }
  $iarg++;
}

die("Please specify a toy experiment file using --toy-expts-file") unless defined $toyexptsfile;

$resource               = "interactive"                          unless defined $resource;
$tag                    = "toyexptfits"                          unless defined $tag;
$ntoys                  = 1000                                   unless defined $ntoys;
$fitparamlist           = "nuosc3f_numudisapp_fix4+nuisance"     unless defined $fitparamlist;
$fitoption              = "minuit"                               unless defined $fitoption;
$job_dir                = `pwd`                                  unless defined $job_dir;
$softw_dir              = `pwd`                                  unless defined $softw_dir;
$config_file            = "analysis_configuration.xml"           unless defined $config_file;
$store_toy_expts        = 0                                      unless defined $store_toy_expts;
$store_bestfit_spectra  = 0                                      unless defined $store_bestfit_spectra;
$dmsqscheme             = "abs23"                                unless defined $dmsqscheme;
$masshierarchy          = "normal"                               unless defined $masshierarchy;
$mixparamchoice         = "sinsqtheta"                           unless defined $mixparamchoice;
$mixparamoctant         = "one"                                  unless defined $mixparamoctant;
#$apply_2nu_boundary     = 1                                      unless defined $apply_2nu_boundary;

if( !defined $cput) {
  if($resource eq "RAL"   ) { $cput = "6:00:00";  }
  if($resource eq "IN2P3" ) { $cput = 1500000;    }
  if($resource eq "Oxford") { $cput = "11:50:00"; }
}

mkpath ($job_dir, {verbose => 1, mode=>0777}); 
die("$job_dir doesn't exist") unless -d $job_dir;

die("$toyexptsfile doesn't exist") unless $toyexptsfile;
die("$expt must be specified") unless $expt;
die("$datafit_file doesn't exist") unless $datafit_file;

$batch_script  = "$tag-$expt.pbs";
$job_name      = "$tag-$expt";

$command = "root2k -l -b -q \'$softw_dir/macros/fit/stat/calculate_goodness_of_fit.C(\"$tag\",\"$datafit_file\",$ntoys,\"$toyexptsfile\",$expt,\"$config_file\",\"$fitparamlist\",\"$fitoption\",$store_toy_expts,$store_bestfit_spectra,\"$dmsqscheme\",\"$masshierarchy\",\"$mixparamchoice\",\"$mixparamoctant\")\'";

print "$command \n";

#
# RAL
#
if($resource eq "RAL") {
  open(PBS, ">$job_dir/$batch_script") or die("Can not create the PBS batch script");
  print PBS "#!/bin/bash \n";
  print PBS "#PBS -N $job_name \n";
  print PBS "#PBS -l cput=$cput \n";
  print PBS "#PBS -l walltime=$cput \n";
  print PBS "#PBS -o $job_dir/$tag-$expt.pbs.out \n";
  print PBS "#PBS -e $job_dir/$tag-$expt.pbs.err \n";
  print PBS "cd $job_dir \n";
  print PBS "source $softw_dir/setup/setup_at_ral.sh $softw_dir \n";
  print PBS "$command \n";
  close(PBS);
  `qsub -q prod $job_dir/$batch_script`;
}
#
# IN2P3
#
if($resource eq "IN2P3") {
  open(PBS, ">$job_dir/$batch_script") or die("Can not create the PBS batch script");
  print PBS "#!/bin/tcsh \n";
  print PBS "cd $job_dir \n";
  print PBS "source $softw_dir/setup/setup_at_in2p3.csh $softw_dir \n";
  print PBS "$command \n";
  close(PBS);
  `chmod +x $job_dir/$batch_script`;
  `qsub -eo -V -l platform=LINUX,t=$cput,M=2200MB,scratch=500MB,u_sps_babar -o $tag-$expt.pbs.out -N $job_name $job_dir/$batch_script`;
}
#
# Oxford
#
if($resource eq "Oxford") {
  open(PBS, ">$job_dir/$batch_script") or die("Can not create the PBS batch script");
  print PBS "#!/bin/bash \n";
  print PBS "#PBS -N $job_name \n";
  print PBS "#PBS -l cput=$cput \n";
  print PBS "#PBS -o $job_dir/$tag-$expt.pbs.out \n";
  print PBS "#PBS -e $job_dir/$tag-$expt.pbs.err \n";
  print PBS "cd $job_dir \n";
  print PBS "source $softw_dir/setup/setup_at_oxford.sh $softw_dir \n";
  print PBS "$command \n";
  close(PBS);
  `qsub $job_dir/$batch_script`;
}
#
# Grid
#
if($resource eq "Grid") {
  print "Not supported just yet!\n";
}
#
# interactive
#
if($resource eq "interactive") {
  system($command);
}
