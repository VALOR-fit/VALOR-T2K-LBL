#!/usr/bin/perl


#-------------------------------------------------------------------------------------------------------------------------------
# Submit a batch of build_marg_toys.C jobs
#
# Inputs
#  --resource               : Computer resource, <ETH-Monch, RAL, Oxford, Grid, interactive>. Default: interactive.
#  --tag                    : Tag for output files.
#  --config-file            : Analysis configuration file from the config/ directory. 
#  --fit-param-list         : Fit parameter list. See FitParamList.h for allowed options.
#  --physparam-freepar      : Free parameter 
#  --nexpts-marg            : Number of toy MC expt for marginalization per free parameter.
#  --npt-freepar            : Number of points of the free parameter to scan
#  --step-freepar           : Step of the free parameter scan

#  --tweak-systematics      : generate marginalization toy MC with randomized systematics 
#  --cpu-time               : Required CPU time. Default: "6:00:00" for RAL, "11:50:00" for Oxford.
#  --job-dir                : Directory for job scripts and outputs. Default: `pwd`.
#  --softw-dir              : Oscillation code top-level directory. Default: `pwd`.
#  --dmsq-scheme            : abs23 or fogli
#  --hierarchy              : normal or inverted
#  --mix-param-choice       : sinsq2theta or sinsqtheta
#  --mix-param-octant       : one or two
#
# D.Sgalaberna
#-------------------------------------------------------------------------------------------------------------------------------
#

use File::Path;

$iarg=0;
foreach (@ARGV) {
  if($iarg % 2 == 1) {$iarg++; next;}
      
  if   ($_ eq '--resource'               ) { $resource              = $ARGV[$iarg+1]; }

  elsif($_ eq '--read-toys'              ) { $read_toys             = $ARGV[$iarg+1]; }
  
  elsif($_ eq '--tag-out'                ) { $tag_out               = $ARGV[$iarg+1]; }
  elsif($_ eq '--tag-in'                 ) { $tag_in                = $ARGV[$iarg+1]; }

  elsif($_ eq '--nfiles'                 ) { $nfiles                = $ARGV[$iarg+1]; }

  elsif($_ eq '--config-file'            ) { $config_file           = $ARGV[$iarg+1]; }
  elsif($_ eq '--fit-param-list'         ) { $fitparamlist          = $ARGV[$iarg+1]; }

  elsif($_ eq '--nexpts-marg'            ) { $nexpts_marg           = $ARGV[$iarg+1]; }

  elsif($_ eq '--freepar0'               ) { $freepar0               = $ARGV[$iarg+1]; }
  elsif($_ eq '--minfreepar0'            ) { $minfreepar0            = $ARGV[$iarg+1]; }
  elsif($_ eq '--maxfreepar0'            ) { $maxfreepar0            = $ARGV[$iarg+1]; }
  elsif($_ eq '--npt-freepar0'           ) { $npt_freepar0           = $ARGV[$iarg+1]; }

  elsif($_ eq '--freepar1'               ) { $freepar1               = $ARGV[$iarg+1]; }
  elsif($_ eq '--minfreepar1'            ) { $minfreepar1            = $ARGV[$iarg+1]; }
  elsif($_ eq '--maxfreepar1'            ) { $maxfreepar1            = $ARGV[$iarg+1]; }
  elsif($_ eq '--npt-freepar1'           ) { $npt_freepar1           = $ARGV[$iarg+1]; }
  
  elsif($_ eq '--step-freepar0'          ) { $step_freepar0          = $ARGV[$iarg+1]; }
  elsif($_ eq '--step-freepar1'          ) { $step_freepar1          = $ARGV[$iarg+1]; }

  elsif($_ eq '--tweak-systematics'      ) { $tweak_systematics     = $ARGV[$iarg+1]; }
  elsif($_ eq '--marginalize-hierarchy'  ) { $marg_hierarchy        = $ARGV[$iarg+1]; }
  elsif($_ eq '--rethrow-unphysical'     ) { $rethrow_unphysical    = $ARGV[$iarg+1]; }

  elsif($_ eq '--cpu-time'               ) { $cput                  = $ARGV[$iarg+1]; }
  elsif($_ eq '--job-dir'                ) { $job_dir               = $ARGV[$iarg+1]; }
  elsif($_ eq '--softw-dir'              ) { $softw_dir             = $ARGV[$iarg+1]; }
  elsif($_ eq '--dmsq-scheme'            ) { $dmsqscheme            = $ARGV[$iarg+1]; }
  elsif($_ eq '--hierarchy'              ) { $masshierarchy         = $ARGV[$iarg+1]; }
  elsif($_ eq '--mix-param-choice'       ) { $mixparamchoice        = $ARGV[$iarg+1]; }
  elsif($_ eq '--mix-param-octant'       ) { $mixparamoctant        = $ARGV[$iarg+1]; }
  
  elsif($_ eq '--xml-file'               ) { $xml_file              = $ARGV[$iarg+1]; }
  
  else {
      print "Unrecognised argument ".$_."\n"; exit;
  }
  $iarg++;
}


$resource        = "interactive"               unless defined     $resource;
$read_toys       = 0                           unless defined     $read_toys;  # Useless: parallelization not needed 

$tag_out         = "ChisqMarg_cluster_partial_2D"   unless defined $tag_out;
$tag_in          = "ciao"                        unless defined $tag_in;  # Useless: parallelization not needed 

#$config_file    = "analysis_configuration_run1to6_test_app.xml"  unless defined $config_file;
#$config_file   = "analysis_configuration_run1to6_test.xml"      unless defined $config_file;
$config_file   = "analysis_configuration_1.7E20.xml"            unless defined $config_file;
#$config_file   = "analysis_configuration_1.7E20_prefit.xml"     unless defined $config_file;
#$config_file   = "analysis_configuration_2.5E20.xml"            unless defined $config_file;
#$config_file   = "analysis_configuration_2.5E20_prefit.xml"     unless defined $config_file;

#$fitparamlist   = "nuosc3f_12fix+nuisance"         unless defined $fitparamlist;
#$fitparamlist   = "nuosc3f_12fix"                    unless defined $fitparamlist;
#$fitparamlist   = "nuosc3fbar_fixnonbar_12fix"       unless defined $fitparamlist;
#$fitparamlist   = "nuosc3fbar_fixnonbar_12fix+nuisance"       unless defined $fitparamlist;
#$fitparamlist    = "nuosc3fbar_fixnonbar_fix5"       unless defined $fitparamlist;
#$fitparamlist   = "nuosc3fbar_fixnonbar_fix5+nuisance"       unless defined $fitparamlist;
#$fitparamlist   = "nuosc3fbar_numudisapp_fixnonbar_fix4"       unless defined $fitparamlist;
$fitparamlist   = "nuosc3fbar_numudisapp_fixnonbar_fix4+nuisance" unless defined $fitparamlist;

$nexpts_marg            = 2                     unless defined $nexpts_marg;    # of toys

$nfiles                 = 1                      unless defined $nfiles;    # Useless: parallelization not needed 

$freepar0               = "mixing23Bar"          unless defined $freepar0;
$minfreepar0            = 0                      unless defined $minfreepar0;     # Minimum free parameter allowed value
$maxfreepar0            = 1                      unless defined $maxfreepar0;     # Maximum free parameter allowed value 
$npt_freepar0           = 21                    unless defined $npt_freepar0;    # of free parameter points to scan

#$freepar1               = ""            unless defined $freepar1;
$freepar1               = "dmsq23Bar"            unless defined $freepar1;
$minfreepar1            = 0.0002                 unless defined $minfreepar1;     # Minimum free parameter allowed value
$maxfreepar1            = 0.02                   unless defined $maxfreepar1;     # Maximum free parameter allowed value 
$npt_freepar1           = 21                    unless defined $npt_freepar1;    # of free parameter points to scan

$step_freepar0          = 2                     unless defined $step_freepar0;   # of points for each job param0
$step_freepar1          = 21                    unless defined $step_freepar1;   # of points for each job param1

$tweak_systematics      = 1                      unless defined $tweak_systematics;
$marg_hierarchy         = 1                      unless defined $marg_hierarchy;
$rethrow_unphysical     = 0                      unless defined $rethrow_unphysical;

$job_dir                = "."                    unless defined $job_dir;
$softw_dir              = $ENV{'T2KOSCANA'}      unless defined $softw_dir;

$dmsqscheme             = "abs23"                unless defined $dmsqscheme;
$masshierarchy          = "normal"               unless defined $masshierarchy;
$mixparamchoice         = "sinsqtheta"           unless defined $mixparamchoice;
$mixparamoctant         = "one"                  unless defined $mixparamoctant;

$using_xml_file = (defined $xml_file ? "true" : "false" );
$xml_file = "" unless defined $xml_file;


if( !defined $cput ) {
    if( ! $read_toys ) {
        #takes approx 0.03 sec per spectra
        $sec = int ( $step_freepar0 *  $step_freepar1 * $nexpts_marg * 0.04 );
        $sec_mins = $sec % 3600;
        $seconds = $sec % 60;
        $minutes = int($sec_mins/60);
        $hours = int($sec/3600);
        
        if($hours > 1){
            $cput = "$hours:$minutes:$seconds";
        }
        else{
            $cput = "01:00:00";
        }
    }
    else{
    if($resource eq "RAL"   ) { $cput = "6:00:00";  }
    if($resource eq "OLDRAL") { $cput = "6:00:00";  }
    if($resource eq "Oxford") { $cput = "11:50:00"; }
    }
}




mkpath ($job_dir, {verbose => 1, mode=>0777}); 
die("$job_dir doesn't exist") unless -d $job_dir;

$fileid=0;

$imin0_p1=0; # param 0
$imin1_p1=0; # param 1

$ijob = 0;

for($imin0 = 0; $imin0 < $npt_freepar0; $imin0 = $imin0_p1) { 
    for($imin1 = 0; $imin1 < $npt_freepar1; $imin1 = $imin1_p1) { 
	
	$imin0_p1 = $imin0 + $step_freepar0;
	$imin1_p1 = $imin1 + $step_freepar1;
    
	$imax0 = $imin0 + $step_freepar0-1;
	$imax1 = $imin1 + $step_freepar1-1;
    
	# if exceed maximum allowed number set it to limit
	if( $imax0 >= $npt_freepar0 ){
	    $imax0 = $npt_freepar0-1; # loop in build_marg_toy is min <= bin <= max
	}
	if( $imax1 >= $npt_freepar1 ){
	    $imax1 = $npt_freepar1-1; # loop in build_marg_toy is min <= bin <= max
	}
        
	# loop in build_marg_toy is min <= bin <= max, avoid repetition of the last bin
	if( $imin0_p1 == $imin0 ){
	    last;
	}
	if( $imin1_p1 == $imin1 ){
	    last;
	}
	
	print "/////////////////////////////// \n \n";
	
	print "File output ID: $fileid \n";
	print "   - sub-range param 0: $imin0 - $imax0 \n"; 
	print "   - sub-range param 1: $imin1 - $imax1 \n"; 
	print "\n";
	
	$program = "root2k ";
		
	$arguments = " -l -b -q \'$softw_dir/macros/marginalization/run_fit_marginalization.C($read_toys,\"$tag_out\",$fileid,$imin0,$imax0,$imin1,$imax1,\"$tag_in\",$nfiles,\"$config_file\",\"$fitparamlist\",$nexpts_marg,\"$freepar0\",$minfreepar0,$maxfreepar0,$npt_freepar0,\"$freepar1\",$minfreepar1,$maxfreepar1,$npt_freepar1,$tweak_systematics,$marg_hierarchy,$rethrow_unphysical,\"$dmsqscheme\",\"$masshierarchy\",\"$mixparamchoice\",\"$mixparamoctant\",\"$xml_file\",$using_xml_file)\'";
	
	$command = "$program $arguments";
	print "$command \n";
	
	$fileid = $fileid+1;
	
	
	#
	# ETH (Monch cluster), $job_dir not used, $tag gives path/name of output file
	#
	if($resource eq "ETH-Monch") {
	    open(PBS, ">/mnt/lnec/davides/VALOR/sbatch_files/run_fit-$irun.sbatch") or die("Can not create the sbatch script");
	    print PBS "#!/bin/bash -l  \n";
	    #print PBS "#SBATCH --partition=dphys_compute_wk  \n";
	    #print PBS "#SBATCH --partition=dphys_compute  \n";
	    print PBS "#SBATCH --partition=dphys_largemem  \n";
	    print PBS "#SBATCH --nodes=1  \n";
	    print PBS "#SBATCH --ntasks-per-node=1  \n";
	    print PBS "#SBATCH --output=/mnt/lnec/davides/VALOR/outputs/out.%j.o  \n";
	    print PBS "#SBATCH --error=/mnt/lnec/davides/VALOR/outputs/out.%j.e  \n";
	    print PBS "$command \n";
	    close(PBS);
	    #`sbatch -t 23:59:00 /mnt/lnec/davides/VALOR/sbatch_files/run_fit-$irun.sbatch`;
	    #`sbatch -t 2-00:00:00 /mnt/lnec/davides/VALOR/sbatch_files/run_fit-$irun.sbatch`;
	    `sbatch -t 05:59:00 /mnt/lnec/davides/VALOR/sbatch_files/run_fit-$irun.sbatch`;
	    #`sbatch -t 00:05:00 /mnt/lnec/davides/VALOR/sbatch_files/run_fit-$irun.sbatch`;
	}
	
	#
	# ETH (Brutus cluster)
	#
	if($resource eq "ETH-Brutus") {
	    open(PBS, ">$job_dir/$tag-$ijob.sh") or die("Can not create the PBS batch script");
	    print PBS "#!/bin/bash \n";
	    #print PBS "#PBS -N $tag-$irun \n";
	    #print PBS "#PBS -l cput=$cput \n";
	    #print PBS "#PBS -o $job_dir/$tag-$irun.pbs.out \n";
	    #print PBS "#PBS -e $job_dir/$tag-$irun.pbs.err \n";
	    #print PBS "#PBS -q prod \n";
	    #print PBS "#PBS -l walltime=$cput \n";
	    #print PBS "cd $job_dir \n";
	    #print PBS "source $softw_dir/setup/setup_at_ral.sh $softw_dir\n";
	    print PBS "$command \n";
	    close(PBS);
	    `bsub -W 3:59 < $job_dir/$tag-$ijob.sh`;
	    #`bsub -W 1:59 < $job_dir/$tag-$ijob.sh`;
	    #`bsub -W 0:29 < $job_dir/$tag-$ijob.sh`;
	}
	
	#
	# RAL
	#
	if($resource eq "RAL") {
	    $source = `which bash`;
	    $fullprogram = `which root2k`;
	    $fullprogram = `readlink -m $fullprogram`;
	    $arguments =~ s/\"/\\\"/g;        # All double quotes must be escaped for Condor
	    $arguments =~ s/\'//g;            # and apparently single quotes are unnecessary but break it
	    
	    $consh   = "$job_dir/$tag_in-run_fit_marg-$ijob.consh";
	    $cndname = "$job_dir/$tag_in-run_fit_marg-$ijob.condor";
	    
	    open(CONSH,">$consh") or die("Cannot make shell script for Condor");
	    print CONSH "cd $job_dir \n";
	    print CONSH "$command \n";
	    close(CONSH);
	    
	    open(CND, ">$cndname") or die("Cannot create the Condor file");
	    print CND "Executable               = $source \n";
	    print CND "Arguments                = $consh \n";
	    print CND "Error                    = $job_dir/fit_marg_$tag_in-${ijob}_\$\(Process\).err \n";
	    print CND "Output                   = $job_dir/fit_marg_$tag_in-${ijob}_\$\(Process\).out \n";
	    print CND "Universe                 = vanilla \n";
	    print CND "Getenv                   = True \n";
	    print CND "should_transfer_files    = YES \n";
	    print CND "when_to_transfer_output  = ON_EXIT \n";
	    
	    print CND "InitialDir               = $job_dir \n";
	    
	    print CND "\nqueue\n";
	    
	    close(CND);
	    `condor_submit $cndname`;
	}
	
	
	#
	# RAL (SL5)
	#
	if($resource eq "OLDRAL") {
	    open(PBS, ">$job_dir/$tag-$irun.pbs") or die("Can not create the PBS batch script");
	    print PBS "#!/bin/bash \n";
	    print PBS "#PBS -N $tag-$irun \n";
	    print PBS "#PBS -l cput=$cput \n";
	    print PBS "#PBS -o $job_dir/$tag-$irun.pbs.out \n";
	    print PBS "#PBS -e $job_dir/$tag-$irun.pbs.err \n";
	    print PBS "#PBS -q prod \n";
	    print PBS "#PBS -l walltime=$cput \n";
	    print PBS "cd $job_dir \n";
	    print PBS "source $softw_dir/setup/setup_at_ral.sh $softw_dir\n";
	    print PBS "$command \n";
	    close(PBS);
	    #`qsub -q prod $job_dir/$tag-$irun.pbs`;
	}
	
	#
	# Oxford
	#
	if($resource eq "Oxford") {
	    open(PBS, ">$job_dir/$tag-$irun.pbs") or die("Can not create the PBS batch script");
	    print PBS "#!/bin/bash \n";
	    print PBS "#PBS -N $tag-$irun \n";
	    print PBS "#PBS -l cput=$cput \n";
	    print PBS "#PBS -o $job_dir/$tag-$irun.pbs.out \n";
	    print PBS "#PBS -e $job_dir/$tag-$irun.pbs.err \n";
	    print PBS "cd $job_dir \n";
	    print PBS "source $softw_dir/setup/setup_at_cvmfs.sh $softw_dir\n";
	    print PBS "$command \n";
	    close(PBS);
	    `qsub $job_dir/$tag-$irun.pbs`;
	}
	#
	# Grid
	#
	if($resource eq "Grid") {
	    print "Not supported just yet!\n";
	}
	#
	# interactive
	#
	if($resource eq "interactive") {
	    system($command);
	}
	
	$ijob++;
    
    } # freepar 0
} # freepar 1

