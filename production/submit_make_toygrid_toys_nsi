#!/usr/bin/perl


#-------------------------------------------------------------------------------------------------------------------------------
# Submit a batch of make_toygrid_toys_nsi jobs
#
# Inputs
#  --xmlfile                : Input xml file with all the toys
#  --resource               : Computer resource, <RAL, Oxford, Grid, interactive>. Default: interactive.
#  --tag                    : Tag for output files. Default: toyexptfits.
#  --nruns                  : Number of runs (jobs) to submit. Default: 1.
#  --nexpts                 : Number of toy MC expt fits per run. Default: 1000.
#  --cpu-time               : Required CPU time. Default: "6:00:00" for RAL, "11:50:00" for Oxford.
#  --stat-fluctuations      : include statistical fluctuation in toy MC expts
#  --tweak-systematics      : generate toy MC with randomized systematics
#  --store-toy-expts        : Store the generated toy MC expts? Default: No.
#  --store-bestfit-spectra  : Store the best-fit spectra? Default: No.
#  --fit-param-list         : Fit parameter list. Default: "nuosc3f_numudisapp_fix4+nuisance". See FitParamList.h for allowed options.
#  --fit-option             : Option passed to fitter. Default: "minuit".
#  --job-dir                : Directory for job scripts and outputs. Default: `pwd`.
#  --softw-dir              : Oscillation code top-level directory. Default: `pwd`.
#  --config-file            : Analysis configuration file from the config/ directory. Default: "analysis_configuration.xml"
#  --dmsq-scheme            : abs23 or fogli
#  --hierarchy              : normal or inverted
#  --mix-param-choice       : sinsq2theta or sinsqtheta
#  --mix-param-octant       : one or two
#  --dcp-value              : Number of pi to use as value of deltacp (when deltacp is not fit for). Default 0.
#
# C.Andreopoulos
#-------------------------------------------------------------------------------------------------------------------------------
#

use File::Path;

$iarg=0;
foreach (@ARGV) {
  if($iarg % 2 == 1) {$iarg++; next;}
      
  if      ($_ eq '--resource'                  ) { $resource              = $ARGV[$iarg+1]; }
  elsif   ($_ eq '--tag'                       ) { $tag                   = $ARGV[$iarg+1]; }
  elsif   ($_ eq '--cpu-time'                  ) { $cput                  = $ARGV[$iarg+1]; }
  elsif   ($_ eq '--store-toy-expts'           ) { $store_toy_expts       = $ARGV[$iarg+1]; }
  elsif   ($_ eq '--store-bestfit-spectra'     ) { $store_bestfit_spectra = $ARGV[$iarg+1]; }
  elsif   ($_ eq '--fit-param-list'            ) { $fitparamlist          = $ARGV[$iarg+1]; }
  elsif   ($_ eq '--fit-option'                ) { $fitoption             = $ARGV[$iarg+1]; }
  elsif   ($_ eq '--job-dir'                   ) { $job_dir               = $ARGV[$iarg+1]; }
  elsif   ($_ eq '--softw-dir'                 ) { $softw_dir             = $ARGV[$iarg+1]; }
  elsif   ($_ eq '--config-file'               ) { $config_file           = $ARGV[$iarg+1]; }
  elsif   ($_ eq '--dmsq-scheme'               ) { $dmsqscheme            = $ARGV[$iarg+1]; }
  elsif   ($_ eq '--hierarchy'                 ) { $masshierarchy         = $ARGV[$iarg+1]; }
  elsif   ($_ eq '--mix-param-choice'          ) { $mixparamchoice        = $ARGV[$iarg+1]; }
  elsif   ($_ eq '--mix-param-octant'          ) { $mixparamoctant        = $ARGV[$iarg+1]; }
  elsif   ($_ eq '--dcp-value'                 ) { $dcp_value             = $ARGV[$iarg+1]; }
  elsif   ($_ eq '--read-init-syst-from-file'  ) { $file_with_init_syst   = $ARGV[$iarg+1]; }

  elsif($_ eq '--input_mixing12'         ) { $input_mixing12        = $ARGV[$iarg+1]; }
  elsif($_ eq '--input_mixing13'         ) { $input_mixing13        = $ARGV[$iarg+1]; }
  elsif($_ eq '--input_mixing23'         ) { $input_mixing23        = $ARGV[$iarg+1]; }
  elsif($_ eq '--input_deltacp'          ) { $input_deltacp         = $ARGV[$iarg+1]; }
  elsif($_ eq '--input_dm12sq'           ) { $input_dm12sq          = $ARGV[$iarg+1]; }
  elsif($_ eq '--input_dm23sq'           ) { $input_dm23sq          = $ARGV[$iarg+1]; }
  
  elsif($_ eq '--input_epsmutau'         ) { $input_epsmutau        = $ARGV[$iarg+1]; }

  elsif($_ eq '--stat-fluctuations'      ) { $stat_fluctuations     = $ARGV[$iarg+1]; }
  elsif($_ eq '--tweak-systematics'      ) { $tweak_systematics     = $ARGV[$iarg+1]; }

  elsif($_ eq '--tolerance'           ) { $tolerance          = $ARGV[$iarg+1]; }
  
  elsif($_ eq '--xmlfile'             ) { $xmlfile            = $ARGV[$iarg+1]; }
  elsif($_ eq '--using-xmlfile'       ) { $using_xmlfile      = $ARGV[$iarg+1]; }

  elsif($_ eq '--optfixparams'        ) { $optfixparams      = $ARGV[$iarg+1]; }
  elsif($_ eq '--optnuisparams'       ) { $optnuisparams     = $ARGV[$iarg+1]; }

  elsif($_ eq '--param1'              ) { $param1             = $ARGV[$iarg+1]; }
  elsif($_ eq '--param2'              ) { $param2             = $ARGV[$iarg+1]; }
  
  elsif($_ eq '--nbins-tot-param1'      ) { $nbins_tot_param1    = $ARGV[$iarg+1]; }
  elsif($_ eq '--nbins-tot-param2'      ) { $nbins_tot_param2    = $ARGV[$iarg+1]; }

  elsif($_ eq '--min-bin-param1'      ) { $min_bin_param1     = $ARGV[$iarg+1]; }
  elsif($_ eq '--min-bin-param2'      ) { $min_bin_param2     = $ARGV[$iarg+1]; }
  elsif($_ eq '--max-bin-param1'      ) { $max_bin_param1     = $ARGV[$iarg+1]; }
  elsif($_ eq '--max-bin-param2'      ) { $max_bin_param2     = $ARGV[$iarg+1]; }

  elsif($_ eq '--step-grid-1'           ) { $step_grid_1          = $ARGV[$iarg+1]; }
  elsif($_ eq '--step-grid-2'           ) { $step_grid_2          = $ARGV[$iarg+1]; }

  else {
    print "Unrecognised argument ".$_."\n"; exit;
  }
  $iarg++;
}
$resource               = "interactive"                          unless defined $resource;
$store_toy_expts        = 0                                      unless defined $store_toy_expts;
$store_bestfit_spectra  = 0                                      unless defined $store_bestfit_spectra;

$fitparamlist           = "nsi3f_fix4+nuisance"                  unless defined $fitparamlist;

$fitoption              = "minuit"                               unless defined $fitoption;

$tag                    = "NSI_Asimov"                           unless defined $tag;
$job_dir                = "."                                    unless defined $job_dir;
$softw_dir              = $ENV{'T2KOSCANA'}                      unless defined $softw_dir;

$config_file            = "joint/analysis_configuration_fhc_rhc_full_pot_50_50.xml" unless defined $config_file;

$input_mixing12         = -99                         unless defined $input_mixing12;
$input_mixing13         = -99                         unless defined $input_mixing13;
$input_mixing23         = -99                         unless defined $input_mixing23;
$input_deltacp          = -99                         unless defined $input_deltacp;
$input_dm12sq           = -99                         unless defined $input_dm12sq;
$input_dm23sq           = -99                         unless defined $input_dm23sq;

$masshierarchy          = "normal"                               unless defined $masshierarchy;
$mixparamchoice         = "sinsqtheta"                           unless defined $mixparamchoice;
$mixparamoctant         = "one"                                  unless defined $mixparamoctant;
$tolerance              = 0.1                                    unless defined $tolerance;
 
$stat_fluctuations       = 0                                    unless defined $stat_fluctuations;
$tweak_systematics       = 0                                    unless defined $tweak_systematics;

$xmlfile                 = "NOSUCHFILE"                          unless defined $xmlfile;

$using_xmlfile           = 0                                     unless defined $using_xmlfile;
 
$optfixparams            = "dmsq12,mixing13,mixing12,deltacp"      unless defined $optfixparams;  # list of the params to be fixed in the fit   
$optnuisparams           = "mixing23,dmsq23"                       unless defined $optnuisparams;  # list of the params to be fixed in the fit   
        
$param1                 = "epsmutau"                             unless defined $param1;
$param2                 = "none"                                 unless defined $param2;
$nbins_tot_param1        = 51                                    unless defined $nbins_tot_param1;   # tot # grid values for param1 (start from bin=1) --> part of the grid --> step = nbins-1 
$nbins_tot_param2        = 1                                     unless defined $nbins_tot_param2;   # tot # grid values for param1 (start from bin=1) --> part of the grid --> step = nbins-1 
$min_bin_param1          = 1                                     unless defined $min_bin_param1;     # total range to loop over (first bin, param1)
$max_bin_param1          = $nbins_tot_param1                     unless defined $max_bin_param1;    # total range to loop over (last bin, param1)
$min_bin_param2          = 1                                     unless defined $min_bin_param2;     # total range to loop over (first bin, param2)
$max_bin_param2          = $nbins_tot_param2                     unless defined $max_bin_param2;    # total range to loop over (last bin, param2)

$step_grid_1             = $nbins_tot_param1                     unless defined $step_grid_1;     # step for each job for param1
$step_grid_2             = $nbins_tot_param2                     unless defined $step_grid_2;     # step for each job for param2

$file_with_init_syst = 0                                         unless defined $file_with_init_syst;




if( !defined $cput ) {
    if($resource eq "RAL"   ) { $cput = "6:00:00";  }
    if($resource eq "OLDRAL") { $cput = "6:00:00";  }
    if($resource eq "Oxford") { $cput = "11:50:00"; }
}

# Quote the init file if it's not zero
if ($file_with_init_syst) {$file_with_init_syst = "\"".$file_with_init_syst."\"";}

mkpath ($job_dir, {verbose => 1, mode=>0777}); 
die("$job_dir doesn't exist") unless -d $job_dir;

# Select which toys in the xml files to fit
$irun  = 0;
$first = 0;                # first toy of the job
$last  = 0;                # last toy of the job
$ijob = 1;

for($imin1 = $min_bin_param1; $imin1 <= $max_bin_param1; $imin1 = $imin1+$step_grid_1) { 
    $min_bin_1 = $imin1;
    $max_bin_1 = $imin1-1 + $step_grid_1;

    if($min_bin_1 < $min_bin_param1) {
	$min_bin_1 = $min_bin_param1;
    }
    if($max_bin_1 > $max_bin_param1) {
	$max_bin_1 = $max_bin_param1;
    }
    
    for($imin2 = $min_bin_param2; $imin2 <= $max_bin_param2; $imin2 = $imin2+$step_grid_2) { 
	$min_bin_2 = $imin2;
	$max_bin_2 = $imin2-1 + $step_grid_2;
	
	if($min_bin_2 < $min_bin_param2) {
	    $min_bin_2 = $min_bin_param2;
	}
	if($max_bin_2 > $max_bin_param2) {
	    $max_bin_2 = $max_bin_param2;
	}

	    $nfits = ($max_bin_1-$min_bin_1+1)*($max_bin_2-$min_bin_2+1);
	    
	    print "\n";
	    print "Submitting job $ijob: \n";
	    print "nbins_tot_param1 = $nbins_tot_param1 - bin_param_1 = $min_bin_1 - $max_bin_1 \n";
	    print "nbins_tot_param2 = $nbins_tot_param2 - bin_param_2 = $min_bin_2 - $max_bin_2 \n";
	    print "# point fits = $nfits \n";
	    
        $program = "root2k ";
	    $arguments = " -l -b -q \'$softw_dir/macros/contour/fc/global/make_toygrid_toys_nsi.C(\"$xmlfile\",\"$tag\",$irun,$first,$last,$input_mixing12,$input_mixing13,$input_mixing23,$input_deltacp,$input_dm12sq,$input_dm23sq,$input_epsmutau,$stat_fluctuations,$tweak_systematics,$using_xmlfile,\"$config_file\",\"$fitparamlist\",\"$fitoption\",\"$masshierarchy\",\"$mixparamchoice\",$tolerance,\"$param1\",\"$param2\",$nbins_tot_param1,$nbins_tot_param2,$min_bin_1,$max_bin_1,$min_bin_2,$max_bin_2,\"$optfixparams\",\"$optnuisparams\",$file_with_init_syst)\'";
		$command = "$program $arguments";
        

	    print "$command \n";

	    $ijob=$ijob+1;

	    #
	    # ETH (Monch cluster), $job_dir not used, $tag gives path/name of output file
	    #
	    if($resource eq "ETH-Monch") {
		open(PBS, ">/mnt/lnec/davides/VALOR/sbatch_files/run_fit-$irun.sbatch") or die("Can not create the sbatch script");
		print PBS "#!/bin/bash -l  \n";
		#print PBS "#SBATCH --partition=dphys_compute_wk  \n";
		print PBS "#SBATCH --partition=dphys_compute  \n";
		print PBS "#SBATCH --nodes=1  \n";
		print PBS "#SBATCH --ntasks-per-node=1  \n";
		print PBS "#SBATCH --output=/mnt/lnec/davides/VALOR/outputs/out.%j.o  \n";
		print PBS "#SBATCH --error=/mnt/lnec/davides/VALOR/outputs/out.%j.e  \n";
		print PBS "$command \n";
		close(PBS);
		#`sbatch -t 23:59:00 /mnt/lnec/davides/VALOR/sbatch_files/run_fit-$irun.sbatch`;
		#`sbatch -t 2-00:00:00 /mnt/lnec/davides/VALOR/sbatch_files/run_fit-$irun.sbatch`;
		#`sbatch -t 00:59:00 /mnt/lnec/davides/VALOR/sbatch_files/run_fit-$irun.sbatch`;
		`sbatch -t 00:05:00 /mnt/lnec/davides/VALOR/sbatch_files/run_fit-$irun.sbatch`;
	    }

	    #
	    # ETH (Brutus cluster)
	    #
	    if($resource eq "ETH-Brutus") {
		open(PBS, ">$job_dir/$tag-$ijob.sh") or die("Can not create the PBS batch script");
		print PBS "#!/bin/bash \n";
		#print PBS "#PBS -N $tag-$irun \n";
		#print PBS "#PBS -l cput=$cput \n";
		#print PBS "#PBS -o $job_dir/$tag-$irun.pbs.out \n";
		#print PBS "#PBS -e $job_dir/$tag-$irun.pbs.err \n";
		#print PBS "#PBS -q prod \n";
		#print PBS "#PBS -l walltime=$cput \n";
		#print PBS "cd $job_dir \n";
		#print PBS "source $softw_dir/setup/setup_at_ral.sh $softw_dir\n";
		print PBS "$command \n";
		close(PBS);
		`bsub -W 3:59 < $job_dir/$tag-$ijob.sh`;
		#`bsub -W 1:59 < $job_dir/$tag-$ijob.sh`;
		#`bsub -W 0:29 < $job_dir/$tag-$ijob.sh`;
		}
		
		#
		# RAL
		#
		if($resource eq "RAL") {
		   $fullprogram = `which root2k`;
		   $fullprogram = `readlink -m $fullprogram`;
		   $arguments =~ s/\"/\\\"/g;        # All double quotes must be escaped for Condor
		   $arguments =~ s/\'//g;            # and apparently single quotes are unnecessary but break it
		   open(CND, ">$job_dir/$tag-$ijob.condor") or die("Cannot create the Condor batch script");
		   print CND "Executable               = $fullprogram \n";
		   print CND "Arguments                = $arguments \n";
		   print CND "Error                    = $job_dir/toys_proc_$tag-${ijob}_\$\(Process\).err \n";
		   print CND "Output                   = $job_dir/toys_proc_$tag-${ijob}_\$\(Process\).out \n";
		   print CND "Universe                 = vanilla \n";
		   print CND "Getenv                   = True \n";
		   print CND "should_transfer_files    = YES \n";
		   print CND "when_to_transfer_output  = ON_EXIT \n";
		   print CND "\nqueue\n";
		   
		   close(CND);
		   `condor_submit $job_dir/$tag-$ijob.condor`;
		}

		
		#
		# RAL (SL5)
		#
		if($resource eq "OLDRAL") {
		open(PBS, ">$job_dir/$tag-$irun.pbs") or die("Can not create the PBS batch script");
		print PBS "#!/bin/bash \n";
		print PBS "#PBS -N $tag-$irun \n";
		print PBS "#PBS -l cput=$cput \n";
		print PBS "#PBS -o $job_dir/$tag-$irun.pbs.out \n";
		print PBS "#PBS -e $job_dir/$tag-$irun.pbs.err \n";
		print PBS "#PBS -q prod \n";
		print PBS "#PBS -l walltime=$cput \n";
		print PBS "cd $job_dir \n";
		print PBS "source $softw_dir/setup/setup_at_ral.sh $softw_dir\n";
		print PBS "$command \n";
		close(PBS);
		#`qsub -q prod $job_dir/$tag-$irun.pbs`;
	    }

	    #
	    # Oxford
	    #
	    if($resource eq "Oxford") {
		open(PBS, ">$job_dir/$tag-$irun.pbs") or die("Can not create the PBS batch script");
		print PBS "#!/bin/bash \n";
		print PBS "#PBS -N $tag-$irun \n";
		print PBS "#PBS -l cput=$cput \n";
		print PBS "#PBS -o $job_dir/$tag-$irun.pbs.out \n";
		print PBS "#PBS -e $job_dir/$tag-$irun.pbs.err \n";
		print PBS "cd $job_dir \n";
		print PBS "source $softw_dir/setup/setup_at_oxford.sh $softw_dir\n";
		print PBS "$command \n";
		close(PBS);
		`qsub $job_dir/$tag-$irun.pbs`;
	    }
	    #
	    # Grid
	    #
	    if($resource eq "Grid") {
		print "Not supported just yet!\n";
	    }
	    #
	    # interactive
	    #
	    if($resource eq "interactive") {
		system($command);
	    }
    } # ibin2
} # ibin1
