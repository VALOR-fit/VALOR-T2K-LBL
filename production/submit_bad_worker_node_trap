#!/usr/bin/perl

$njobs = 30;
$ijob  = 0;

$curr_dir = `pwd`;

while($ijob < $njobs) {

  $batch_script  = "trap$ijob.pbs";

  open(PBS, ">$batch_script") or die("Can not create the PBS batch script");
  print PBS "#!/bin/bash \n";
  print PBS "#PBS -N trap$ijob \n";
  print PBS "#PBS -l cput=12:00:00 \n";
  print PBS "#PBS -o trap$ijob.pbs.out \n";
  print PBS "#PBS -e trap$ijob.pbs.err \n";
  print PBS "cd $curr_dir \n";
  print PBS "perl production/bad_worker_node_trap \n";
  close(PBS);

  `qsub -q $queue $batch_script`;

  $ijob++
}
