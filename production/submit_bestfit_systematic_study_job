#!/usr/bin/perl

#
#--------------------------------------------------------------------------------------------------------------------------- 
# Submit a batch of jobs to study systematic at the best fit point
#
# Inputs
#  --resource               : <RAL, IN2P3, Oxford, Grid, interactive> (default: interactive)
#  --nruns                  : number of runs (jobs) per systematic (default: 10)
#  --nexpts                 : number of experiments per run (default: 1000)
#  --cpu-time               : CPU time (default: "6:00:00" for RAL, "1500000" for IN2P3, "11:50:00" for Oxford)
#  --dm12sq                 : value of \Delta m^{2}_{12}   (default: -99 == conv:kGlobFitDm12sq)
#  --dm23sq                 : value of \Delta m^{2}_{23}   (default: -99)
#  --deltacp                : value of \delta_{cp}  (default: -99)
#  --sinsq2theta12          : value of sin^{2}2\theta_{12} (default: -99) 
#  --sinsq2theta13          : value of sin^{2}2\theta_{13} (default: -99) 
#  --sinsq2theta23          : value of sin^{2}2\theta_{23} (default: -99) 
#  --fit-param-list         : FitParamList to use. (default: "nuosc3f_numudisapp_fix4")
#  --job-dir                : Directory for job scripts and outputs (default: `pwd`)
#  --softw-dir              : Oscillation code top-level directory (default: `pwd`)
#  --config-file            : Analysis configuration file from the config/ directory (default: analysis_configuration.xml)
#  --list-of-systematics    : file with list of systematic (default: <softw_dir>/inputs/official/2012/syst.list)
#
# C.Andreopoulos
#--------------------------------------------------------------------------------------------------------------------------- 
#

use File::Path;

$iarg=0;
foreach (@ARGV) {
  if($iarg % 2 == 1) {$iarg++; next;}
  
  if   ($_ eq '--resource'              ) { $resource      = $ARGV[$iarg+1]; }
  elsif($_ eq '--nruns'                 ) { $nruns         = $ARGV[$iarg+1]; }
  elsif($_ eq '--nexpts'                ) { $nexpts        = $ARGV[$iarg+1]; }
  elsif($_ eq '--cpu-time'              ) { $cput          = $ARGV[$iarg+1]; }
  elsif($_ eq '--dm12sq'                ) { $dm12sq        = $ARGV[$iarg+1]; }
  elsif($_ eq '--dm23sq'                ) { $dm23sq        = $ARGV[$iarg+1]; }
  elsif($_ eq '--deltacp'               ) { $deltacp       = $ARGV[$iarg+1]; }
  elsif($_ eq '--sinsq2theta12'         ) { $sinsq2theta12 = $ARGV[$iarg+1]; }
  elsif($_ eq '--sinsq2theta13'         ) { $sinsq2theta13 = $ARGV[$iarg+1]; }
  elsif($_ eq '--sinsq2theta23'         ) { $sinsq2theta23 = $ARGV[$iarg+1]; }
  elsif($_ eq '--fit-param-list'        ) { $fitparamlist  = $ARGV[$iarg+1]; }
  elsif($_ eq '--job-dir'               ) { $job_dir       = $ARGV[$iarg+1]; }
  elsif($_ eq '--softw-dir'             ) { $softw_dir     = $ARGV[$iarg+1]; }
  elsif($_ eq '--config-file'           ) { $config_file   = $ARGV[$iarg+1]; }
  elsif($_ eq '--list-of-systematics'   ) { $systlistfile  = $ARGV[$iarg+1]; }
  
  else {
      print "Unrecognised argument ".$_."\n"; exit;
  }
  
  $iarg++;
}
$resource               = "interactive"                                unless defined $resource;
$nruns                  = 10                                           unless defined $nruns;
$nexpts                 = 1000                                         unless defined $nexpts;
$dm12sq                 = -99                                          unless defined $dm12sq; 
$dm23sq                 = -99                                          unless defined $dm23sq; 
$deltacp                = -99                                          unless defined $deltacp; 
$sinsq2theta12          = -99                                          unless defined $sinsq2theta12;
$sinsq2theta13          = -99                                          unless defined $sinsq2theta13;
$sinsq2theta23          = -99                                          unless defined $sinsq2theta23;
$fitparamlist           = "nuosc3f_numudisapp_fix4"                    unless defined $fitparamlist;
$job_dir                = `pwd`                                        unless defined $job_dir;
chomp($job_dir);
$softw_dir              = $ENV{'T2KOSCANA'}                            unless defined $softw_dir;
chomp($softw_dir);
$config_file            = "analysis_configuration.xml"                 unless defined $config_file;
$systlistfile           = "$softw_dir/inputs/official/2012/syst.list"  unless defined $systlistfile;

if( !defined $cput) {
  if($resource eq "RAL"    ) { $cput = "6:00:00";  }
  if($resource eq "IN2P3"  ) { $cput = 1500000;    }
  if($resource eq "Oxford" ) { $cput = "11:50:00"; }
}

mkpath ($job_dir, {verbose => 1, mode=>0777});
die("$job_dir doesn't exist") unless -d $job_dir;

open(FSYSTLIST, $systlistfile) || die("Could not open file with list of systematics: $systlistfile!");
@systlist=<FSYSTLIST>; 

#loop over systematics
foreach(@systlist) {
  chomp;
  $systematic = $_;
  #loop over runs
  $irun = 0;
  while($irun < $nruns) {
    print "Submitting $systematic run: $irun \n";
    $batch_script  = "syst-$systematic-$irun.pbs";
    $command  = "root2k -l -b -q \'$softw_dir/macros/fit/syst/best_fit_point_spread/bestfit_systematic_study_fitting_job.C(\"$systematic\",\"$fitparamlist\",$irun,$sinsq2theta12,$sinsq2theta13,$sinsq2theta23,$deltacp,$dm12sq,$dm23sq,$nexpts,\"$config_file\")\'";
    print "$command \n";
    print "$job_dir/$batch_script";

    #
    # RAL
    #
    if($resource eq "RAL") {
       open(PBS, ">$job_dir/$batch_script") or die("Can not create the PBS batch script");
       print PBS "#!/bin/bash \n";
       print PBS "#PBS -N syst-$systematic-$irun \n";
       print PBS "#PBS -l cput=$cput \n";
       print PBS "#PBS -l walltime=$cput \n";
       print PBS "#PBS -o $job_dir/syst-$systematic-$irun.pbs.out \n";
       print PBS "#PBS -e $job_dir/syst-$systematic-$irun.pbs.err \n";
       print PBS "cd $job_dir/ \n";
       print PBS "source $softw_dir/setup/setup_at_ral.sh $softw_dir \n";
       print PBS "$command \n";
       close(PBS);
       `qsub -q prod $job_dir/$batch_script`;
    }
    #
    # IN2P3
    #
    if($resource eq "IN2P3") {
       open(PBS, ">$job_dir/$batch_script") or die("Can not create the PBS batch script");
       print PBS "#!/bin/tcsh \n";
       print PBS "cd $job_dir/ \n";
       print PBS "source $softw_dir/setup/setup_at_in2p3.csh $softw_dir \n";
       print PBS "$command \n";
       close(PBS);
       `chmod +x $job_dir/$batch_script`;
       `qsub -eo -V -l platform=LINUX,t=$cput,M=2200MB,scratch=500MB,u_sps_babar -o $job_dir/syst-$systematic-$irun.pbs.out -N syst-$systematic-$irun $job_dir/$batch_script`;
    }
    #
    # Oxford
    #
    if($resource eq "Oxford") {
       open(PBS, ">$job_dir/$batch_script") or die("Can not create the PBS batch script");
       print PBS "#!/bin/bash \n";
       print PBS "#PBS -N syst-$systematic-$irun \n";
       print PBS "#PBS -l cput=$cput \n";
       print PBS "#PBS -o $job_dir/syst-$systematic-$irun.pbs.out \n";
       print PBS "#PBS -e $job_dir/syst-$systematic-$irun.pbs.err \n";
       print PBS "cd $job_dir/ \n";
       print PBS "source $softw_dir/setup/setup_at_oxford.sh $softw_dir \n";
       print PBS "$command \n";
       close(PBS);
       `qsub $job_dir/$batch_script`;
    }
    #
    # Grid
    #
    if($resource eq "Grid") {
       print "Not supported just yet!\n";
    }
    #
    # interactive
    #
    if($resource eq "interactive") {
       system($command);
    }

    $irun++;
  }#loop over runs for given systematic 
}#loop over systematics in input list
