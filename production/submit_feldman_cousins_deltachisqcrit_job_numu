#!/usr/bin/perl

#----------------------------------------------------------------------------------------
# Split make_feldman_cousins_deltachisqcrit_surface.C in many jobs for faster results
#
# Arguments
#
# --resource : 
#      <RAL, IN2P3, Oxford, Grid>, default: RAL
# --fit-results :
#      Specify the directory where output ntuples from the Feldman-Cousins fitting 
#      jobs can be found.
# --tag :
#      A tag (eg. genie-statsyst, neut-statonly-v2, ...) to be used as prefix for the
#      output ROOT files and the batch scripts and error logs.
# --num-sinsq2theta23-bins-per-job :
#      In this analysis there are 101 sinsq2theta23 bins. 
#      The first bin is centered at 0.5 and the last bin is centered at 1.0. 
#      The bin width is 0.005.
#      To parallelize the \Delta\chi^{2} surface making tasks, each job will process a
#      few sinsq2theta23 bins only. Use this argument to specify the number of bins per
#      job. Use a number that divides 100. As there are 101 bins, the last job will 
#      handle 1 extra bin. Default value is 5 (therefore, 20 jobs will be submitted).
#  --cpu-time : 
#      CPU time. 
#      Default: "6:00:00" for RAL
#  --job-dir : 
#      Directory for job scripts and outputs, default: `pwd`
#  --softw-dir : 
#      Oscillation code top-level directory, default: `pwd`
# 
# C.Andreopoulos
#----------------------------------------------------------------------------------------

use File::Path;

$iarg=0;
foreach (@ARGV) {
  if($iarg % 2 == 1) {$iarg++; next;}
    
  if   ($_ eq '--resource'                      ) { $resource      = $ARGV[$iarg+1]; }
  elsif($_ eq '--cpu-time'                      ) { $cput          = $ARGV[$iarg+1]; }
  elsif($_ eq '--fit-results'                   ) { $inputdir      = $ARGV[$iarg+1]; }
  elsif($_ eq '--tag'                           ) { $tag           = $ARGV[$iarg+1]; }
  elsif($_ eq '--num-sinsq2theta23-bins-per-job') { $nbins_per_job = $ARGV[$iarg+1]; }
  elsif($_ eq '--job-dir'                       ) { $job_dir       = $ARGV[$iarg+1]; }
  elsif($_ eq '--softw-dir'                     ) { $softw_dir     = $ARGV[$iarg+1]; }
  
  else {
      print "Unrecognised argument ".$_."\n"; exit;
  }
  
  $iarg++;
}
$resource       = "RAL" unless defined $resource;
$nbins_per_job  = 5     unless defined $nbins_per_job;
$job_dir        = `pwd` unless defined $job_dir;
$softw_dir      = `pwd` unless defined $softw_dir;

if( !defined $cput) {
  if($resource eq "RAL"    )  { $cput = "6:00:00";  }
  if($resource eq "IN2P3"  )  { $cput = "1500000";  }
  if($resource eq "Oxford" )  { $cput = "11:50:00"; }
  if($resource eq "Grid"   )  { $cput = "??";       }
}

$njobs            = 200 / $nbins_per_job;
$ijob             = 0;
$curr_job_bin_min = 1;
$curr_job_bin_max = $nbins_per_job;

mkpath ($job_dir, {verbose => 1, mode=>0777});
die("$job_dir doesn't exist") unless -d $job_dir;
     
while($ijob < $njobs) {

  if($ijob == $njobs-1) {
     $curr_job_bin_max++; #odd number of bins, last job has 1 more
  }
  $outputfile = "$tag$ijob.root";
  $command    = "root2k -l -b -q \'$softw_dir/macros/contour/fc/numu/make_feldman_cousins_deltachisqcrit_surface.C(\"$inputdir\",\"$outputfile\",$curr_job_bin_min,$curr_job_bin_max)\'"; 

  print "Submitting job... $ijob \n";
  print "  $command \n";

  #
  # RAL
  #
  if($resource eq "RAL") {
       open(PBS, ">$job_dir/$tag-$ijob.pbs") or die("Can not create the PBS batch script");
       print PBS "#!/bin/bash \n";
       print PBS "#PBS -N $tag-$ijob \n";
       print PBS "#PBS -l cput=$cput \n";
       print PBS "#PBS -l walltime=$cput \n";
       print PBS "#PBS -o $job_dir/$tag-$ijob.pbs.out \n";
       print PBS "#PBS -e $job_dir/$tag-$ijob.pbs.err \n";
       print PBS "cd $job_dir/ \n";
       print PBS "source $softw_dir/setup/setup_at_ral.sh $softw_dir \n";
       print PBS "$command \n";
       close(PBS);
      `qsub -q prod $job_dir/$tag-$ijob.pbs`;
  }#RAL

  # 
  # IN2P3
  #
  if($resource eq "IN2P3") {
     print "$resource not supported just yet!\n"; 
  }#IN2P3

  #   
  # Oxford
  #   
  if($resource eq "Oxford") {
     print "$resource not supported just yet!\n"; 
  }#Oxford

  #   
  # Grid
  #   
  if($resource eq "Grid") {
     print "$resource not supported just yet!\n"; 
  }#Grid


  $curr_job_bin_min = $curr_job_bin_max + 1;
  $curr_job_bin_max = $curr_job_bin_max + $nbins_per_job;
  $ijob++;
}
