#!/usr/bin/perl

#
#---------------------------------------------------------------------------------------------------------------------------- 
# Submit a batch of test_n_mock_data_fits_xml.C jobs
#
# Inputs
#  --resource               : Computer resource, <RAL, IN2P3, Oxford, Grid, interactive>. Default: "interactive"
#  --tag                    : Tag for output files. Default: "toyexptfits"
#  --nruns                  : Number of runs (jobs). Default: 1.
#  --nexpts                 : Number of experiments to fit per run. . Default: 1000.
#  --first-expt             : ID of first toy MC expt to fit in first job
#  --cpu-time               : default: "6:00:00" for RAL, "1500000" for IN2P3, "11:50:00" for Oxford
#  --fit-param-list         : Fit parameter list. Default: "numudisapp2f". See FitParamList.h for allowed options.
#  --fit-option             : Option passed to fitter. Default: "minuit".
#  --toy-expts-file         : XML file with toy MC experiments (including full path)
#  --job-dir                : Directory for job scripts and outputs, default: `pwd`
#  --softw-dir              : Oscillation code top-level directory, default: `pwd`
#  --config-file            : Analysis configuration file from the config/ directory, default: "analysis_configuration.xml"
#  --proxy-id               : Id used to delegate the proxy
#  --no-chisq-surf-withsyst : Don't do the chisq surface with systematics
#
# C.Andreopoulos
#---------------------------------------------------------------------------------------------------------------------------- 
#

use File::Path;

$iarg=0;
foreach (@ARGV) {
  if($_ eq '--resource'       ) { $resource      = $ARGV[$iarg+1]; }
  if($_ eq '--tag'            ) { $tag           = $ARGV[$iarg+1]; }
  if($_ eq '--nruns'          ) { $nruns         = $ARGV[$iarg+1]; }
  if($_ eq '--nexpts'         ) { $nexpts        = $ARGV[$iarg+1]; }
  if($_ eq '--first-expt'     ) { $firstexpt     = $ARGV[$iarg+1]; }
  if($_ eq '--cpu-time'       ) { $cput          = $ARGV[$iarg+1]; }
  if($_ eq '--fit-param-list' ) { $fitparamlist  = $ARGV[$iarg+1]; }
  if($_ eq '--fit-option'     ) { $fitoption     = $ARGV[$iarg+1]; }
  if($_ eq '--toy-expts-file' ) { $toyexptsfile  = $ARGV[$iarg+1]; }
  if($_ eq '--job-dir'        ) { $job_dir       = $ARGV[$iarg+1]; }
  if($_ eq '--grid-local-dir'        ) { $grid_local_dir       = $ARGV[$iarg+1]; }
  if($_ eq '--softw-dir'      ) { $softw_dir     = $ARGV[$iarg+1]; }
  if($_ eq '--config-file'    ) { $config_file   = $ARGV[$iarg+1]; }
  if($_ eq '--proxy-id'       ) { $proxy_id      = $ARGV[$iarg+1]; }
  if($_ eq '--no-chisq-surf-withsyst' ) { $chisq_syst             = 0; }
  if($_ eq '--chisqsyst-mixing23-min' ) { $chisqsyst_mixing23_min = $ARGV[$iarg+1]; }
  if($_ eq '--chisqsyst-mixing23-max' ) { $chisqsyst_mixing23_max = $ARGV[$iarg+1]; }
  if($_ eq '--chisqsyst-dm23sq-min'   ) { $chisqsyst_dm23sq_min   = $ARGV[$iarg+1]; }
  if($_ eq '--chisqsyst-dm23sq-max'   ) { $chisqsyst_dm23sq_max   = $ARGV[$iarg+1]; }
  if($_ eq '--chisqwithsyst-mixing23'      ) { $chisqwithsyst_mixing23      = 1;              }
  if($_ eq '--chisqwithsyst-mixing23-step' ) { $chisqwithsyst_mixing23_step = $ARGV[$iarg+1]; }
  if($_ eq '--chisqwithsyst-dm23sq'        ) { $chisqwithsyst_dm23sq        = 1;              }
  if($_ eq '--chisqwithsyst-dm23sq-step'   ) { $chisqwithsyst_dm23sq_step   = $ARGV[$iarg+1]; }
  if($_ eq '--gridpath'                    ) { $gridpath                    = $ARGV[$iarg+1]; }
  if($_ eq '--chisqwithsyst-mixing23'      ) { $chisqwithsyst_mixing23      = 1;              }
  if($_ eq '--chisqwithsyst-mixing23-step' ) { $chisqwithsyst_mixing23_step = $ARGV[$iarg+1]; }
  if($_ eq '--chisqwithsyst-dm23sq'        ) { $chisqwithsyst_dm23sq        = 1;              }
  if($_ eq '--chisqwithsyst-dm23sq-step'   ) { $chisqwithsyst_dm23sq_step   = $ARGV[$iarg+1]; }
  $iarg++;
}

die("Please specify a toy experiment file using --toy-expts-file") unless defined $toyexptsfile;

$resource               = "interactive"                 unless defined $resource;
$tag                    = "toyexptfits"                 unless defined $tag;
$nruns                  = 1                             unless defined $nruns;
$nexpts                 = 1                             unless defined $nexpts;
$firstexpt              = 0                             unless defined $firstexpt;
$fitparamlist           = "nuosc3f_numudisapp_fix4"     unless defined $fitparamlist;
$fitoption              = "minuit"                      unless defined $fitoption;
$job_dir                = `pwd`                         unless defined $job_dir;
$grid_local_dir         = `pwd`                         unless defined $grid_local_dir;
$softw_dir              = `pwd`                         unless defined $softw_dir;
$config_file            = "analysis_configuration.xml"  unless defined $config_file;
$chisq_syst             = 1                             unless defined $chisq_syst;
$proxy_id               = "valor"                       unless defined $proxy_id;
$output_option          = "Observation+BestFitSpectra+ChisqSurface+Canvases";
$chisqsyst_mixing23_min = 0.6                           unless defined $chisqsyst_mixing23_min;
$chisqsyst_mixing23_max = 1.0                           unless defined $chisqsyst_mixing23_max;
$chisqsyst_dm23sq_min   = 0.001                         unless defined $chisqsyst_dm23sq_min;
$chisqsyst_dm23sq_max   = 0.004                         unless defined $chisqsyst_dm23sq_max;
$chisqwithsyst_mixing23 = 0                             unless defined $chisqwithsyst_mixing23;
$chisqwithsyst_mixing23_step = 0.01                     unless defined $chisqwithsyst_mixing23_step;
$chisqwithsyst_dm23sq   = 0                             unless defined $chisqwithsyst_dm23sq;
$chisqwithsyst_dm23sq_step = 0.01                       unless defined $chisqwithsyst_dm23sq_step;
$chisqwithsyst_mixing23 = 0                             unless defined $chisqwithsyst_mixing23;
$chisqwithsyst_mixing23_step = 0.01                     unless defined $chisqwithsyst_mixing23_step;
$chisqwithsyst_dm23sq   = 0                             unless defined $chisqwithsyst_dm23sq;
$chisqwithsyst_dm23sq_step = 0.01                       unless defined $chisqwithsyst_dm23sq_step;


if( !defined $cput) {
  if($resource eq "RAL"   ) { $cput = "6:00:00";  }
  if($resource eq "IN2P3" ) { $cput = 1500000;    }
  if($resource eq "Oxford") { $cput = "11:50:00"; }
}

print "$job_dir";
mkpath ($job_dir, {verbose => 1, mode=>0777}); 
die("$job_dir doesn't exist") unless -d $job_dir;

$irun  = 0;
$first = $firstexpt;
$last  = $firstexpt + $nexpts - 1;

while($irun < $nruns) {

  print "Submitting run: $irun \n";

  $batch_script  = "$tag-$irun.pbs";
  $job_name      = "$tag-$irun";

  if( $resource eq "Grid") { $macro_dir = "\$T2KOSCANA";       }
  else                     { $macro_dir = $softw_dir; }

  $command = "root2k -l -b -q \'$macro_dir/macros/fit/toymc/test_n_mock_data_fits_xml.C(\"$tag\",$irun,\"$toyexptsfile\",$first,$last,\"$config_file\",\"$fitparamlist\",\"$fitoption\",\"$output_option\",$chisq_syst,$chisqsyst_mixing23_min,$chisqsyst_mixing23_max,$chisqsyst_dm23sq_min,$chisqsyst_dm23sq_max,$chisqwithsyst_mixing23,$chisqwithsyst_mixing23_step,$chisqwithsyst_dm23sq,$chisqwithsyst_dm23sq_step)\'";

  $first = $last  + 1;
  $last  = $first + $nexpts - 1;

  print "$command \n";

  #
  # RAL
  #
  if($resource eq "RAL") {
     open(PBS, ">$job_dir/$batch_script") or die("Can not create the PBS batch script");
     print PBS "#!/bin/bash \n";
     print PBS "#PBS -N $job_name \n";
     print PBS "#PBS -l cput=$cput \n";
     print PBS "#PBS -l walltime=$cput \n";
     print PBS "#PBS -o $job_dir/$tag-$irun.pbs.out \n";
     print PBS "#PBS -e $job_dir/$tag-$irun.pbs.err \n";
     print PBS "cd $job_dir \n";
     print PBS "source $softw_dir/setup/setup_at_ral.sh $softw_dir \n";
     print PBS "$command \n";
     close(PBS);
     `qsub -q prod $job_dir/$batch_script`;
  }
  #
  # IN2P3
  #
  if($resource eq "IN2P3") {
     open(PBS, ">$job_dir/$batch_script") or die("Can not create the PBS batch script");
     print PBS "#!/bin/tcsh \n";
     print PBS "cd $job_dir \n";
     print PBS "source $softw_dir/setup/setup_at_in2p3.csh $softw_dir \n";
     print PBS "$command \n";
     close(PBS);
     `chmod +x $job_dir/$batch_script`;
     `qsub -eo -V -l platform=LINUX,t=$cput,M=2200MB,scratch=500MB,u_sps_babar -o $tag-$irun.pbs.out -N $job_name $job_dir/$batch_script`;
  }
  #
  # Oxford
  #
  if($resource eq "Oxford") {
      open(PBS, ">$job_dir/$batch_script") or die("Can not create the PBS batch script");
      print PBS "#!/bin/bash \n";
      print PBS "#PBS -N $job_name \n";
      print PBS "#PBS -l cput=$cput \n";
      print PBS "#PBS -o $job_dir/$tag-$irun.pbs.out \n";
      print PBS "#PBS -e $job_dir/$tag-$irun.pbs.err \n";
      print PBS "cd $job_dir \n";
      print PBS "source $softw_dir/setup/setup_at_oxford.sh $softw_dir \n";
      print PBS "$command \n";
      close(PBS);
     `qsub $job_dir/$batch_script`;
  }
  #
  # Grid
  #
  if($resource eq "Grid") {
    die("gridpath isn't specified") unless defined $gridpath;
    # First write the JDL file
    open(JDL, ">$tag-$irun.jdl") or die("Can not create the JDL script");
    print JDL "Executable = \"$tag-$irun.sh\"; \n";
    print JDL "StdOutput = \"$tag-$irun.out\"; \n";
    print JDL "StdError = \"$tag-$irun.err\"; \n";
    print JDL "InputSandbox = {\"$tag-$irun.sh\"}; \n";
    print JDL "OutputSandbox = {\"$tag-$irun.out\",\"$tag-$irun.err\",\"$tag-$irun.root\"}; \n";
    print JDL "VirtualOrganisation = \"t2k.org\"; \n";
    print JDL "Requirements = other.GlueCEInfoHostName == \"heplnx206.pp.rl.ac.uk\" || other.GlueCEInfoHostName == \"heplnx207.pp.rl.ac.uk\" || other.GlueCEInfoHostName == \"heplnx208.pp.rl.ac.uk\"; \n";
    
    # Then write the executable for the JDL file
    open(SH, ">$tag-$irun.sh") or die("Can not create the .sh batch script");
    print SH "#!/bin/bash \n";
    print SH "# time as a UNIX timestamp \n" ;                                                                                                                                  
    print SH "T0=\"\$\(date +\%s)\"\n";
    print SH "# setup env vars \n";
    print SH "export LFC_HOST=lfc.gridpp.rl.ac.uk\n";
    print SH "export GLOBUS_FTP_CLIENT_GRIDFTP2=true\n";
    print SH "# trap error and remove code if error happens \n";
    print SH "P=\$PWD \n";
    print SH "echo \"*** Setting up environmental variables...\" \n";
    print SH "source $softw_dir/setup/setup_at_ral.sh $softw_dir \n";
    print SH "cd $grid_local_dir \n";
    print SH "echo \"*** Running the macro...\"\n";
    print SH "$command\n";
    print SH "# try to handle failure of the macro (exit \!= 0)\n";
    print SH "if \[ \"\$\?\" \= \"0\" \]; then\n";
    print SH "       lcg-cr -v --vo t2k.org file:./mockfit_$irun.root -l lfn:/grid/t2k.org/nd280/contrib/dealtry/$gridpath/mockfit_$irun.root -d srm://srm-t2k.gridpp.rl.ac.uk/castor/ads.rl.ac.uk/prod/t2k.org/nd280/contrib/dealtry/$gridpath/mockfit_$irun.root \n";
    print SH "       lcg-cr -v --vo t2k.org file:./$tag-run_$irun-expts_$irun_$irun.root -l lfn:/grid/t2k.org/nd280/contrib/dealtry/$gridpath/$tag-run_$irun-expts_$irun_$irun.root -d srm://srm-t2k.gridpp.rl.ac.uk/castor/ads.rl.ac.uk/prod/t2k.org/nd280/contrib/dealtry/$gridpath/$tag-run_$irun-expts_$irun_$irun.root \n";
    print SH "       echo \"*** Total time: \$\{T\}\"\n";
    print SH "       echo Done!\n";
    print SH "else\n";
    print SH "       echo Error happened!!!\n";
    print SH "       T=\"\$\(\(\$\(date +\%s\)-T0\)\)\"\n";
    print SH "       echo \"*** Total time: \$\{T\}\"\n";
    print SH "       exit\n";
    print SH "fi\n";
    print SH "#echo Done!\n";
  }


  #
  # interactive
  #
  if($resource eq "interactive") {
     system($command);
  }

  $irun++;
}


if($resource eq "Grid") {
  # Finally write the sh bash script to handle the job submission
  open(SH0, ">$tag.sh") or die("Can not create the .sh batch script");
  print SH0 "#!/bin/bash \n";
  print SH0 "echo \"*** Creating proxy...\" \n";
  print SH0 "voms-proxy-init -valid 100:0 -voms t2k.org \n";
  print SH0 "echo \"*** Submitting jobs to the GRID...\" \n";
  $irun = 0;
  while($irun < $nruns) {
    print SH0 "glite-wms-job-submit -a -c $softw_dir/production/grid/autowms.conf -o $tag.jid $tag-$irun.jdl\n";
    $irun++;
  }
  `chmod +x $tag.sh`;
  #`./$tag.sh`;
}
