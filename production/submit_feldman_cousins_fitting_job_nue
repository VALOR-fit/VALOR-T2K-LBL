#!/usr/bin/perl

#
#-----------------------------------------------------------------------------------------------------------------------------
# Submit a batch of nue feldman_cousins_fitting_job.C jobs
#
# Inputs
#  --resource               : <RAL, IN2P3, Oxford, Grid, interactive>. Default: "interactive".
#  --tag                    :
#  --nruns                  :
#  --nexpts                 :
#  --cpu-time               : Default: "6:00:00" for RAL, "1500000" for IN2P3, "11:50:00" for Oxford.
#  --stat-fluctuations      : include statistical fluctuation in toy MC expts.
#  --tweak-systematics      : generate toy MC with randomized systematics.
#  --tweak-oth-osc-params   : generate toy MC with randomized dmsq12,theta12,|dm23sq|,theta23.
#  --min-deltacp-bin        : Default:   1.
#  --max-deltacp-bin        : Default:  91.
#  --min-sinsq2theta13-bin  : Default:   1.
#  --max-sinsq2theta13-bin  : Default: 101.
#  --fit-param-list         : Fit parameter list. Default: "nuosc3f_nueapp_fix4". See FitParamList.h for allowed options.
#  --fit-option             : Option passed to fitter. Default: "minuit".
#  --job-dir                : Directory for job scripts and outputs. Default: `pwd`.
#  --softw-dir              : Oscillation code top-level directory. Default: `pwd`.
#  --config-file            : Analysis configuration file from the config/ directory. Default: "analysis_configuration.xml".
#
# C.Andreopoulos
#----------------------------------------------------------------------------------------------------------------------------- 
#

use File::Path;

$iarg=0;
foreach (@ARGV) {
  if($_ eq '--resource'              ) { $resource              = $ARGV[$iarg+1]; }
  if($_ eq '--tag'                   ) { $tag                   = $ARGV[$iarg+1]; }
  if($_ eq '--nruns'                 ) { $nruns                 = $ARGV[$iarg+1]; }
  if($_ eq '--nexpts'                ) { $nexpts                = $ARGV[$iarg+1]; }
  if($_ eq '--cpu-time'              ) { $cput                  = $ARGV[$iarg+1]; }
  if($_ eq '--stat-fluctuations'     ) { $stat_fluct            = 1;              }
  if($_ eq '--tweak-systematics'     ) { $twk_systematics       = 1;              }
  if($_ eq '--tweak-oth-osc-params'  ) { $twk_oth_osc           = 1;              }
  if($_ eq '--min-deltacp-bin'       ) { $min_deltacp_bin       = $ARGV[$iarg+1]; }
  if($_ eq '--max-deltacp-bin'       ) { $max_deltacp_bin       = $ARGV[$iarg+1]; }
  if($_ eq '--min-sinsq2theta13-bin' ) { $min_sinsq2theta13_bin = $ARGV[$iarg+1]; }
  if($_ eq '--max-sinsq2theta13-bin' ) { $max_sinsq2theta13_bin = $ARGV[$iarg+1]; }
  if($_ eq '--fit-param-list'        ) { $fitparamlist          = $ARGV[$iarg+1]; }
  if($_ eq '--fit-option'            ) { $fitoption             = $ARGV[$iarg+1]; }
  if($_ eq '--job-dir'               ) { $job_dir               = $ARGV[$iarg+1]; }
  if($_ eq '--softw-dir'             ) { $softw_dir             = $ARGV[$iarg+1]; }
  if($_ eq '--config-file'           ) { $config_file           = $ARGV[$iarg+1]; }
  $iarg++;
}
$min_deltacp_bin        = 1                             unless defined $min_deltacp_bin;
$max_deltacp_bin        = 91                            unless defined $max_deltacp_bin; 
$min_sinsq2theta13_bin  = 1                             unless defined $min_sinsq2theta13_bin;
$max_sinsq2theta13_bin  = 101                           unless defined $max_sinsq2theta13_bin;
$resource               = "interactive"                 unless defined $resource;
$tag                    = "fc"                          unless defined $tag;
$nruns                  = 1                             unless defined $nruns;
$nexpts                 = 1000                          unless defined $nexpts;
$stat_fluct             = 0                             unless defined $stat_fluct;
$twk_systematics        = 0                             unless defined $twk_systematics;
$twk_oth_osc            = 0                             unless defined $twk_oth_osc;
$fitparamlist           = "nuosc3f_nueapp_fix4"         unless defined $fitparamlist;
$fitoption              = "minuit"                      unless defined $fitoption;
$job_dir                = `pwd`                         unless defined $job_dir;
$softw_dir              = `pwd`                         unless defined $softw_dir;
$config_file            = "analysis_configuration.xml"  unless defined $config_file;

if( !defined $cput) {
  if($resource eq "RAL"   ) { $cput = "6:00:00";  }
  if($resource eq "IN2P3" ) { $cput = 1500000;    }
  if($resource eq "Oxford") { $cput = "11:50:00"; }
}

mkpath ($job_dir, {verbose => 1, mode=>0777});
die("$job_dir doesn't exist") unless -d $job_dir;

$irun = 0;
while($irun < $nruns) {

  print "Submitting $tag run: $irun \n";

  $command  = "root2k -l -b -q \'$softw_dir/macros/contour/fc/nue/feldman_cousins_fitting_job.C(\"$tag\",$irun,$nexpts,$min_deltacp_bin,$max_deltacp_bin,$min_sinsq2theta13_bin,$max_sinsq2theta13_bin,\"$config_file\",$stat_fluct,$twk_systematics,$twk_oth_osc,\"$fitparamlist\",\"$fitoption\")\'";
  print "$command \n";

  #
  # RAL
  #
  if($resource eq "RAL") {
     open(PBS, ">$job_dir/$tag-$irun.pbs") or die("Can not create the PBS batch script");
     print PBS "#!/bin/bash \n";
     print PBS "#PBS -N $tag-$irun \n";
     print PBS "#PBS -l walltime=$cput \n";
     print PBS "#PBS -l cput=$cput \n";
     print PBS "#PBS -o $job_dir/$tag-$irun.pbs.out \n";
     print PBS "#PBS -e $job_dir/$tag-$irun.pbs.err \n";
     print PBS "cd $job_dir/ \n";
     print PBS "source $softw_dir/setup/setup_at_ral.sh $softw_dir\n";
     print PBS "$command \n";
     close(PBS);
     `qsub -q prod $job_dir/$tag-$irun.pbs`;
  }
  #
  # IN2P3
  #
  if($resource eq "IN2P3") {
     open(PBS, ">$job_dir/$tag-$irun.pbs") or die("Can not create the PBS batch script");
     print PBS "#!/bin/tcsh \n";
     print PBS "cd $job_dir/ \n";
     print PBS "source $softw_dir/setup/setup_at_in2p3.csh $softw_dir\n";
     print PBS "$command \n";
     close(PBS);
     `chmod +x $job_dir/$tag-$irun.pbs`;
     `qsub -eo -V -l platform=LINUX,t=$cput,M=2200MB,scratch=500MB,u_sps_babar -o $job_dir/$tag-$irun.pbs.out -N $tag-$irun $job_dir/$tag-$irun.pbs`;
  }
  #
  # Oxford
  #
  if($resource eq "Oxford") {
      open(PBS, ">$job_dir/$tag-$irun.pbs") or die("Can not create the PBS batch script");
      print PBS "#!/bin/bash \n";
      print PBS "#PBS -N $tag-$irun \n";
      print PBS "#PBS -l cput=$cput \n";
      print PBS "#PBS -o $job_dir/$tag-$irun.pbs.out \n";
      print PBS "#PBS -e $job_dir/$tag-$irun.pbs.err \n";
      print PBS "cd $job_dir/ \n";
      print PBS "source $softw_dir/setup/setup_at_oxford.sh $softw_dir\n";
      print PBS "$command \n";
      close(PBS);
     `qsub $job_dir/$tag-$irun.pbs`;
  }
  #
  # Grid
  #
  if($resource eq "Grid") {
     print "Not supported just yet!\n";
  }
  #
  # interactive
  #
  if($resource eq "interactive") {
     system($command);
  }

  $irun++;
}
