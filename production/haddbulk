#!/usr/bin/perl

#
#-----------------------------------------------------------------------------------------------------------
# ROOT's hadd has a limitation of ~1000 files so you can't easily hadd entire directories
# with ROOT files if the number of files exceeds 1000.
# This script reads all the files from the input directory and hadd's groups of N files.
#
# Options:
#  --input-file-path     : Input ROOT files path.
#  --output-file-path    : Output ROOT files path.
#  --output-file-tag     : Output file name tag. Each output files is named as <tag>-<random_string>.root
#  --max-files-per-hadd  : Max input files per `hadd' command.
#
# C.Andreopoulos
#-----------------------------------------------------------------------------------------------------------
#

$iarg = 0;
foreach (@ARGV) {
  if($_ eq '--input-file-path'   ) { $inp_path = $ARGV[$iarg+1]; }
  if($_ eq '--output-file-path'  ) { $out_path = $ARGV[$iarg+1]; }
  if($_ eq '--output-file-tag'   ) { $out_tag  = $ARGV[$iarg+1]; }
  if($_ eq '--max-files-per-hadd') { $nfmax    = $ARGV[$iarg+1]; }
  $iarg++;
}
$inp_path  = "./"     unless defined $inp_path;
$out_path  = "./"     unless defined $out_path;
$out_tag   = "merged" unless defined $out_tag;
$nfmax     = 500      unless defined $nfmax;

opendir(DIR, $inp_path);
@files = readdir(DIR); 
closedir(DIR);

$nf=0;

foreach $curr_file (@files) {
   if($nf == 0) {
      $rndstr  = &generate_random_string(15);
      $command = "hadd $out_path/$out_tag-$rndstr.root ";
   }
#  print "$curr_file\n";
   if($curr_file=~m/.root/) {
      $command = $command." $inp_path/$curr_file";
      $nf++;
   }

   # hadd a batch of nfmax ROOT files
   if($nf == $nfmax) {
      #print "\n\n$command\n\n";
      system($command);
      $nf=0;
   }
}

# hadd remaining ROOT files
if($nf>0) {
  #print "\n\n$command\n\n";
  system($command);
}

sub generate_random_string
{
# as it says in its name - copied from the web
#
  # the length of the random string to generate
  my $length_of_randomstring=shift;

  my @chars=('a'..'z','A'..'Z','0'..'9','_');
  my $random_string;
  foreach (1..$length_of_randomstring) {
    # rand @chars will generate a random  number between 0 and scalar @chars
    $random_string.=$chars[rand @chars];
  }
  return $random_string;
}



