#!/usr/bin/perl

#
#-----------------------------------------------------------------------------------------------------------------------------
# Submit build_chisq_surface_disapp_parallelized.C jobs
#
# Inputs
#  --resource               : <RAL, Oxford, Grid, interactive>. Default: "interactive".
#  --tag                    :
#  --expt-file              : XML file with expts
#  --nexpts                 : Number of experiments to fit. Default: 1.
#  --first-expt             : ID of first toy MC expt to fit in first job
#  --cpu-time               : Default: "6:00:00" for RAL, "11:50:00" for Oxford.
#  --mix23-min              : Default: 0.9
#  --mix23-max              : Default: 1.0
#  --mix23-step             : Default: 0.001
#  --dm32sq-min             : Default: 0.002
#  --dm32sq-max             : Default: 0.003
#  --dm32sq-step            : Default: 0.00001
#  --fit-param-list         : Fit parameter list. Default: "nuosc3f_numudisapp_fix4+nuisance". See FitParamList.h for allowed options.
#  --fit-option             : Option passed to fitter. Default: "minuit".
#  --config-file            : Analysis configuration file from the config/ directory. Default: "analysis_configuration.xml".
#  --job-dir                : Directory for job scripts and outputs. Default: `pwd`.
#  --softw-dir              : Oscillation code top-level directory. Default: `pwd`.
#
# C.Andreopoulos
#----------------------------------------------------------------------------------------------------------------------------- 
#

use File::Path;
use POSIX;

$iarg=0;
foreach (@ARGV) {
  if($_ eq '--resource'              ) { $resource              = $ARGV[$iarg+1]; }
  if($_ eq '--tag'                   ) { $tag                   = $ARGV[$iarg+1]; }
  if($_ eq '--expt-file'             ) { $exptfile              = $ARGV[$iarg+1]; }
  if($_ eq '--nexpts'                ) { $nexpts                = $ARGV[$iarg+1]; }
  if($_ eq '--first-expt'            ) { $firstexpt             = $ARGV[$iarg+1]; }
  if($_ eq '--cpu-time'              ) { $cput                  = $ARGV[$iarg+1]; }
  if($_ eq '--mix23-min'             ) { $mix23_min             = $ARGV[$iarg+1]; }
  if($_ eq '--mix23-max'             ) { $mix23_max             = $ARGV[$iarg+1]; }
  if($_ eq '--mix23-step'            ) { $mix23_step            = $ARGV[$iarg+1]; }
  if($_ eq '--dm32sq-min'            ) { $dm32sq_min            = $ARGV[$iarg+1]; }
  if($_ eq '--dm32sq-max'            ) { $dm32sq_max            = $ARGV[$iarg+1]; }
  if($_ eq '--dm32sq-step'           ) { $dm32sq_step           = $ARGV[$iarg+1]; }
  if($_ eq '--fit-param-list'        ) { $fitparamlist          = $ARGV[$iarg+1]; }
  if($_ eq '--fit-option'            ) { $fitoption             = $ARGV[$iarg+1]; }
  if($_ eq '--config-file'           ) { $config_file           = $ARGV[$iarg+1]; }
  if($_ eq '--job-dir'               ) { $job_dir               = $ARGV[$iarg+1]; }
  if($_ eq '--softw-dir'             ) { $softw_dir             = $ARGV[$iarg+1]; }
  if($_ eq '--one-job-per-dmsq-row'  ) { $one_job_per_dmsq_row  = 1;              }
  if($_ eq '--dmsq-scheme'           ) { $dmsqscheme            = $ARGV[$iarg+1]; }
  if($_ eq '--mix-param-choice'      ) { $mixparamchoice        = $ARGV[$iarg+1]; }
  if($_ eq '--allow-2nu-unphysical'  ) { $apply_2nu_boundary    = 0;              }
  $iarg++;
}
$nexpts                 = 1                                      unless defined $nexpts;
$firstexpt              = 0                                      unless defined $firstexpt;
$mix23_min              = 0.9                                    unless defined $mix23_min;
$mix23_max              = 1.0                                    unless defined $mix23_max;
$mix23_step             = 0.001                                  unless defined $mix23_step;
$dm32sq_min             = 0.002                                  unless defined $dm32sq_min;
$dm32sq_max             = 0.003                                  unless defined $dm32sq_max;
$dm32sq_step            = 0.00001                                unless defined $dm32sq_step;
$resource               = "interactive"                          unless defined $resource;
$tag                    = "chisqsurf"                            unless defined $tag;
$fitparamlist           = "nuosc3f_numudisapp_fix4+nuisance"     unless defined $fitparamlist;
$fitoption              = "minuit"                               unless defined $fitoption;
$config_file            = "analysis_configuration.xml"           unless defined $config_file;
$job_dir                = `pwd`                                  unless defined $job_dir;
$softw_dir              = `pwd`                                  unless defined $softw_dir;
$dmsqscheme             = "abs23"                                unless defined $dmsqscheme;
$mixparamchoice         = "2theta"                               unless defined $mixparamchoice;
$apply_2nu_boundary     = 1                                      unless defined $apply_2nu_boundary;

die unless defined $exptfile;

if( !defined $cput) {
  if($resource eq "RAL"   ) { $cput = "6:00:00";  }
  if($resource eq "Oxford") { $cput = "11:50:00"; }
}

mkpath ($job_dir, {verbose => 1, mode=>0777});
die("$job_dir doesn't exist") unless -d $job_dir;

if( $resource eq "Grid") { $macro_dir = "./";       }
else                     { $macro_dir = $softw_dir; }

$mix23_nbins  = 1 + ceil(($mix23_max  - $mix23_min ) / $mix23_step );
$dm32sq_nbins = 1 + ceil(($dm32sq_max - $dm32sq_min) / $dm32sq_step);

print "mix23_nbins = $mix23_nbins, dm32sq_nbins = $dm32sq_nbins\n";

$first = $firstexpt;
$last  = $firstexpt + $nexpts - 1;

print "experiment range: [$first, $last] \n";

for ($mix23_bin = 1; $mix23_bin <= $mix23_nbins; $mix23_bin++) {
 for ($dm32sq_bin = 1; $dm32sq_bin <= $dm32sq_nbins; $dm32sq_bin++) {

   if(defined $one_job_per_dmsq_row) {
     $dm32sq_bin = -1;
   }

  print "Submitting $tag job for mix23 bin: $mix23_bin and dm32sq bin: $dm32sq_bin \n";

  $command  = "root2k -l -b -q \'$macro_dir/macros/chisq/build_chisq_surface_disapp_parallelized.C(\"$tag\",\"$exptfile\",$first,$last,\"$config_file\",\"$fitparamlist\",\"$fitoption\",$mix23_min,$mix23_max,$mix23_step,$dm32sq_min,$dm32sq_max,$dm32sq_step,$mix23_bin,$dm32sq_bin,\"$dmsqscheme\",\"$mixparamchoice\",$apply_2nu_boundary)\'";
  print "$command \n";

  #
  # RAL
  #
  if($resource eq "RAL") {
     open(PBS, ">$job_dir/$tag-$nexpt-$mix23_bin-$dm32sq_bin.pbs") or die("Can not create the PBS batch script");
     print PBS "#!/bin/bash \n";
     print PBS "#PBS -N $tag-$nexpt-$mix23_bin-$dm32sq_bin \n";
     print PBS "#PBS -l walltime=$cput \n";
     print PBS "#PBS -l cput=$cput \n";
     print PBS "#PBS -o $job_dir/$tag-$nexpt-$mix23_bin-$dm32sq_bin.pbs.out \n";
     print PBS "#PBS -e $job_dir/$tag-$nexpt-$mix23_bin-$dm32sq_bin.pbs.err \n";
     print PBS "cd $job_dir/ \n";
     print PBS "source $softw_dir/setup/setup_at_ral.sh $softw_dir\n";
     print PBS "$command \n";
     close(PBS);
     `qsub -q prod $job_dir/$tag-$nexpt-$mix23_bin-$dm32sq_bin.pbs`;
  }
  #
  # Oxford
  #
  if($resource eq "Oxford") {
      open(PBS, ">$job_dir/$tag-$nexpt-$mix23_bin-$dm32sq_bin.pbs") or die("Can not create the PBS batch script");
      print PBS "#!/bin/bash \n";
      print PBS "#PBS -N $tag-$nexpt-$mix23_bin-$dm32sq_bin \n";
      print PBS "#PBS -l cput=$cput \n";
      print PBS "#PBS -o $job_dir/$tag-$nexpt-$mix23_bin-$dm32sq_bin.pbs.out \n";
      print PBS "#PBS -e $job_dir/$tag-$nexpt-$mix23_bin-$dm32sq_bin.pbs.err \n";
      print PBS "cd $job_dir/ \n";
      print PBS "source $softw_dir/setup/setup_at_oxford.sh $softw_dir\n";
      print PBS "$command \n";
      close(PBS);
     `qsub $job_dir/$tag-$nexpt-$mix23_bin-$dm32sq_bin.pbs`;
  }
  #
  # Grid
  #
  if($resource eq "Grid") {
      # First write the JDL file
      open(JDL, ">$tag-$nexpt-$mix23_bin-$dm32sq_bin.jdl") or die("Can not create the JDL script");
      print JDL "Executable = \"$tag-$nexpt-$mix23_bin-$dm32sq_bin.sh\"; \n";
      print JDL "StdOutput = \"$tag-$nexpt-$mix23_bin-$dm32sq_bin.out\"; \n";
      print JDL "StdError = \"$tag-$nexpt-$mix23_bin-$dm32sq_bin.err\"; \n";
      print JDL "InputSandbox = {\"$tag-$nexpt-$mix23_bin-$dm32sq_bin.sh\",\"trunk_GRID.tar.gz\"}; \n";
      print JDL "OutputSandbox = {\"$tag-$nexpt-$mix23_bin-$dm32sq_bin.out\",\"$tag-$nexpt-$mix23_bin-$dm32sq_bin.err\",\"$tag-$nexpt-$mix23_bin-$dm32sq_bin.root\"}; \n";
      print JDL "VirtualOrganisation = \"t2k.org\"; \n";
      #print JDL "Requirements = RegExp(\"ic.ac.uk\", other.GlueCEUniqueId); \n";
      print JDL "Requirements = Member(\"VO-t2k.org-ND280-v10r11p17\",other.GlueHostApplicationSoftwareRunTimeEnvironment) && other.GlueCEPolicyMaxCPUTime > 600; \n";

      # Then write the executable for the JDL file
      open(SH, ">$tag-$nexpt-$mix23_bin-$dm32sq_bin.sh") or die("Can not create the .sh batch script");
      print SH "#!/bin/bash \n";
      print SH "# time as a UNIX timestamp \n" ;                                                                                                                                  
      print SH "T0=\"\$\(date +\%s)\"\n";
      print SH "# setup env vars \n";                                                                                                                                                               
      print SH "export LFC_HOST=lfc.gridpp.rl.ac.uk\n";
      print SH "export GLOBUS_FTP_CLIENT_GRIDFTP2=true\n";
      print SH "# trap error and remove code if error happens \n";
      print SH "P=\$PWD \n";
      print SH "#trap \'echo \"*** Error happened!!!\"; cd \$\{P\}; mv trunk_GRID/*.root .;echo \"*** Removing...\"; rm -fr trunk_GRID/; rm -fr trunk_GRID.tar.gz; ls -ltr; echo EXIT; exit\' ERR \n";
      print SH "# create temporal directory \n" ;
      print SH "echo \"*** Untaring code...\" \n";
      print SH "ls -ltr \n";
      print SH "tar xvfz trunk_GRID.tar.gz \n";
      print SH "echo \"*** Copying input files from GRID...\" \n";
      #print SH "lcg-cp -v --vo t2k.org lfn:/grid/t2k.org/contrib/lorena/inputs/data_new.xml file:./trunk_GRID/inputs/data.xml\n";
      #print SH "lcg-cp -v --vo t2k.org lfn:/grid/t2k.org/contrib/lorena/inputs/fakedata.xml file:./trunk_GRID/inputs/fakedata.xml\n";
      #print SH "lcg-cp -v --vo t2k.org lfn:/grid/t2k.org/contrib/lorena/inputs/official/2012/banff/postfit_banff_v8_osc_marg_MAQE.root file:./trunk_GRID/inputs/official/2012/banff/postfit_banff_v8_osc_marg_MAQE.root\n";
      print SH "lcg-cp -v --vo t2k.org lfn:/grid/t2k.org/contrib/lorena/inputs/official/2012/banff/postfit_banff_v8_osc_marg_MAQE_EBfix.root file:./trunk_GRID/inputs/official/2012/banff/postfit_banff_v8_osc_marg_MAQE_EBfix.root\n";
      print SH "lcg-cp -v --vo t2k.org lfn:/grid/t2k.org/contrib/lorena/inputs/official/2012/flux/11b_v3.2_run1-3c/sk_tuned11bv3.2_11anom_run1-run3c_fine.root file:./trunk_GRID/inputs/official/2012/flux/11b_v3.2_run1-3c/sk_tuned11bv3.2_11anom_run1-run3c_fine.root\n";
      print SH "lcg-cp -v --vo t2k.org lfn:/grid/t2k.org/contrib/lorena/inputs/official/2012/fsi/FSIandSIError_ICL_SKDetectorBinning.root file:./trunk_GRID/inputs/official/2012/fsi/FSIandSIError_ICL_SKDetectorBinning.root\n";
      print SH "lcg-cp -v --vo t2k.org lfn:/grid/t2k.org/contrib/lorena/inputs/official/2012/superk/err/sk_ccqe_rc_err_covariance.root file:./trunk_GRID/inputs/official/2012/superk/err/sk_ccqe_rc_err_covariance.root\n";
      print SH "lcg-cp -v --vo t2k.org lfn:/grid/t2k.org/contrib/lorena/inputs/official/2012/xsec/XSecSplinesCoarse2012_coarseEreco.root file:./trunk_GRID/inputs/official/2012/xsec/XSecSplinesCoarse2012_coarseEreco.root\n";
      print SH "lcg-cp -v --vo t2k.org lfn:/grid/t2k.org/contrib/lorena/inputs/official/2012/superk/mc/neut/11c/smallnt_numu_sk11c_flx11bv32fine_r1-3cfull_10acut.root file:./trunk_GRID/inputs/official/2012/superk/mc/neut/11c/smallnt_numu_sk11c_flx11bv32fine_r1-3cfull_10acut.root\n";
      #print SH "lcg-cp -v --vo t2k.org lfn:/grid/t2k.org/contrib/lorena/inputs/official/2012/superk/mc/neut/11c/superk_1ReT_numu.root file:./trunk_GRID/inputs/official/2012/superk/mc/neut/11c/superk_1ReT_numu.root\n";
      #print SH "lcg-cp -v --vo t2k.org lfn:/grid/t2k.org/contrib/lorena/inputs/official/2012/superk/mc/neut/11c/superk_1ReT_numubar.root file:./trunk_GRID/inputs/official/2012/superk/mc/neut/11c/superk_1ReT_numubar.root\n";
      #print SH "lcg-cp -v --vo t2k.org lfn:/grid/t2k.org/contrib/lorena/inputs/official/2012/superk/mc/neut/11c/superk_1ReT_nue.root file:./trunk_GRID/inputs/official/2012/superk/mc/neut/11c/superk_1ReT_nue.root\n";
      #print SH "lcg-cp -v --vo t2k.org lfn:/grid/t2k.org/contrib/lorena/inputs/official/2012/superk/mc/neut/11c/superk_1ReT_nuebar.root file:./trunk_GRID/inputs/official/2012/superk/mc/neut/11c/superk_1ReT_nuebar.root\n";
      #print SH "lcg-cp -v --vo t2k.org lfn:/grid/t2k.org/contrib/lorena/inputs/official/2012/superk/mc/neut/11c/superk_1ReT_nuesig.root file:./trunk_GRID/inputs/official/2012/superk/mc/neut/11c/superk_1ReT_nuesig.root\n";
      print SH "ls -ltr\n";
      print SH "ls -ltr trunk_GRID/\n";
      print SH "ls -ltr trunk_GRID/inputs/\n";
      print SH "ls -ltr trunk_GRID/inputs/*/*/*\n";
      print SH "ls -ltr trunk_GRID/inputs/*/*/*/*\n";
      print SH "ls -ltr trunk_GRID/inputs/*/*/*/*/*/*\n";
      print SH "T1=\"\$\(\(\$\(date +\%s\)-T0\)\)\"\n";
      print SH "echo \"*** Time in seconds for copying input files: \$\{T1\}\" \n";
      print SH "echo \"*** Setting up environmental variables...\" \n";
      print SH "source trunk_GRID/setup_at_grid.sh\n";
      print SH "echo \"*** Compiling the code...\"\n";
      print SH "cd trunk_GRID/\n";
      print SH "ls -ltr \$VO_T2K_ORG_SW_DIR/\n";
      print SH "ls -ltr \$VO_T2K_ORG_SW_DIR/nd280v10r11p17/ROOT/\n";
      print SH "ls -ltr \$VO_T2K_ORG_SW_DIR/nd280v10r11p17/ROOT/v5r30p02n01/\n";
      print SH "ls -ltr \$VO_T2K_ORG_SW_DIR/nd280v10r11p17/ROOT/v5r30p02n01/amd64_linux26/\n";
      print SH "pwd\n";
      print SH "which root\n";
      print SH "make clean\n";
      print SH "make\n";
      print SH "T=\"\$\(\(\$\(date + \%s\)-T0\)\)\"\n";
      print SH "echo \"*** Time to compile in seconds: \$\{T\}\"\n";
      print SH "echo \"*** Running the macro...\"\n";
      print SH "$command\n";
      print SH "# try to handle failure of the macro (exit \!= 0)\n";
      print SH "if \[ \"\$\?\" \= \"0\" \]; then\n";
      print SH "       cd ..\n";
      print SH "       mv trunk_GRID/*.root .\n";
      print SH "       echo \"*** Removing...\"\n";
      print SH "       rm -fr trunk_GRID/\n";
      print SH "       rm -fr trunk_GRID.tar.gz\n";
      print SH "       ls -ltr\n";
      print SH "       T=\"\$\(\(\$\(date +\%s\)-T0\)\)\"\n";
      print SH "       echo \"*** Total time: \$\{T\}\"\n";
      print SH "       echo Done!\n";
      print SH "else\n";
      print SH "       echo Error happened!!!\n";
      print SH "       cd ..\n";
      print SH "       mv trunk_GRID/*.root .\n";
      print SH "       echo \"*** Removing...\"\n";
      print SH "       rm -fr trunk_GRID/\n";
      print SH "       rm -fr trunk_GRID.tar.gz\n";
      print SH "       ls -ltr\n";
      print SH "       T=\"\$\(\(\$\(date +\%s\)-T0\)\)\"\n";
      print SH "       echo \"*** Total time: \$\{T\}\"\n";
      print SH "       exit\n";
      print SH "fi\n";
      print SH "#cd ..\n";
      print SH "#ls -ltr trunk_GRID/      \n";
      print SH "#echo \"*** Copying output file...\"\n";
      print SH "#mv trunk_GRID/*.root .\n";
      print SH "#ls -ltr\n";
      print SH "#echo \"*** Removing...\"\n";
      print SH "#rm -fr trunk_GRID/\n";
      print SH "#rm -fr trunk_GRID.tar.gz\n";
      print SH "#ls -ltr trunk_GRID/\n";
      print SH "#ls -ltr\n";
      print SH "#T=\"\$\(\(\$\(date +\%s\)-T0\)\)\"\n";
      print SH "#echo \"*** Total time: \$\{T\}\"\n";
      print SH "#echo Done!\n";
  }

  #
  # interactive
  #
  if($resource eq "interactive") {
     system($command);
  }

   if(defined $one_job_per_dmsq_row) {
     last;
   }
 }#bins
}#bins


if($resource eq "Grid") {
    # Finally write the sh bash script to handle the job submission
    open(SH0, ">$tag.sh") or die("Can not create the .sh batch script");
    print SH0 "#!/bin/bash \n";
    print SH0 "echo \"*** Creating proxy...\" \n";
    print SH0 "voms-proxy-init -valid 99:0 -voms t2k.org\n";
    #print SH0 "export MYPROXY_SERVER=lcgrbp01.gridpp.rl.ac.uk\n";
    #print SH0 "myproxy-init -v -d -n -s \$MYPROXY_SERVER\n";
    #print SH0 "glite-wms-job-delegate-proxy -d $proxy_id -e https://lcgwms03.gridpp.rl.ac.uk:7443/glite_wms_wmproxy_server;\n";
    print SH0 "echo \"*** Preparing the code...\" \n";
    print SH0 "rm -fr trunk_GRID \n";
    print SH0 "mkdir trunk_GRID \n";
    print SH0 "mkdir trunk_GRID/fitter \n";
    print SH0 "cp $softw_dir/fitter/*.cxx trunk_GRID/fitter\n";
    print SH0 "cp $softw_dir/fitter/*.h trunk_GRID/fitter\n";
    print SH0 "cp $softw_dir/fitter/Make* trunk_GRID/fitter\n";
    print SH0 "cp $softw_dir/fitter/VERSION trunk_GRID/fitter\n";
    print SH0 "mkdir trunk_GRID/config \n";
    print SH0 "cp $softw_dir/config/* trunk_GRID/config\n";
    print SH0 "mkdir trunk_GRID/root \n";
    print SH0 "cp $softw_dir/root/* trunk_GRID/root\n";
    print SH0 "cp $softw_dir/setup/setup_at_grid.sh trunk_GRID\n";
    print SH0 "cp $softw_dir/Makefile trunk_GRID\n";
    print SH0 "mkdir trunk_GRID/inputs\n";
    print SH0 "cp $softw_dir/inputs/*.xml trunk_GRID/inputs\n";
    print SH0 "mkdir trunk_GRID/inputs/FCbinlist\n";
    print SH0 "cp $softw_dir/inputs/FCbinlist/*.data trunk_GRID/inputs/FCbinlist\n";
    #these files are huge!
    #print SH0 "mkdir trunk_GRID/inputs/toymc\n";
    #print SH0 "cp $softw_dir/inputs/toymc/*.xml trunk_GRID/inputs/toymc\n";
    print SH0 "mkdir trunk_GRID/inputs/official\n";    
    print SH0 "mkdir trunk_GRID/inputs/official/2012\n";
    print SH0 "mkdir trunk_GRID/inputs/official/2012/banff\n";
    print SH0 "mkdir trunk_GRID/inputs/official/2012/flux\n";
    print SH0 "mkdir trunk_GRID/inputs/official/2012/flux/11b_v3.2_run1-3c\n";
    print SH0 "mkdir trunk_GRID/inputs/official/2012/fsi\n";
    print SH0 "mkdir trunk_GRID/inputs/official/2012/xsec\n";
    print SH0 "mkdir trunk_GRID/inputs/official/2012/superk\n";
    print SH0 "mkdir trunk_GRID/inputs/official/2012/superk/err\n";
    print SH0 "mkdir trunk_GRID/inputs/official/2012/superk/mc\n";
    print SH0 "mkdir trunk_GRID/inputs/official/2012/superk/mc/neut\n";
    print SH0 "mkdir trunk_GRID/inputs/official/2012/superk/mc/neut/11c\n";
    print SH0 "mkdir trunk_GRID/macros/\n";
    print SH0 "mkdir trunk_GRID/macros/fit/\n";
    print SH0 "mkdir trunk_GRID/macros/fit/toymc\n";
    print SH0 "cp $softw_dir/macros/fit/toymc/*.C trunk_GRID/macros/fit/toymc\n";
    print SH0 "mkdir trunk_GRID/macros/fit/stat\n";
    print SH0 "cp $softw_dir/macros/fit/stat/*.C trunk_GRID/macros/fit/stat\n";
    print SH0 "mkdir trunk_GRID/macros/contour/\n";
    print SH0 "mkdir trunk_GRID/macros/contour/fc/\n";
    print SH0 "mkdir trunk_GRID/macros/contour/fc/numu/\n";
    print SH0 "cp $softw_dir/macros/contour/fc/numu/*.C trunk_GRID/macros/contour/fc/numu\n";
    print SH0 "tar -pczf trunk_GRID.tar.gz trunk_GRID\n";
    print SH0 "echo \"*** Submitting jobs to the GRID...\" \n";
    for($mix23_bin = 1; $mix23_bin <= $mix23_nbins; $mix23_bin++){
      for($dm32sq_bin = 1; $dm32sq_bin <= $dm32sq_nbins; $dm32sq_bin++){
	print SH0 "echo $nexpt $mix23_bin $dm32sq_bin\n";
	print SH0 "glite-wms-job-submit -a -c $softw_dir/production/grid/autowms.conf -o $tag.jid $tag-$nexpt-$mix23_bin-$dm32sq_bin.jdl\n";
      }
    }
    `chmod +x $tag.sh`;
#    `./$tag.sh`;
  }
