{
   $tag             = "oa2017_AsimovA_${masshierarchy}_reactor"  unless defined $tag;
}
else
{
   $tag             = "oa2017_AsimovA_${masshierarchy}_t2k"  unless defined $tag;
}

$wqueue = "medium";

# # 1D fit - dcp
if(($freepar0 eq "deltacp") and ($freepar1 eq ""))
{
   $tag = "${tag}_${freepar0}";
