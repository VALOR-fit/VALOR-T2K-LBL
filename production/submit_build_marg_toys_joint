      $npt_freepar0           = 100                       unless defined $npt_freepar0;
   }
   else
   {
      $nexpts_marg            = 80000;#40000                        unless defined $nexpts_marg;
      $step_freepar0          = 1;
      $wqueue                 = "long -M 8192";#"long";
      $npt_freepar0           = 100                       unless defined $npt_freepar0;
   }
   $minfreepar0            = -3.14159265358979312e+00    unless defined $minfreepar0;     # Minimum free parameter allowed value
   $maxfreepar0            = +3.14159265358979312e+00    unless defined $maxfreepar0;     # Maximum free parameter allowed value 
   $minfreepar1            = 0.                          unless defined $minfreepar1;     # Minimum free parameter allowed value
   $maxfreepar1            = 0.                          unless defined $maxfreepar1;     # Maximum free parameter allowed value 
   $npt_freepar1           = 1                           unless defined $npt_freepar1;    # of free parameter points to scan
   $marg_hierarchy         = 0                           unless defined $marg_hierarchy;
   $masshierarchy          = "normal"                    unless defined $masshierarchy;
   $step_freepar1          = 1                            unless defined $step_freepar1;   # of points for each job param1
}

# # 1D fit - sinsqth13
if(($freepar0 eq "mixing13") and ($freepar1 eq ""))
{
   $tag = "${tag}_${freepar0}";

   $nexpts_marg            = 10000                        unless defined $nexpts_marg;     # of toys
   $minfreepar0            = 0.007                          unless defined $minfreepar0;     # Minimum free parameter allowed value
   $maxfreepar0            = 0.053                      unless defined $maxfreepar0;     # Maximum free parameter allowed value 
   $npt_freepar0           = 201                         unless defined $npt_freepar0;    # of free parameter points to scan
   $minfreepar1            = 0.                          unless defined $minfreepar1;     # Minimum free parameter allowed value
   $maxfreepar1            = 0.                          unless defined $maxfreepar1;     # Maximum free parameter allowed value 
   $npt_freepar1           = 1                           unless defined $npt_freepar1;    # of free parameter points to scan
   $marg_hierarchy         = 0                           unless defined $marg_hierarchy;
   $masshierarchy          = "normal"                    unless defined $masshierarchy;
   $step_freepar0          = 1;#5                unless defined $step_freepar0;   # of points for each job param0
   $step_freepar1          = 1                            unless defined $step_freepar1;   # of points for each job param1
   $wqueue                 = "long";#"long -M 8192";
}

# # 1D fit - sinsqth23
if(($freepar0 eq "mixing23") and ($freepar1 eq ""))
{
   $tag = "${tag}_${freepar0}";

   if($use_reactors == 1)
   {
      $nexpts_marg            = 40000                        unless defined $nexpts_marg;
      $step_freepar0          = 1;
      $wqueue                 = "long";
      $npt_freepar0           = 100;
   }
   else
   {
      $nexpts_marg            = 80000                        unless defined $nexpts_marg;
      $step_freepar0          = 1;
      $wqueue                 = "long -M 8192";
      $npt_freepar0           = 100;
   }
   $minfreepar0            = 0.3    unless defined $minfreepar0;     # Minimum free parameter allowed value
   $maxfreepar0            = 0.7    unless defined $maxfreepar0;     # Maximum free parameter allowed value 
   $minfreepar1            = 0.                          unless defined $minfreepar1;     # Minimum free parameter allowed value
   $maxfreepar1            = 0.                          unless defined $maxfreepar1;     # Maximum free parameter allowed value 
   $npt_freepar1           = 1                           unless defined $npt_freepar1;    # of free parameter points to scan
   $marg_hierarchy         = 0                           unless defined $marg_hierarchy;
   $masshierarchy          = "normal"                    unless defined $masshierarchy;
   $step_freepar1          = 1                            unless defined $step_freepar1;   # of points for each job param1
}

# # 1D fit - dmsq23
if(($freepar0 eq "dmsq23") and ($freepar1 eq ""))
{
   $tag = "${tag}_${freepar0}";

   if($use_reactors == 1)
   {
      $nexpts_marg            = 40000                        unless defined $nexpts_marg;
      $step_freepar0          = 1;
      $wqueue                 = "long";
      $npt_freepar0           = 100;
   }
   else
   {
      $nexpts_marg            = 80000                        unless defined $nexpts_marg;
      $step_freepar0          = 1;
      $wqueue                 = "long -M 8192";
      $npt_freepar0           = 100;
   }
   $minfreepar0            = 2.3e-3    unless defined $minfreepar0;     # Minimum free parameter allowed value
   $maxfreepar0            = 2.7e-3    unless defined $maxfreepar0;     # Maximum free parameter allowed value 
   $minfreepar1            = 0.                          unless defined $minfreepar1;     # Minimum free parameter allowed value
   $maxfreepar1            = 0.                          unless defined $maxfreepar1;     # Maximum free parameter allowed value 
   $npt_freepar1           = 1                           unless defined $npt_freepar1;    # of free parameter points to scan
   $marg_hierarchy         = 0                           unless defined $marg_hierarchy;
   $masshierarchy          = "normal"                    unless defined $masshierarchy;
   $step_freepar1          = 1                            unless defined $step_freepar1;   # of points for each job param1
}

# # 2D fit - sinsqth13 Vs dcp
if((($freepar0 eq "mixing13") and ($freepar1 eq "deltacp")) or (($freepar0 eq "deltacp") and ($freepar1 eq "mixing13")))
{
   $tag = "${tag}_${freepar0}_${freepar1}";

   $nexpts_marg = 10000;
   if($freepar0 eq "deltacp")
   {
      $freepar0 = "mixing13";
      $freepar1 = "deltacp";
   }

   if($use_reactors == 1)
   {
      $minfreepar0         = 0.015     unless defined $minfreepar0;     # Minimum free parameter allowed value
      $maxfreepar0         = 0.036     unless defined $maxfreepar0;     # Maximum free parameter allowed value 
      $npt_freepar0        = 81        unless defined $npt_freepar0;    # of free parameter points to scan
   }
   else
   {
      $minfreepar0         = 0.007     unless defined $minfreepar0;     # Minimum free parameter allowed value
      $maxfreepar0         = 0.053     unless defined $maxfreepar0;     # Maximum free parameter allowed value 
      $npt_freepar0        = 81        unless defined $npt_freepar0;    # of free parameter points to scan
   }

   $minfreepar1       = -3.14159265358979312e+00  unless defined $minfreepar1;   # Minimum free parameter allowed value
   $maxfreepar1       = +3.14159265358979312e+00  unless defined $maxfreepar1;   # Maximum free parameter allowed value 
   $npt_freepar1      = 51                        unless defined $npt_freepar1; # of free parameter points to scan
   $marg_hierarchy    = 0                         unless defined $marg_hierarchy;
   $masshierarchy     = "normal"                  unless defined $masshierarchy;
   $step_freepar0     = 3                         unless defined $step_freepar0;   # of points for each job param0
   $step_freepar1     = 2                         unless defined $step_freepar1;   # of points for each job param1
   $wqueue            = "long";
}

# # 2D fit - sinsqth23 Vs dmsq23
if((($freepar0 eq "mixing23") and ($freepar1 eq "dmsq23")) or (($freepar0 eq "dmsq23") and ($freepar1 eq "mixing23")))
{
   $tag = "${tag}_${freepar0}_${freepar1}";

   $nexpts_marg = 10000;
   if($freepar0 eq "dmsq23")
   {
      $freepar0 = "mixing23";
      $freepar1 = "dmsq23";
   }
   $minfreepar0            = 0.3                        unless defined $minfreepar0;     # Minimum free parameter allowed value
   $maxfreepar0            = 0.7                        unless defined $maxfreepar0;     # Maximum free parameter allowed value 
   $npt_freepar0           = 81;#10;#81                         unless defined $npt_freepar0;    # of free parameter points to scan
   $minfreepar1            = 2.3e-3                  unless defined $minfreepar1;     # Minimum free parameter allowed value
   $maxfreepar1            = 2.7e-3                   unless defined $maxfreepar1;     # Maximum free parameter allowed value 
   $npt_freepar1           = 21;#10;#21                        unless defined $npt_freepar1;    # of free parameter points to scan
   $marg_hierarchy         = 0                          unless defined $marg_hierarchy;
   $masshierarchy          = "normal"                   unless defined $masshierarchy;
   $step_freepar0          = 3;#10;#4                unless defined $step_freepar0;   # of points for each job param0
   $step_freepar1          = 2;#10;#1                            unless defined $step_freepar1;   # of points for each job param1
   $wqueue                  = "long";
}

					               
$tweak_systematics      = 1                            unless defined $tweak_systematics;
$prior_prob_nh          = 0.5                          unless defined $prior_prob_nh;
$rethrow_unphysical     = 1                            unless defined $rethrow_unphysical;

#$file_prior             = "../../inputs/priors/joint_T2Kreact_run14/valor/Priors_T2Kreact_run14_Valor.root" unless defined $file_prior;
$file_prior             = "" unless defined $file_prior;

$job_dir                = "."                  unless defined $job_dir;
$softw_dir              = $ENV{'T2KOSCANA'}    unless defined $softw_dir;
$fmwk_dir               = $ENV{'VALOR_FMWK'}   unless defined $fmwk_dir;
$dmsqscheme             = "auto"               unless defined $dmsqscheme;
$mixparamchoice         = "sinsqtheta"         unless defined $mixparamchoice;
$mixparamoctant         = "two"                unless defined $mixparamoctant;

$use_reactors           = 0                    unless defined $use_reactors;#1
$queue                  = 0                    unless defined $queue;
if( !defined $cput ) {
    #takes approx 0.04 sec per sample
    $sec = int ( $step_freepar0 *  $step_freepar1 * $nexpts_marg * 0.22 );
    $sec_mins = $sec % 3600;
    $seconds = $sec % 60;
    $minutes = int($sec_mins/60);
    $hours = int($sec/3600);
    
    if($hours > 1){
        $cput = "$hours:$minutes:$seconds";
    }
    else{
        $cput = "01:00:00";
    }
}
 
mkpath ($job_dir, {verbose => 1, mode=>0777}); 
die("$job_dir doesn't exist") unless -d $job_dir;

# Print job arguments to file
($sec,$min,$hour,$mday,$mon,$year,$wday,$yday,$isdst) = localtime();
$year = $year+1900;
$mon  = $mon+1;

open(ARGS,">$job_dir/job_args_$year-$mon-$mday.txt");
print ARGS "#!/bin/bash \n";
print ARGS "# \n";
print ARGS "# Submit toys $year/$mon/$mday \n";
print ARGS "# \n";
print ARGS "\$T2KOSCANA/production/submit_build_marg_toys_joint \\\n";
print ARGS "--Resource               '$resource' \\\n";                              
print ARGS "--tag                    '$tag' \\\n";                
print ARGS "--config-file            '$config_file' \\\n";        
print ARGS "--fit-param-list         '$fitparamlist' \\\n";       
print ARGS "--dm23sq-nh               $dm23sq_nh \\\n";          
print ARGS "--dm12sq-nh               $dm12sq_nh \\\n";          
print ARGS "--mix23-nh                $mix23_nh \\\n";           
print ARGS "--mix13-nh                $mix13_nh \\\n";           
print ARGS "--mix12-nh                $mix12_nh \\\n";           
print ARGS "--deltacp-nh              $deltacp_nh \\\n";         
print ARGS "--dm23sq-ih               $dm23sq_ih \\\n";          
print ARGS "--dm12sq-ih               $dm12sq_ih \\\n";          
print ARGS "--mix23-ih                $mix23_ih \\\n";           
print ARGS "--mix13-ih                $mix13_ih \\\n";           
print ARGS "--mix12-ih                $mix12_ih \\\n";           
print ARGS "--deltacp-ih              $deltacp_ih \\\n";         
print ARGS "--betaBar                 $betaBar \\\n";            
print ARGS "--freepar0               '$freepar0' \\\n";           
print ARGS "--minfreepar0             $minfreepar0 \\\n";        
print ARGS "--maxfreepar0             $maxfreepar0 \\\n";        
print ARGS "--npt-freepar0            $npt_freepar0 \\\n";       
print ARGS "--freepar1                $freepar1 \\\n";           
print ARGS "--minfreepar1             $minfreepar1 \\\n";        
print ARGS "--maxfreepar1             $maxfreepar1 \\\n";        
print ARGS "--npt-freepar1            $npt_freepar1 \\\n";       
print ARGS "--nexpts-marg             $nexpts_marg \\\n";        
print ARGS "--step-freepar0           $step_freepar0 \\\n";      
print ARGS "--step-freepar1           $step_freepar1 \\\n";      
print ARGS "--tweak-systematics       $tweak_systematics \\\n";  
print ARGS "--marginalize-hierarchy   $marg_hierarchy \\\n";     
print ARGS "--prior-prob-nh           $prior_prob_nh \\\n";      
print ARGS "--rethrow-unphysical      $rethrow_unphysical \\\n"; 
print ARGS "--cpu-time                $cput \\\n";               
print ARGS "--job-dir                '$job_dir' \\\n";            
print ARGS "--softw-dir              '$softw_dir' \\\n";          
print ARGS "--dmsq-scheme            '$dmsqscheme' \\\n";         
print ARGS "--hierarchy              '$masshierarchy' \\\n";      
print ARGS "--mix-param-choice       '$mixparamchoice' \\\n";     
print ARGS "--use-reactors            $use_reactors \\\n";       
print ARGS "--file-prior             '$file_prior' \\\n";         
print ARGS "--fmwk-dir               '$fmwk_dir' \\\n";           
close(ARGS); 

$fileid=0;

$imin0_p1=0; # param 0
$imin1_p1=0; # param 1

$ijob=0;
$irun=0;

for($imin0 = 0; $imin0 < $npt_freepar0; $imin0 = $imin0_p1) { 
    for($imin1 = 0; $imin1 < $npt_freepar1; $imin1 = $imin1_p1) {
	
	$imin0_p1 = $imin0 + $step_freepar0;
	$imin1_p1 = $imin1 + $step_freepar1;
    
	$imax0 = $imin0 + $step_freepar0-1;
	$imax1 = $imin1 + $step_freepar1-1;
    
	# if exceed maximum allowed number set it to limit
	if( $imax0 >= $npt_freepar0 ){
	    $imax0 = $npt_freepar0-1; # loop in build_marg_toy is min <= bin <= max
	}
	if( $imax1 >= $npt_freepar1 ){
	    $imax1 = $npt_freepar1-1; # loop in build_marg_toy is min <= bin <= max
	}
        
	# loop in build_marg_toy is min <= bin <= max, avoid repetition of the last bin
	if( $imin0_p1 == $imin0 ){
	    last;
	}
	if( $imin1_p1 == $imin1 ){
	    last;
	}
	
	print "/////////////////////////////// \n \n";
	
	print "File output ID: $fileid $seed \n";
	print "   - sub-range param 0: $imin0 - $imax0 \n"; 
	print "   - sub-range param 1: $imin1 - $imax1 \n"; 
	print "\n";
	
	$program = "root2k ";
	
	$arguments = " -l -b -q \'$softw_dir/macros/marginalization/build_marg_toys_joint.C($fileid,$imin0,$imax0,$imin1,$imax1,\"$tag\",\"$config_file\",\"$fitparamlist\",$mix12_nh,$mix13_nh,$mix23_nh,$deltacp_nh,$dm12sq_nh,$dm23sq_nh,$mix12_ih,$mix13_ih,$mix23_ih,$deltacp_ih,$dm12sq_ih,$dm23sq_ih,$betaBar,\"$freepar0\",$minfreepar0,$maxfreepar0,$npt_freepar0,\"$freepar1\",$minfreepar1,$maxfreepar1,$npt_freepar1,$nexpts_marg,$tweak_systematics,$marg_hierarchy,$prior_prob_nh,$rethrow_unphysical,\"$dmsqscheme\",\"$masshierarchy\",\"$mixparamchoice\",\"$mixparamoctant\",$seed,$use_reactors)\'";
		
	$command = "$program $arguments";
	print "$command \n";
	
	$fileid = $fileid+1;
	
	#
