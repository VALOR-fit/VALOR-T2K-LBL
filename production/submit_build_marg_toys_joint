    $program = "root2k ";
    
    $arguments = " -l -b -q \'$softw_dir/macros/marginalization/build_marg_toys_joint.C($fileid,$imin0,$imax0,$imin1,$imax1,\"$tag\",\"$config_file\",\"$fitparamlist\",$mix12_nh,$mix13_nh,$mix23_nh,$deltacp_nh,$dm12sq_nh,$dm23sq_nh,$mix12_ih,$mix13_ih,$mix23_ih,$deltacp_ih,$dm12sq_ih,$dm23sq_ih,$betaBar,\"$freepar0\",$minfreepar0,$maxfreepar0,$npt_freepar0,\"$freepar1\",$minfreepar1,$maxfreepar1,$npt_freepar1,$nexpts_marg,$tweak_systematics,$marg_hierarchy,$prior_prob_nh,$rethrow_unphysical,\"$dmsqscheme\",\"$masshierarchy\",\"$mixparamchoice\",\"$mixparamoctant\",\"$file_prior\",$use_reactors)\'";
    
    $command = "$program $arguments";
    print "$command \n";
    
    
    #
    # ETH (Monch cluster), $job_dir not used, $tag gives path/name of output file
    #
    if($resource eq "ETH-Monch") {
      open(PBS, ">/mnt/lnec/davides/VALOR/sbatch_files/run_fit-$fileid.sbatch") or die("Can not create the sbatch script");
      print PBS "#!/bin/bash -l  \n";
      #print PBS "#SBATCH --partition=dphys_compute_wk  \n";
      #print PBS "#SBATCH --partition=dphys_compute  \n";
      print PBS "#SBATCH --partition=dphys_compute --mem-per-cpu=2000  \n"; # in MB. Same as dphys_largemem default RAM
      #print PBS "#SBATCH --partition=dphys_largemem --mem-per-cpu=2000  \n";
      print PBS "#SBATCH --nodes=1  \n";
      print PBS "#SBATCH --ntasks-per-node=1  \n";
      print PBS "#SBATCH --output=/mnt/lnec/davides/VALOR/outputs/out.%j.o  \n";
      print PBS "#SBATCH --error=/mnt/lnec/davides/VALOR/outputs/out.%j.e  \n";
      #print PBS "#SBATCH --exclusive \n";
      print PBS "$command \n";
      close(PBS);
      #`sbatch -t 23:59:00 /mnt/lnec/davides/VALOR/sbatch_files/run_fit-$fileid.sbatch`;
      #`sbatch -t 2-00:00:00 /mnt/lnec/davides/VALOR/sbatch_files/run_fit-$fileid.sbatch`;
      `sbatch -t 09:59:00 /mnt/lnec/davides/VALOR/sbatch_files/run_fit-$fileid.sbatch`; # 2D sinsqth13 Vs dcp 2x4 steps
      #`sbatch -t 05:59:00 /mnt/lnec/davides/VALOR/sbatch_files/run_fit-$fileid.sbatch`; # not enough for 2D sinsqth13 Vs dcp 2x4 steps
      #`sbatch -t 01:59:00 /mnt/lnec/davides/VALOR/sbatch_files/run_fit-$fileid.sbatch`; # 1D
      #`sbatch -t 00:05:00 /mnt/lnec/davides/VALOR/sbatch_files/run_fit-$fileid.sbatch`;
    }
    
    #
    # ETH (Brutus cluster)
    #
    if($resource eq "ETH-Brutus") {
      open(PBS, ">$job_dir/$tag-$ijob.sh") or die("Can not create the PBS batch script");
      print PBS "#!/bin/bash \n";
      #print PBS "#PBS -N $tag-$fileid \n";
      #print PBS "#PBS -l cput=$cput \n";
      #print PBS "#PBS -o $job_dir/$tag-$fileid.pbs.out \n";
      #print PBS "#PBS -e $job_dir/$tag-$fileid.pbs.err \n";
      #print PBS "#PBS -q prod \n";
      #print PBS "#PBS -l walltime=$cput \n";
      #print PBS "cd $job_dir \n";
      #print PBS "source $softw_dir/setup/setup_at_ral.sh $softw_dir\n";
      print PBS "$command \n";
      close(PBS);
      `bsub -W 3:59 < $job_dir/$tag-$ijob.sh`;
      #`bsub -W 1:59 < $job_dir/$tag-$ijob.sh`;
      #`bsub -W 0:29 < $job_dir/$tag-$ijob.sh`;
    }
    
    
    
    #
    # RAL
    #
    if($resource eq "RAL") {
      $fullprogram = `which root2k`;
      $fullprogram = `readlink -m $fullprogram`;
      $arguments =~ s/\"/\\\"/g;        # All double quotes must be escaped for Condor
      $arguments =~ s/\'//g;            # and apparently single quotes are unnecessary but break it
      open(CND, ">$job_dir/$tag-$fileid.condor") or die("Cannot create the Condor batch script");
      print CND "Executable               = $fullprogram \n";
      print CND "Arguments                = $arguments \n";
      print CND "Error                    = $job_dir/toys_proc_$tag-${fileid}_\$\(Process\).err \n";
      print CND "Output                   = $job_dir/toys_proc_$tag-${fileid}_\$\(Process\).out \n";
      print CND "Universe                 = vanilla \n";
      print CND "Getenv                   = True \n";
      print CND "should_transfer_files    = YES \n";
      print CND "when_to_transfer_output  = ON_EXIT \n";
      print CND "\nqueue\n";
      
      close(CND);
      `condor_submit $job_dir/$tag-$fileid.condor`;
      
      $ijob++;
    }
    
    #
    # Oxford
    #
    if($resource eq "Oxford") {
      open(PBS, ">$job_dir/$tag-$fileid.pbs") or die("Can not create the PBS batch script");
      print PBS "#!/bin/bash \n";
      print PBS "#PBS -N $tag-$fileid \n";
      print PBS "#PBS -l cput=$cput \n";
      print PBS "#PBS -o $job_dir/$tag-$fileid.pbs.out \n";
      print PBS "#PBS -e $job_dir/$tag-$fileid.pbs.err \n";
      if($queue ne "0")
      {
        print PBS "#PBS -q $queue \n";
      }
      print PBS "cd $job_dir \n";
      print PBS "source $softw_dir/setup/setup_at_cvmfs.sh $softw_dir $fmwk_dir\n";
      print PBS "$command \n";
      close(PBS);
      `qsub $job_dir/$tag-$fileid.pbs`;
    }
    #
    # Grid
    #
    if($resource eq "Grid") {
      print "Not supported just yet!\n";
    }
    #
    # interactive
    #
    if($resource eq "interactive") {
      system($command);
    }
    
    $fileid = $fileid+1;
    
  } # freepar 0
} # freepar 1

