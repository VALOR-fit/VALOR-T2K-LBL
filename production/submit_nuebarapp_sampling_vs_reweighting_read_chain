#!/usr/bin/perl

#-------------------------------------------------------------------------------------------------------------------------------
# Submit a batch of build_marg_toys_joint.C jobs
#
# Inputs
#  --resource               : Computer resource, <ETH-Monch, RAL, Oxford, Grid, interactive>. Default: interactive.
# TODO
# F. Bench
#-------------------------------------------------------------------------------------------------------------------------------
#

use File::Path;

$iarg=0;
foreach (@ARGV) {
  if($iarg % 2 == 1) {$iarg++; next;}
  if   ($_ eq '--resource'               ) { $resource              = $ARGV[$iarg+1]; }
  elsif($_ eq '--tag'                    ) { $tag                   = $ARGV[$iarg+1]; }
  elsif($_ eq '--cput'                   ) { $cput                  = $ARGV[$iarg+1]; }
  elsif($_ eq '--job-dir'                ) { $job_dir               = $ARGV[$iarg+1]; }
  elsif($_ eq '--infilename-pattern'     ) { $filein                = $ARGV[$iarg+1]; }
  elsif($_ eq '--infilename_data'        ) { $filein_data           = $ARGV[$iarg+1]; }
  elsif($_ eq '--fakefilename-pattern'   ) { $filein_fake           = $ARGV[$iarg+1]; }
  elsif($_ eq '--test-statistic'         ) { $test_statistic        = $ARGV[$iarg+1]; }
  elsif($_ eq '--read-nevents'           ) { $read_nevents          = $ARGV[$iarg+1]; }
  elsif($_ eq '--start-nevents'          ) { $start_nevents         = $ARGV[$iarg+1]; }
  elsif($_ eq '--ntoys-fakedata-file'    ) { $ntoys_fakedata_file   = $ARGV[$iarg+1]; }
  elsif($_ eq '--chisq-min'              ) { $chisq_min             = $ARGV[$iarg+1]; }
  elsif($_ eq '--run-start'              ) { $run_start             = $ARGV[$iarg+1]; }
  elsif($_ eq '--nruns'                  ) { $nruns                 = $ARGV[$iarg+1]; }
  else {
    print "Unrecognised argument ".$_."\n"; exit;
  }
  $iarg++;
}

$resource            = "interactive"               unless defined $resource;
$job_dir             = "$ENV{'PWD'}"               unless defined $job_dir;
$tag                 = "test"                      unless defined $tag;
$filein              = "fit*beta=[b]_batch[i]*.root" unless defined $filein;
$cput                = "24:00:00"                  unless defined $cput;
$softw_dir           = $ENV{'T2KOSCANA'}           unless defined $softw_dir;
$fmwk_dir            = $ENV{'VALOR_FMWK'}          unless defined $fmwk_dir;
$filein_data         = ""                          unless defined $filein_data;
$filein_fake         = "/scratch/fbench/nuebarapp_R1-9d/weighted/fakedata_toys/MCsampling_vs_reweighting/3500k/AsimovA_store_all_50000_toys_0_[b]_[i]-[i].root" unless defined $filein_fake;
$test_statistic      = ""                          unless defined $test_statistic;
$read_nevents        = -1                          unless defined $read_nevents;
$start_nevents       = 0                           unless defined $start_nevents;
$ntoys_fakedata_file = 50000                       unless defined $ntoys_fakedata_file;
$chisq_min           = 0                           unless defined $chisq_min;
$run_start           = 0                           unless defined $run_start;
$nruns               = 70                          unless defined $nruns;


mkpath ($job_dir, {verbose => 1, mode=>0777});
die("$job_dir doesn't exist") unless -d $job_dir;

for (my $irun=0; $irun < $nruns; $irun++) {
    for (my $beta=0; $beta < 2; $beta++) {

        $filein_partial = $filein =~ s/\[b\]/${beta}/r;
        $filein_use = $filein_partial =~ s/\[i\]/${irun}/r;

        $command = "python $softw_dir/macros/studies/nuebarapp/sampling_vs_reweighting_read_chain.py --infilename $filein_use --beta $beta --fakefilename-pattern $filein_fake --infilename_data $filein_data --tag ${tag}_batch${irun} --test-statistic $test_statistic --ntoys-fakedata-file $ntoys_fakedata_file --chisq-min $chisq_min";
        print "\nSubmitting:\n$command \n";

        #
        # Liverpool_Slurm
        #
        if($resource eq "Liverpool_Slurm") {
          open(Slurm, ">$job_dir/$tag-$beta-$irun.slurm") or die("Can not create the Slurm batch script");
          print Slurm "#!/bin/bash \n";
          print Slurm "#SBATCH -J $tag-$beta-$irun \n";
          print Slurm "#SBATCH -o $job_dir/$tag-$beta-$irun.slurm.out \n";
          print Slurm "#SBATCH -e $job_dir/$tag-$beta-$irun.slurm.err \n";
          print Slurm "#SBATCH -t $cput \n";
          print Slurm "cd $job_dir \n";
          print Slurm "source $softw_dir/setup/setup_at_cvmfs.sh $softw_dir $fmwk_dir\n";
          print Slurm "/usr/bin/time $command \n";
          close(Slurm);
          `sbatch -p compute $job_dir/$tag-$beta-$irun.slurm`;
        }
        #
        # cedar
        #
        if($resource eq "cedar") {
            open(PBS, ">$job_dir/$tag-$beta-$irun.slurm") or die("Cannot create the Slurm batch script");
            print PBS "#!/bin/bash \n";
            print PBS "#SBATCH -J $tag-$beta-$irun \n";
            print PBS "#SBATCH --time=$cput \n";
            print PBS "#SBATCH --account=rpp-tanaka-ab \n";
            print PBS "#SBATCH --mem=7000M \n";
            print PBS "#SBATCH -o $job_dir/$tag-$beta-$irun-slurm.out \n";
            print PBS "#SBATCH -e $job_dir/$tag-$beta-$irun-slurm.err \n";
            print PBS "cd $job_dir \n";
            print PBS "source $softw_dir/setup/setup_at_cedar.sh $softw_dir $fmwk_dir \n";
            print PBS "time $command \n";
            close(PBS);
            `sbatch $job_dir/$tag-$beta-$irun.slurm`;
        }

        #
        # interactive
        #
        if($resource eq "interactive") {
            system($command);
        }
    } # beta
} # irun
