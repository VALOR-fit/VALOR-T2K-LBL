#!/usr/bin/perl

#
#---------------------------------------------------------------------------------------------------- 
# Bulk-delete of batch farm jobs
#
# Inputs
#  --resource          : <RAL, IN2P3, Oxford, Grid>
#  --user              : Username  
#  --min-job-id        : Minimum job number in range of jobs to be deleted
#  --max-job-id        : Maximum job number in range of jobs to be deleted
#  --job-name-template : Use only when the job name is used instead of an integer job id.
#                        This applies to IN2P3.
#                        This argument is not necessary for RAL.
#                        It is assumed here that job names are formed by including a job id number 
#                        in this template. For example, if jobs are named as `fit-100', `fit-101', 
#                        `fit-102',... then specify `fit-%3d' as the job name template.
#
# Costas Andreopoulos
#---------------------------------------------------------------------------------------------------- 
#

$iarg=0;
foreach (@ARGV) {
  if($_ eq '--resource'          ) { $resource        = $ARGV[$iarg+1]; }
  if($_ eq '--user'              ) { $user            = $ARGV[$iarg+1]; }
  if($_ eq '--min-job-id'        ) { $minjobid        = $ARGV[$iarg+1]; }
  if($_ eq '--max-job-id'        ) { $maxjobid        = $ARGV[$iarg+1]; }
  if($_ eq '--job-name-template' ) { $jobnametemplate = $ARGV[$iarg+1]; }
   $iarg++;
}
die("** Aborting [You need to specify the resource using the --resource option]")
unless defined $resource;
die("** Aborting [You need to specify your username using the --user option]")
unless defined $user;
die("** Aborting [You need to specify a minimum job ID using the --min-job-id option]")
unless defined $minjobid;
die("** Aborting [You need to specify a maximum job ID using the --max-job-id option]")
unless defined $maxjobid;

$jobnametemplate = "" unless defined $jobnametemplate;

#
# RAL
#

if($resource eq "RAL") {
  @myjobs = `qstat -u $user`;

  #
  # At RAL the jobs are listed as:
  #                                                                         Req'd  Req'd   Elap
  # Job ID               Username Queue    Jobname          SessID NDS   TSK Memory Time  S Time
  # -------------------- -------- -------- ---------------- ------ ----- --- ------ ----- - -----
  # 6665082.heplnx20     candreop prod     geniefc-0-14-71.  12549   --   --  500mb 05:00 R 00:18  
  # 6665472.heplnx20     candreop prod     geniefc-0-18-25.  14191   --   --  500mb 05:00 R 00:17
  #
  # Try to extract the integer part of the Job ID and delete jobs with Job ID in the input range
  #

  foreach(@myjobs) {
    chomp($_);
    if( /$user/ ) {
      /(\d+)/;
      $jobid = $1;
      if($jobid >= $minjobid && $jobid <= $maxjobid) {
           print "deleting $user\'s job: $jobid\n";
           `qdel $jobid`;
      }#job number in input range
    }#username matched
  }#loop over jobs
}#RAL

#
# IN2P3
#

if($resource eq "IN2P3") {

  @myjobs = `qjob -l`;

  #
  # At IN2P3 the jobs are listed as:
  #
  # user            jobname       status            time              worker        cputime       tmpsize     memsize    scratchsize prio jobid             pid      platform CPUBound
  # ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
  # jelena@ccali02  geniestat-20  RUNNING  RUNNING  01/21/11-15:10:53 T.ccwl0090  645489/1500000  0/  5000   182/  2200     1/   500 1010 30700.ccwl0090    30832    LINUX          
  #
  # Try to extract the jobname and delete jobs with jobnames that match any of sprintf($jobnametemplate,$i) where $i is in the in the input range
  #

  foreach(@myjobs) {
    chomp($_);
    if( /$user/ ) {
       /^\S*\s*(\S+)\s*/;
       $jobid = $1;
       for($i = $minjobid; $i <= $maxjobid; $i++) {
	   $x = sprintf("$jobnametemplate",$i);
           if($jobid eq sprintf("$jobnametemplate",$i)) {
              print "deleting $user\'s job: $jobid\n";
             `qdel $jobid`;
           }#job id matched
       }#i
    }#username matched
  }#loop over jobs
}#IN2P3

#
# Oxford
#
if($resource eq "Oxford") {
  print "Not supported just yet!\n";
}#Oxford

