#!/usr/bin/perl

use File::Path;

$iarg=0;
foreach (@ARGV) {
  if($iarg % 2 == 1) {$iarg++; next;}

  if   ($_ eq '--tag'       ) { $tag        = $ARGV[$iarg+1]; }
  elsif($_ eq '--xml-params') { $xml_params = $ARGV[$iarg+1]; }
  elsif($_ eq '--ntoys-job' ) { $ntoys_job  = $ARGV[$iarg+1]; }
  elsif($_ eq '--njobs'     ) { $njobs      = $ARGV[$iarg+1]; }
  elsif($_ eq '--init-seed' ) { $init_seed  = $ARGV[$iarg+1]; }
	elsif($_ eq '--resource'  ) { $resource   = $ARGV[$iarg+1]; }
  elsif($_ eq '--cpu-time'  ) { $cput       = $ARGV[$iarg+1]; }
  elsif($_ eq '--job-dir'   ) { $job_dir    = $ARGV[$iarg+1]; }
  elsif($_ eq '--softw-dir' ) { $softw_dir  = $ARGV[$iarg+1]; }
  elsif($_ eq '--fmwk-dir'  ) { $fmwk_dir   = $ARGV[$iarg+1]; }


  else {
      print "Unrecognised argument ".$_."\n"; exit;
  }
  $iarg++;
}

$softw_dir  = $ENV{'T2KOSCANA'}                                  unless defined $softw_dir;
$fmwk_dir   = $ENV{'VALOR_FMWK'}                                 unless defined $fmwk_dir;
$tag        = "ellipse_Run1_9"                                   unless defined $tag;
$xml_params = "$softw_dir/macros/spectra/bieventplot_params.xml" unless defined $xml_params;
$ntoys_job  = 1000                                               unless defined $ntoys_job;
$njobs      = 100                                                unless defined $njobs;
$init_seed  = 1                                                  unless defined $init_seed;
$resource   = "interactive"                                      unless defined $resource;
$cput       = "05:00:00"                                         unless defined $cput;
$job_dir    = "."                                                unless defined $job_dir;

mkpath ($job_dir, {verbose => 1, mode=>0777}); 
die("$job_dir doesn't exist") unless -d $job_dir;


for($ijob = 0; $ijob < $njobs; $ijob++) {
	$seed = $init_seed + $ijob * $ntoys_job;
	$out_tag = "${tag}_job${ijob}";
	
	print "/////////////////////////////// \n \n";
	print "File output ID: $ijob \n";
	print "\n";
	
	$program = "root2k ";
	
	$arguments = " -l -b -q \'$softw_dir/macros/spectra/bievent_build.C($ntoys_job,$seed,\"$out_tag\",\"$xml_params\")\'";

	$command = "$program $arguments";
	print "$command \n";

	#
	# Liverpool_Slurm
	#
	if($resource eq "Liverpool_Slurm") {
		 open(Slurm, ">$job_dir/$out_tag.slurm") or die("Can not create the Slurm batch script");
		 print Slurm "#!/bin/bash \n";
		 print Slurm "#SBATCH -J $out_tag \n";
		 print Slurm "#SBATCH -o $job_dir/$out_tag.slurm.out \n";
		 print Slurm "#SBATCH -e $job_dir/$out_tag.slurm.err \n";
		 print Slurm "#SBATCH -t $cput \n";
		 print Slurm "#SBATCH --mem=7G \n";  #     TODO: test memory usage
		 print Slurm "cd $job_dir \n";
		 print Slurm "source $softw_dir/setup/setup_at_cvmfs.sh $softw_dir $fmwk_dir\n";
		 print Slurm "/usr/bin/time $command \n";
		 close(Slurm);
		 `sbatch -p compute $job_dir/$out_tag.slurm`;
	}

	#
	# interactive
	#
	if($resource eq "interactive") {
	    system($command);
	}

} # ijob

