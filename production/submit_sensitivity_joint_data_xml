#!/usr/bin/perl


#-------------------------------------------------------------------------------------------------------------------------------
# Submit a batch of run_fit.C jobs
#
# Inputs
#  --xmlfile                : Input xml file with all the toys
#  --resource               : Computer resource, <RAL, Oxford, Grid, interactive>. Default: interactive.
#  --tag                    : Tag for output files. Default: toyexptfits.
#  --nruns                  : Number of runs (jobs) to submit. Default: 1.
#  --nexpts                 : Number of toy MC expt fits per run. Default: 1000.
#  --cpu-time               : Required CPU time. Default: "6:00:00" for RAL, "11:50:00" for Oxford.
#  --stat-fluctuations      : include statistical fluctuation in toy MC expts
#  --tweak-systematics      : generate toy MC with randomized systematics
#  --store-toy-expts        : Store the generated toy MC expts? Default: No.
#  --store-bestfit-spectra  : Store the best-fit spectra? Default: No.
#  --fit-param-list         : Fit parameter list. Default: "nuosc3f_numudisapp_fix4+nuisance". See FitParamList.h for allowed options.
#  --fit-option             : Option passed to fitter. Default: "minuit".
#  --job-dir                : Directory for job scripts and outputs. Default: `pwd`.
#  --softw-dir              : Oscillation code top-level directory. Default: `pwd`.
#  --config-file            : Analysis configuration file from the config/ directory. Default: "analysis_configuration.xml"
#  --dmsq-scheme            : abs23 or fogli
#  --hierarchy              : normal or inverted
#  --mix-param-choice       : sinsq2theta or sinsqtheta
#  --mix-param-octant       : one or two
#  --dcp-value              : Number of pi to use as value of deltacp (when deltacp is not fit for). Default 0.
#
# C.Andreopoulos
#-------------------------------------------------------------------------------------------------------------------------------
#

use File::Path;

$iarg=0;
foreach (@ARGV) {
  if($_ eq '--resource'               ) { $resource              = $ARGV[$iarg+1]; }
  if($_ eq '--tag'                    ) { $tag                   = $ARGV[$iarg+1]; }
  if($_ eq '--cpu-time'               ) { $cput                  = $ARGV[$iarg+1]; }
  if($_ eq '--stat-fluctuations'      ) { $stat_fluct            = 1;              }
  if($_ eq '--tweak-systematics'      ) { $twk_systematics       = 1;              }
  if($_ eq '--store-toy-expts'        ) { $store_toy_expts       = 1;              }
  if($_ eq '--store-bestfit-spectra'  ) { $store_bestfit_spectra = 1;              }
  if($_ eq '--fit-param-list'         ) { $fitparamlist          = $ARGV[$iarg+1]; }
  if($_ eq '--fit-option'             ) { $fitoption             = $ARGV[$iarg+1]; }
  if($_ eq '--job-dir'                ) { $job_dir               = $ARGV[$iarg+1]; }
  if($_ eq '--softw-dir'              ) { $softw_dir             = $ARGV[$iarg+1]; }
  if($_ eq '--config-file'            ) { $config_file           = $ARGV[$iarg+1]; }
  if($_ eq '--dmsq-scheme'            ) { $dmsqscheme            = $ARGV[$iarg+1]; }
  if($_ eq '--hierarchy'              ) { $masshierarchy         = $ARGV[$iarg+1]; }
  if($_ eq '--mix-param-choice'       ) { $mixparamchoice        = $ARGV[$iarg+1]; }
  if($_ eq '--mix-param-octant'       ) { $mixparamoctant        = $ARGV[$iarg+1]; }
  #if($_ eq '--allow-2nu-unphysical'   ) { $apply_2nu_boundary    = 0;              }
  if($_ eq '--dcp-value'              ) { $dcp_value             = $ARGV[$iarg+1]; }

  if($_ eq '--reactor'             ) { $reactor            = $ARGV[$iarg+1]; }
  if($_ eq '--tolerance'           ) { $tolerance          = $ARGV[$iarg+1]; }
  if($_ eq '--param1'              ) { $param1             = $ARGV[$iarg+1]; }
  if($_ eq '--param2'              ) { $param2             = $ARGV[$iarg+1]; }
  if($_ eq '--min_bin_param1'      ) { $min_bin_param1     = $ARGV[$iarg+1]; }
  if($_ eq '--min_bin_param2'      ) { $min_bin_param2     = $ARGV[$iarg+1]; }
  if($_ eq '--max_bin_param1'      ) { $max_bin_param1     = $ARGV[$iarg+1]; }
  if($_ eq '--max_bin_param2'      ) { $max_bin_param2     = $ARGV[$iarg+1]; }

  if($_ eq '--xmlfile'             ) { $xmlfile            = $ARGV[$iarg+1]; }
  if($_ eq '--using-xmlfile'       ) { $using_xmlfile      = $ARGV[$iarg+1]; }
  
  $iarg++;
}
$resource               = "interactive"                          unless defined $resource;
$stat_fluct             = 1                                      unless defined $stat_fluct;
$twk_systematics        = 1                                      unless defined $twk_systematics;
$store_toy_expts        = 1                                      unless defined $store_toy_expts;
$store_bestfit_spectra  = 0                                      unless defined $store_bestfit_spectra;
#$fitparamlist           = "nuosc3f_numudisapp_fix4+nuisance"     unless defined $fitparamlist;
#$fitparamlist           = "nuosc3f_12constrain+nuisance"         unless defined $fitparamlist;
$fitparamlist           = "nuosc3f_12fix+nuisance"         unless defined $fitparamlist;
#$fitparamlist           = "nuosc3f_12fix"                    unless defined $fitparamlist;
$fitoption              = "minuit+hesse"                               unless defined $fitoption;
#$fitoption              = "minuit+minos"                               unless defined $fitoption;
$tag                    = "exclusion_data_IH"                          unless defined $tag;
#$job_dir                = `pwd`                                  unless defined $job_dir;
$job_dir                = "."                                  unless defined $job_dir;
$softw_dir              = $ENV{'T2KOSCANA'}                    unless defined $softw_dir;
$config_file            = "analysis_configuration_test.xml"           unless defined $config_file;
#$config_file            = "analysis_configuration_Run4.xml"           unless defined $config_file;
#$config_file            = "analysis_configuration_run1to6.xml"           unless defined $config_file; 
$dmsqscheme             = "abs23"                                unless defined $dmsqscheme;
$masshierarchy          = "inverted"                               unless defined $masshierarchy;
$mixparamchoice         = "sinsqtheta"                           unless defined $mixparamchoice;
$mixparamoctant         = "one"                                  unless defined $mixparamoctant;
#$apply_2nu_boundary     = 1                                      unless defined $apply_2nu_boundary;
$dcp_value              = 0                                      unless defined $dcp_value;

$reactor                = 1                                      unless defined $reactor;
$tolerance              = 0.01                                   unless defined $tolerance;
$param1                 = "deltacp"                              unless defined $param1;
$param2                 = "none"                                 unless defined $param2;
#$param2                 = "mixing13"                                 unless defined $param2;
$min_bin_param1          = 1                                     unless defined $min_bin_param1; 
#$max_bin_param1          = 10                                    unless defined $max_bin_param1;
$max_bin_param1          = 51                                    unless defined $max_bin_param1;
$min_bin_param2          = 1                                     unless defined $min_bin_param2;
$max_bin_param2          = 1                                     unless defined $max_bin_param2; 

$xmlfile                 = "inputs/data.xml"                  unless defined $xmlfile;
$using_xmlfile           = 1                                     unless defined $using_xmlfile;

if( !defined $cput ) {
  if($resource eq "RAL"   ) { $cput = "6:00:00";  }
  if($resource eq "Oxford") { $cput = "11:50:00"; }
}

mkpath ($job_dir, {verbose => 1, mode=>0777}); 
die("$job_dir doesn't exist") unless -d $job_dir;


# Select which toys in the xml files to fit
$nruns = 1;
$nexpts = 1;
$firstexpt = 0;
$irun  = 0;
while($irun < $nruns) {
  print "Submitting run: $irun \n";

  $first = $firstexpt;                # first toy of the job
  $last  = $firstexpt + $nexpts - 1;  # last toy of the job

  print "Jobs w/ toys from $first to $last \n";

  $command = "root2k -l -b -q \'$softw_dir/macros/sensitivity/run_sensitivity_joint_toys_xml.C(\"$xmlfile\",$first,$last,$using_xmlfile,\"$tag\",$irun,\"$config_file\",$stat_fluct,$twk_systematics,\"$fitparamlist\",\"$fitoption\",$store_toy_expts,$store_bestfit_spectra,\"$dmsqscheme\",\"$masshierarchy\",\"$mixparamchoice\",\"$mixparamoctant\",$dcp_value,$reactor,$tolerance,\"$param1\",\"$param2\",$min_bin_param1,$max_bin_param1,$min_bin_param2,$max_bin_param2)\'";

  print "$command \n";
       
  #
  # ETH (Monch cluster), $job_dir not used, $tag gives path/name of output file
  #
  if($resource eq "ETH-Monch") {
      open(PBS, ">/mnt/lnec/davides/VALOR/sbatch_files/run_fit-$irun.sbatch") or die("Can not create the sbatch script");
      print PBS "#!/bin/bash -l  \n";
      print PBS "#SBATCH --partition=dphys_compute_wk  \n";
      #print PBS "#SBATCH --partition=dphys_compute  \n";
      print PBS "#SBATCH --nodes=1  \n";
      print PBS "#SBATCH --ntasks-per-node=1  \n";
      print PBS "#SBATCH --output=/mnt/lnec/davides/VALOR/outputs/out.%j.o  \n";
      print PBS "#SBATCH --error=/mnt/lnec/davides/VALOR/outputs/out.%j.e  \n";
      print PBS "$command \n";
      close(PBS);
      #`sbatch -t 23:59:00 /mnt/lnec/davides/VALOR/sbatch_files/run_fit-$irun.sbatch`;
      `sbatch -t 2-00:00:00 /mnt/lnec/davides/VALOR/sbatch_files/run_fit-$irun.sbatch`;
  }
      
  #
  # RAL
  #
  if($resource eq "RAL") {
     open(PBS, ">$job_dir/$tag-$irun.pbs") or die("Can not create the PBS batch script");
     print PBS "#!/bin/bash \n";
     print PBS "#PBS -N $tag-$irun \n";
     print PBS "#PBS -l cput=$cput \n";
     print PBS "#PBS -o $job_dir/$tag-$irun.pbs.out \n";
     print PBS "#PBS -e $job_dir/$tag-$irun.pbs.err \n";
     print PBS "#PBS -q prod \n";
     print PBS "#PBS -l walltime=$cput \n";
     print PBS "cd $job_dir \n";
     print PBS "source $softw_dir/setup/setup_at_ral.sh $softw_dir\n";
     print PBS "$command \n";
     close(PBS);
     `qsub -q prod $job_dir/$tag-$irun.pbs`;
  }
  #
  # Oxford
  #
  if($resource eq "Oxford") {
     open(PBS, ">$job_dir/$tag-$irun.pbs") or die("Can not create the PBS batch script");
     print PBS "#!/bin/bash \n";
     print PBS "#PBS -N $tag-$irun \n";
     print PBS "#PBS -l cput=$cput \n";
     print PBS "#PBS -o $job_dir/$tag-$irun.pbs.out \n";
     print PBS "#PBS -e $job_dir/$tag-$irun.pbs.err \n";
     print PBS "cd $job_dir \n";
     print PBS "source $softw_dir/setup/setup_at_oxford.sh $softw_dir\n";
     print PBS "$command \n";
     close(PBS);
     `qsub $job_dir/$tag-$irun.pbs`;
  }
  #
  # Grid
  #
  if($resource eq "Grid") {
     print "Not supported just yet!\n";
  }
  #
  # interactive
  #
  if($resource eq "interactive") {
     system($command);
  }

  $firstexpt = $firstexpt + $nexpts;
  
  $irun++;
}
