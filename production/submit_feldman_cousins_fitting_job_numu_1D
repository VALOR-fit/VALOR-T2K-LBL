#!/usr/bin/perl

#
#-----------------------------------------------------------------------------------------------------------------------------
# Submit a batch of numu feldman_cousins_fitting_job.C jobs
#
# Inputs
#  --resource               : <RAL, IN2P3, Oxford, Grid, interactive>. Default: "interactive".
#  --tag                    :
#  --nruns                  :
#  --nexpts                 :
#  --cpu-time               : Default: "6:00:00" for RAL, "1500000" for IN2P3, "11:50:00" for Oxford.
#  --stat-fluctuations      : include statistical fluctuation in toy MC expts.
#  --tweak-systematics      : generate toy MC with randomized systematics.
#  --tweak-non23oscparams   : generate toy MC with randomized dmsq12,theta12,theta13,delta_cp (only in 3-flavour analysis).
#  --min-dm23sq-bin         : Default:   1.
#  --max-dm23sq-bin         : Default:  51.
#  --min-sinsq2theta23-bin  : Default:   1.
#  --max-sinsq2theta23-bin  : Default: 101.
#  --bin-list               : Default:  "" (no input file)
#  --fit-param-list         : Fit parameter list. Default: "nuosc3f_numudisapp_fix4". See FitParamList.h for allowed options.
#  --fit-option             : Option passed to fitter. Default: "minuit".
#  --job-dir                : Directory for job scripts and outputs. Default: `pwd`.
#  --softw-dir              : Oscillation code top-level directory. Default: `pwd`.
#  --config-file            : Analysis configuration file from the config/ directory. Default: "analysis_configuration.xml".
#  --store-toy-expts        : Store the generated toy MC expts? Default: No.
#  --store-bestfit-spectra  : Store the best-fit spectra? Default: No.
#  --dmsq-scheme            : abs23 or fogli
#  --hierarchy              : normal or inverted
#  --mix-param-choice       : sinsq2theta or sinsqtheta
#  --mix-param-octant       : one or two
#
#  --gridpath               : Where, on the t2k.org GRID contrib area, to store the ROOT file
#  --grid-local-dir         : Where to cd to on the RAL machine (so don't have to use the GRID to download the output) (NEEDS TESTING)
#  --autowms-file           : Specifies which locations to run at
#  --grid-username          : for the Grid proxy
#
# C.Andreopoulos
#----------------------------------------------------------------------------------------------------------------------------- 
#

use File::Path;

$iarg=0;
foreach (@ARGV) {
  if($_ eq '--resource'              ) { $resource              = $ARGV[$iarg+1]; }
  if($_ eq '--tag'                   ) { $tag                   = $ARGV[$iarg+1]; }
  if($_ eq '--nruns'                 ) { $nruns                 = $ARGV[$iarg+1]; }
  if($_ eq '--nexpts'                ) { $nexpts                = $ARGV[$iarg+1]; }
  if($_ eq '--cpu-time'              ) { $cput                  = $ARGV[$iarg+1]; }
  if($_ eq '--stat-fluctuations'     ) { $stat_fluct            = 1;              }
  if($_ eq '--tweak-systematics'     ) { $twk_systematics       = 1;              }
  if($_ eq '--tweak-non23oscparams'  ) { $twk_non23osc          = 1;              }
  if($_ eq '--input-dm23sq'          ) { $input_dm23sq          = $ARGV[$iarg+1]; }
  if($_ eq '--input-sinsq2theta23'   ) { $input_sinsq2theta23   = $ARGV[$iarg+1]; }
  if($_ eq '--fit-param-list'        ) { $fitparamlist          = $ARGV[$iarg+1]; }
  if($_ eq '--fit-option'            ) { $fitoption             = $ARGV[$iarg+1]; }
  if($_ eq '--job-dir'               ) { $job_dir               = $ARGV[$iarg+1]; }
  if($_ eq '--softw-dir'             ) { $softw_dir             = $ARGV[$iarg+1]; }
  if($_ eq '--config-file'           ) { $config_file           = $ARGV[$iarg+1]; }
  if($_ eq '--store-toy-expts'       ) { $store_toy_expts       = 1;              }
  if($_ eq '--store-bestfit-spectra' ) { $store_bestfit_spectra = 1;              }
  if($_ eq '--dmsq-scheme'           ) { $dmsqscheme            = $ARGV[$iarg+1]; }
  if($_ eq '--hierarchy'             ) { $masshierarchy         = $ARGV[$iarg+1]; }
  if($_ eq '--mix-param-choice'      ) { $mixparamchoice        = $ARGV[$iarg+1]; }
  if($_ eq '--mix-param-octant'      ) { $mixparamoctant        = $ARGV[$iarg+1]; }
  if($_ eq '--dchisq-file'           ) { $dchisq_file           = $ARGV[$iarg+1]; }
  #if($_ eq '--allow-2nu-unphysical'  ) { $apply_2nu_boundary    = 0;              }
  if($_ eq '--gridpath'              ) { $gridpath              = $ARGV[$iarg+1]; }
  if($_ eq '--grid-local-dir'        ) { $grid_local_dir        = $ARGV[$iarg+1]; }
  if($_ eq '--autowms-file'          ) { $autowms_file          = $ARGV[$iarg+1]; }
  if($_ eq '--grid-username'         ) { $grid_username         = $ARGV[$iarg+1]; }
  $iarg++;
}

$input_dm23sq           = 0.002125                        unless defined $input_dm23sq;
$input_sinsq2theta23    = -999.9                         unless defined $input_sinsq2theta23;
$resource               = "RAL"                         unless defined $resource;
$tag                    = "fc"                          unless defined $tag;
$nruns                  = 100                            unless defined $nruns;
$nexpts                 = 50                          unless defined $nexpts;
$stat_fluct             = 1                             unless defined $stat_fluct;
$twk_systematics        = 1                             unless defined $twk_systematics;
$twk_non23osc           = 1                             unless defined $twk_non23osc;
$fitparamlist           = "nuosc3f_numudisapp_nuis4+nuisance"     unless defined $fitparamlist;
$fitoption              = "minuit"                      unless defined $fitoption;
$job_dir                = "/opt/ppd/t2k/users/nick/t2kana1DFCRun1to4/production"                         unless defined $job_dir;
$softw_dir              = "/opt/ppd/t2k/users/nick/t2kana1DFCRun1to4"                         unless defined $softw_dir;
$config_file            = "2013a_numu_run1+2+3+4_flux11bv3.2_neut13a_banff13v5_sk+fsi.xml"  unless defined $config_file;
$store_toy_expts        = 0                             unless defined $store_toy_expts;
$store_bestfit_spectra  = 0                             unless defined $store_bestfit_spectra;
$dmsqscheme             = "abs23"                       unless defined $dmsqscheme;
$masshierarchy          = "normal"                      unless defined $masshierarchy;
$mixparamchoice         = "sinsqtheta"                  unless defined $mixparamchoice;
$mixparamoctant         = "one"                         unless defined $mixparamoctant;
$dchisq_file  = "/home/ppd/tdealtry/RAL_repoistory/t2k/t2kana/nuosc/trunk/2013results/DATA/FULLRUN1-4FIXSPLINE/run1-4_nuis4_sintheta_normal/combination/final.root"   unless defined $dchisq_file;
#$apply_2nu_boundary     = 1                             unless defined $apply_2nu_boundary;
$grid_local_dir         = `pwd`                         unless defined $grid_local_dir;
$autowms_file           = "autowms.conf"                unless defined $autowms_file;

if( !defined $cput) {
  if($resource eq "RAL"   ) { $cput = "18:00:00";  }
  if($resource eq "IN2P3" ) { $cput = 1500000;    }
  if($resource eq "Oxford") { $cput = "11:50:00"; }
}

mkpath ($job_dir, {verbose => 1, mode=>0777});
die("$job_dir doesn't exist") unless -d $job_dir;

if( $resource eq "Grid") { $macro_dir = "./";       }
else                     { $macro_dir = $softw_dir; }

$irun = 0;
while($irun < $nruns) {

  print "Submitting $tag run: $irun \n";

  $command  = "root2k -l -b -q \'$macro_dir/macros/limits/fc/feldman_cousins_fitting_job_1D.C(\"$tag\",$irun,$nexpts,$input_dm23sq,$input_sinsq2theta23,\"$config_file\",$stat_fluct,$twk_systematics,$twk_non23osc,\"$fitparamlist\",\"$fitoption\",$store_toy_expts,$store_bestfit_spectra,\"$dmsqscheme\",\"$masshierarchy\",\"$mixparamchoice\",\"$mixparamoctant\",\"$dchisq_file\")\'";
  print "$command \n";

  #
  # RAL
  #
  if($resource eq "RAL") {
     open(PBS, ">$job_dir/$tag-$irun.pbs") or die("Can not create the PBS batch script");
     print PBS "#!/bin/bash \n";
     print PBS "#PBS -N $tag-$irun \n";
     print PBS "#PBS -l walltime=$cput \n";
     print PBS "#PBS -l cput=$cput \n";
     print PBS "#PBS -o $job_dir/$tag-$irun.pbs.out \n";
     print PBS "#PBS -e $job_dir/$tag-$irun.pbs.err \n";
     print PBS "cd $job_dir/ \n";
     print PBS "source $softw_dir/setup/setup_at_ral.sh $softw_dir\n";
     print PBS "$command \n";
     close(PBS);
     `qsub -q prod $job_dir/$tag-$irun.pbs`;
  }
  #
  # IN2P3
  #
  if($resource eq "IN2P3") {
     open(PBS, ">$job_dir/$tag-$irun.pbs") or die("Can not create the PBS batch script");
     print PBS "#!/bin/tcsh \n";
     print PBS "cd $job_dir/ \n";
     print PBS "source $softw_dir/setup/setup_at_in2p3.csh $softw_dir\n";
     print PBS "$command \n";
     close(PBS);
     `chmod +x $job_dir/$tag-$irun.pbs`;
     `qsub -eo -V -l platform=LINUX,t=$cput,M=2200MB,scratch=500MB,u_sps_babar -o $job_dir/$tag-$irun.pbs.out -N $tag-$irun $job_dir/$tag-$irun.pbs`;
  }
  #
  # Oxford
  #
  if($resource eq "Oxford") {
      open(PBS, ">$job_dir/$tag-$irun.pbs") or die("Can not create the PBS batch script");
      print PBS "#!/bin/bash \n";
      print PBS "#PBS -N $tag-$irun \n";
      print PBS "#PBS -l cput=$cput \n";
      print PBS "#PBS -o $job_dir/$tag-$irun.pbs.out \n";
      print PBS "#PBS -e $job_dir/$tag-$irun.pbs.err \n";
      print PBS "cd $job_dir/ \n";
      print PBS "source $softw_dir/setup/setup_at_oxford.sh $softw_dir\n";
      print PBS "$command \n";
      close(PBS);
     `qsub $job_dir/$tag-$irun.pbs`;
  }
  #
  # Grid
  #
  if($resource eq "Grid") {
    die("gridpath isn't specified") unless defined $gridpath;
    die("grid username isn't specified") unless defined $grid_username;
    $grid_root_filename="$tag-run_$irun.root";
    # First write the JDL file
    open(JDL, ">$tag-$irun.jdl") or die("Can not create the JDL script");
    print JDL "Executable = \"$tag-$irun.sh\"; \n";
    print JDL "StdOutput = \"$tag-$irun.out\"; \n";
    print JDL "StdError = \"$tag-$irun.err\"; \n";
    print JDL "InputSandbox = {\"$tag-$irun.sh\"}; \n";
    print JDL "OutputSandbox = {\"$tag-$irun.out\",\"$tag-$irun.err\",\"$grid_root_filename\"}; \n";
    print JDL "VirtualOrganisation = \"t2k.org\"; \n";
    print JDL "Requirements = other.GlueCEInfoHostName == \"heplnx206.pp.rl.ac.uk\" || other.GlueCEInfoHostName == \"heplnx207.pp.rl.ac.uk\" || other.GlueCEInfoHostName == \"heplnx208.pp.rl.ac.uk\"; \n";
    print JDL "MyProxyServer = \"lcgrbp01.gridpp.rl.ac.uk\"; \n";
    
    # Then write the executable for the JDL file
    open(SH, ">$tag-$irun.sh") or die("Can not create the .sh batch script");
    print SH "#!/bin/bash \n";
    print SH "# time as a UNIX timestamp \n" ;                                                                                                                                  
    print SH "T0=\"\$\(date +\%s)\"\n";
    print SH "# setup env vars \n";
    print SH "export LFC_HOST=lfc.gridpp.rl.ac.uk\n";
    print SH "export GLOBUS_FTP_CLIENT_GRIDFTP2=true\n";
    print SH "# trap error and remove code if error happens \n";
    print SH "P=\$PWD \n";
    print SH "echo \"*** Setting up environmental variables...\" \n";
    print SH "source $softw_dir/setup/setup_at_ral.sh $softw_dir \n";
    print SH "echo \"*** Running the macro...\"\n";
    print SH "cd $grid_local_dir \n";
    print SH "$command\n";
    print SH "# try to handle failure of the macro (exit \!= 0)\n";
    print SH "if \[ \"\$\?\" \= \"0\" \]; then\n";
    print SH "       lcg-cr -v --vo t2k.org file:./$grid_root_filename -l lfn:/grid/t2k.org/nd280/contrib/dealtry/$gridpath/$grid_root_filename -d srm://srm-t2k.gridpp.rl.ac.uk/castor/ads.rl.ac.uk/prod/t2k.org/nd280/contrib/dealtry/$gridpath/$grid_root_filename \n";
    print SH "       echo \"*** Total time: \$\{T\}\"\n";
    print SH "       echo Done!\n";
    print SH "else\n";
    print SH "       echo Error happened!!!\n";
    print SH "       T=\"\$\(\(\$\(date +\%s\)-T0\)\)\"\n";
    print SH "       echo \"*** Total time: \$\{T\}\"\n";
    print SH "       exit\n";
    print SH "fi\n";
    print SH "#echo Done!\n";
  }
  #
  # interactive
  #
  if($resource eq "interactive") {
     system($command);
  }

  $irun++;
}

if($resource eq "Grid") {
  # Finally write the sh bash script to handle the job submission
  open(SH0, ">$tag.sh") or die("Can not create the .sh batch script");
  print SH0 "#!/bin/bash \n";
  print SH0 "echo \"*** Creating proxy...\" \n";
  print SH0 "export LFC_HOST=lfc.gridpp.rl.ac.uk \n";
  print SH0 "export MYPROXY_SERVER=lcgrbp01.gridpp.rl.ac.uk \n";
  print SH0 "export LCG_GFAL_INFOSYS=lcg-bdii.gridpp.ac.uk:2170 \n";
  print SH0 "voms-proxy-init -valid 160:0 -voms t2k.org \n";
  print SH0 "export USERG='$grid_username' \n";
  print SH0 "glite-wms-job-delegate-proxy -d \$USERG -e https://wms01.grid.hep.ph.ic.ac.uk:7443/glite_wms_wmproxy_server \n";
  print SH0 "myproxy-init -v -d -n -s \$MYPROXY_SERVER --voms t2k.org:/t2k.org \n";
  print SH0 "echo \"*** Submitting jobs to the GRID...\" \n";
  $irun = 0;
  while($irun < $nruns) {
    #print SH0 "glite-wms-job-submit -a -c $softw_dir/production/grid/$autowms_file -o $tag.jid $tag-$irun.jdl\n";
    print SH0 "glite-wms-job-submit -d \$USERG -c $softw_dir/production/grid/$autowms_file -o $tag.jid $tag-$irun.jdl\n";
    $irun++;
  }
  `chmod +x $tag.sh`;
  #`./$tag.sh`;
}

