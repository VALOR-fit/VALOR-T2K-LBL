#! /usr/bin/perl -w
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# VALOR/t2xk configuration script
#
# For help, type ./configure --help
#
# Costas Andreopoulos <costas.andreopoulos \at stfc.ac.uk>
# Tom Dealtry <t.dealtry \at lancaster.ac.uk>
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

# print out info & exit if any of the command-line arguments was --help
#
if(($match = grep(/--help/i, @ARGV)) > 0) { 
  print "\n";
  print "*** VALOR/t2xk configure script *** \n\n";
  print "Usage: ./configure [option]... [flag=value]... \n\n";
  print "    FLAG              DESCRIPTION                                                 DEFAULT\n\n";
  print "    --prefix          installation location (for 'make install')                  /usr/local/\n";
  print "\n enable/disable options with either --enable- or --disable- (eg --enable-debug --disable-gsl)\n\n";
  print "    debug             Adds -g in the compiler options to request debug info       default: disabled \n";
  print "\n options for 3rd party software, prefix with --with- (eg --with-log4cpp-lib=/some/path/)\n\n";
  print "    optimiz-level     Compiler optimization (any of O,O2,O3,OO,Os)                default: O2 \n";
  print "\n VALOR/t2xk running options\n\n";
  print "     --fhc-running              Run with FHC 1-ring samples (neutrino enhanced)      default: off \n";
  print "     --rhc-running              Run with RHC 1-ring samples (anti-neutrino enhanced) default: off \n";
  print "     --multiring-fhc-running    Run with FHC multiring samples                       default: off \n";
  print "     --multiring-fhc-nue        Run with FHC multiring nue samples                   default: off \n";
  print "     --multiring-fhc-numu       Run with FHC multiring numu samples                  default: off \n";
  print "     --numudisap-only           Run with 1Rmu samples only                           default: off \n";
  print "     --nueapp-only              Run with 1Re samples only                            default: off \n";
  print "     --use_osc_numu             Run with nue->numu samples (rescale flux, not specific SKMC)           default: off \n";
  print "     --use_osc_numubar          Run with nuebar->numubar samples (rescale flux, not specific SKMC)     default: off \n";
  print "     --use_old_osc_nuebar       Run with old numubar->nuebar samples (rescale flux, not specific SKMC) default: off \n";
  print "\n If the printout was too long then pipe it through a pager, eg: \n";
  print "./configure --help | less \n";
  exit 0;
}

# Check that $T2KOSCANA is set
#
$T2KOSCANA = $ENV{'T2KOSCANA'};
die ("*** Error *** The T2KOSCANA environmental variable is not defined") 
unless defined $T2KOSCANA;

# Check that $VALOR_FMWK is set
#
$VALOR_FMWK = $ENV{'VALOR_FMWK'};
die ("*** Error *** The VALOR_FMWK environmental variable is not defined") 
unless defined $VALOR_FMWK;

# Check that $ROOTSYS is set
#
$ROOTSYS = $ENV{'ROOTSYS'};
die ("*** Error *** The ROOTSYS environmental variable is not defined. Is ROOT installed?") 
unless defined $ROOTSYS;

# Enable auto-detection?
#
system("find $T2KOSCANA/configure");
print "\n";
$auto_detect = ($?==0) ? 1 : 0;
if(! $auto_detect) {
  print "\n*** Warning *** Path auto-detection is turned off. You need the 'find' utility to use that feature\n\n";
}

print "\nYour input configuration options were: @ARGV";
if($#ARGV < 0) { print "(none)" };
print "\n\n";

# Print VALOR/FMWK banner 
#
$BANNER_FILE = "$T2KOSCANA/data/banner/banner.dat";
if(-e $BANNER_FILE) {
  open(BANNER, "<$BANNER_FILE");
  @hdr=<BANNER>;
  print @hdr;
  close(BANNER);
  print "\n";
}

# 
# Process inputs
# 

# Create a string by joining all the command line arguments
#
my $options = join(" ", @ARGV);

# Get & save installation location (--prefix) or set default
#
my $opt_prefix="/usr/local/";
if(($match = grep(/--prefix/i, @ARGV)) > 0) { 
  $options=~m/--prefix=(\S*)/i;
  $opt_prefix = $1;
  if( $T2KOSCANA eq $opt_prefix ) {
     print "*** Error *** --prefix can not point to the T2KOSCANA top level directory!\n\n";
     exit 1;
  }
}

# Default --enable/--disable config options (for a minimal build)
#
my $opt_enable_debug      = "NO";

# Check configure's command line arguments for non-default values
#
if(($match = grep(/--enable-debug/i, @ARGV)) > 0) { $opt_enable_debug  = "YES"; }

my $opt_with_cxx_debug_flag="";
if($opt_enable_debug eq "YES") { $opt_with_cxx_debug_flag = "-g"; }


# Check compiler optimization level
#
my $opt_with_cxx_optimiz_flag="O2"; # default
if( $options=~m/--with-optimiz-level=(\S*)/i ) {
  $opt_with_cxx_optimiz_flag = $1;
}

print "\n";

# 
# Read version info and automatically generate a header file with relevant flags that
# can be used to make code conditional upon specific version numbers
#
$VRS_FILENAME = "$T2KOSCANA/VERSION";
open(VRS_FILE, "<$VRS_FILENAME") or die("Can not read the T2KOSCANA version information!");
@vrs_file=<VRS_FILE>;
close(VRS_FILE);
chomp($release = $vrs_file[0]);
# ($major, $minor, $rev) = split('.', $release);
# note: split() doesn't split on dots...
$release=~m/(\d+).(\d+).(\d+)/;
$major = $1;
$minor = $2;
$revis = $3;
$VRS_HEADER_FILENAME = "$T2KOSCANA/fitter/Version.h";
print "Automatically generating file: $VRS_HEADER_FILENAME \n";
open(VRS_HEADER_FILE, ">$VRS_HEADER_FILENAME") or die("Can not write out the Version.h file!");
print VRS_HEADER_FILE "#ifndef _T2KOSCANA_VERSION_H_ \n";
print VRS_HEADER_FILE "#define _T2KOSCANA_VERSION_H_ \n";
print VRS_HEADER_FILE "/* \n";
print VRS_HEADER_FILE " * Version information automatically generated by the VALOR/FMWK installer \n";
print VRS_HEADER_FILE " * \n";
print VRS_HEADER_FILE " * These macros can be used in the following way (as the ones at ROOT's RVersion.h): \n";
print VRS_HEADER_FILE " * #if __T2KOSCANA_RELEASE_CODE__ >= GRELCODE(2,4,11) \n";
print VRS_HEADER_FILE " * #include <newheader.h>\n";
print VRS_HEADER_FILE " * #else\n";
print VRS_HEADER_FILE " * #include <oldheader.h>\n";
print VRS_HEADER_FILE " * #endif\n";
print VRS_HEADER_FILE "*/ \n\n";
print VRS_HEADER_FILE "#define T2KOSCANA_RELEASE_CODE_BUILDER(a,b,c) (((a) << 16) + ((b) << 8) + (c)) \n\n";
print VRS_HEADER_FILE "#define __T2KOSCANA_RELEASE__      \"$release\"\n";
print VRS_HEADER_FILE "#define __T2KOSCANA_RELEASE_CODE__ T2KOSCANA_RELEASE_CODE_BUILDER($major,$minor,$revis) \n\n";
print VRS_HEADER_FILE "#endif\n\n";
close(VRS_HEADER_FILE);

# 
# Automatically generate a header file with relevant build information that
# can be used to make code conditional upon it
#
$BLD_HEADER_FILENAME = "$T2KOSCANA/fitter/Build.h";
print "Automatically generating file: $BLD_HEADER_FILENAME \n";
open(BLD_HEADER_FILE, ">$BLD_HEADER_FILENAME") or die("Can not write out the Build.h file!");
print BLD_HEADER_FILE "#ifndef _t2kana_build_h_ \n";
print BLD_HEADER_FILE "#define _t2kana_build_h_ \n";
print BLD_HEADER_FILE "/* \n";
print BLD_HEADER_FILE " * Version information automatically generated by the VALOR/FMWK installer \n";
print BLD_HEADER_FILE " */ \n\n";
print BLD_HEADER_FILE "\n\n";
# the VALOR/T2XK options
foreach (@ARGV) {
  if($_ eq '--fhc-running') {
      print BLD_HEADER_FILE "// For forward horn current running. \n";
      print BLD_HEADER_FILE "#define __FHC_RUNNING__ \n\n";
  }
  elsif($_ eq '--rhc-running') {
      print BLD_HEADER_FILE "// For reverse horn current running. \n";
      print BLD_HEADER_FILE "#define __RHC_RUNNING__ \n\n";
  }
  elsif($_ eq '--multiring-fhc-running') {
      print BLD_HEADER_FILE "// For multi-ring forward horn current running. \n";
      print BLD_HEADER_FILE "#define __MULTIRING_FHC_RUNNING__ \n\n";
  }
  elsif($_ eq '--multiring-fhc-nue') {
      print BLD_HEADER_FILE "// For multi-ring forward horn current running nue sample. \n";
      print BLD_HEADER_FILE "#define __MULTIRING_FHC_NUE__ \n\n";
  }
  elsif($_ eq '--multiring-fhc-numu') {
      print BLD_HEADER_FILE "// For multi-ring forward horn current running numu sample. \n";
      print BLD_HEADER_FILE "#define __MULTIRING_FHC_NUMU__ \n\n";
  }  
  elsif($_ eq '--numudisap-only') { 
     print BLD_HEADER_FILE "// Sets BANFF_BINS, FSI_BINS, and kSKSamples appropriately. \n";
     print BLD_HEADER_FILE "#define __NUMUONLY__ \n\n";
  }
  elsif($_ eq '--nueapp-only') {
      print BLD_HEADER_FILE "// Sets BANFF_BINS, FSI_BINS, and kSKSamples appropriately. \n";
      print BLD_HEADER_FILE "#define __NUEONLY__ \n\n";
  }
  elsif($_ eq '--use_osc_numu') {
      print BLD_HEADER_FILE " // Use osc numu mc templates \n";
      print BLD_HEADER_FILE "#define __USE_OSC_NUMU_MC_TEMPLATES__\n\n";
  }
  elsif($_ eq '--use_osc_numubar') {
      print BLD_HEADER_FILE " // Use osc numubar mc templates \n";
      print BLD_HEADER_FILE "#define __USE_OSC_NUMUBAR_MC_TEMPLATES__\n\n";
  }
  elsif($_ eq '--use_old_osc_nuebar') {
      print BLD_HEADER_FILE " // Use 2013 osc nuebar mc templates \n";
      print BLD_HEADER_FILE "#define __USE_OLD_OSC_NUEBAR_MC_TEMPLATES__\n\n";
  }
  else {
     print "Unrecognised option: ",$_,"\n";
  }

}
print BLD_HEADER_FILE "#endif\n\n";
close(BLD_HEADER_FILE);


#
# Save config options to src/make/Make.config for inclusion in other Makefiles
#
# Open Make.config to write configuration options
#
$MKCONF_FILENAME = "$T2KOSCANA/make/Make.config";
print "Automatically generating file: $MKCONF_FILENAME \n";
open(MKCONF, ">$MKCONF_FILENAME") or die("Can not write out the Make.config file!");
print MKCONF "# \n";
print MKCONF "# Make.config \n";
print MKCONF "# This file was automatically generated by the VALOR/FMWK installer \n";
print MKCONF "# for inclusion into the project Makefiles  \n";
print MKCONF "# \n";
print MKCONF "OPT_PREFIX=$opt_prefix\n";
print MKCONF "OPT_WITH_CXX_DEBUG_FLAG=$opt_with_cxx_debug_flag\n";
print MKCONF "OPT_WITH_CXX_OPTIMIZ_FLAG=-$opt_with_cxx_optimiz_flag\n";
close(MKCONF);
if(-e $MKCONF_FILENAME) {
  print "\nThe following config options were set in Make.config: \n";
  open(MKCONFR, "<$MKCONF_FILENAME") or die("Can not read back the $T2KOSCANA/src/make/Make.config!");
  @make_conf=<MKCONFR>;
  close(MKCONFR);
# print "@make_conf\n" unless ;
  foreach $setting (@make_conf) { 
    chomp($setting); 
    if ($setting=~m/\=/) {print "  $setting\n";} 
  }
  print "\n";
  print "*** To continue building VALOR/FMWK type: gmake ";
  # Warning for SRT users  
  if(defined $ENV{'SRT_ENV_SET'}) {
    print "(Don't forget to 'srt_setup --unsetup' first)";
  }
  print "\n\n";
}

sub auto_detect {

  @search_dir  = ("/usr","/opt","/lib");           # std search paths
  push (@search_dir,"$ENV{'HOME'}") 
                 if defined $ENV{'HOME'};          # add $HOME
  push (@search_dir,"/hep");                       # add where I add ext apps in my mac book air
  push (@search_dir,"$ENV{'RSD_TOP_DIR'}") 
                 if defined $ENV{'RSD_TOP_DIR'};   # add where RSD puts ext supporting libs

  $search_file = shift; 
  $optional_fullpath_substr = shift; # extra help in locating the correct file

  $optional_fullpath_substr = "" unless defined $optional_fullpath_substr;

  foreach(@search_dir) {
     $curr_dir = $_;
     if(! -d $curr_dir) {next;}
     @matches = `find $curr_dir -type f -maxdepth 7 -name $search_file 2> /dev/null | grep \"$optional_fullpath_substr\"`;
     $nmatches = @matches;
     if( $nmatches > 0) { return $matches[0]; }
  }
  return "";
}
