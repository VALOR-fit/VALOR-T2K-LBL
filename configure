#! /usr/bin/perl -w
#
# Creates the Build.h header file
#
# Options: 
#    --enable-gsl-fitter
#    --production-mode
#    --fhc-running
#    --rhc-running
#    --multiring-fhc-running
#    --numudisap-only
#    --nueapp-only
#    --seed-trandom-zero
#    --use_osc_numu
#    --use_osc_numubar
#    --use_osc_nuebar
#

$T2KOSCANA = $ENV{'T2KOSCANA'};
die ("Not even the T2KOSCANA environmental variable is defined!") unless defined $T2KOSCANA;

$BLD_FILE = "$T2KOSCANA/fitter/Build.h";
open(BLD, ">$BLD_FILE") or die("Can not write the Build.h file!");

print BLD "#ifndef _t2kana_build_h_ \n";
print BLD "#define _t2kana_build_h_ \n";
print BLD "\n\n";

foreach (@ARGV) {

  if($_ eq '--enable-gsl-fitter') { 
     print BLD "#define __GSL_ENABLED__ \n\n";
  }

  elsif($_ eq '--production-mode') { 
     print BLD "// If turned on, code is made faster by not filling (or even initialising) histograms. \n";
     print BLD "// This causes some macros to fail (mostly those in spectra). \n";
     print BLD "#define PRODUCTIONMODE \n\n";
  }

  elsif($_ eq '--fhc-running') {
      print BLD "// For forward horn current running. \n";
      print BLD "#define __FHC_RUNNING__ \n\n";
  }

  elsif($_ eq '--rhc-running') {
      print BLD "// For reverse horn current running. \n";
      print BLD "#define __RHC_RUNNING__ \n\n";
  }

  elsif($_ eq '--multiring-fhc-running') {
      print BLD "// For reverse multi-ring forward current running. \n";
      print BLD "#define __MULTIRING_FHC_RUNNING__ \n\n";
  }

  elsif($_ eq '--numudisap-only') { 
     print BLD "// Sets BANFF_BINS, FSI_BINS, and kSKSamples appropriately. \n";
     print BLD "#define __NUMUONLY__ \n\n";
  }

  elsif($_ eq '--nueapp-only') {
      print BLD "// Sets BANFF_BINS, FSI_BINS, and kSKSamples appropriately. \n";
      print BLD "#define __NUEONLY__ \n\n";
  }

  elsif($_ eq '--seed-trandom-zero') {
      print BLD "// Rnd constructs TRandom with zero seeds if requested, rather than reading /dev/urandom \n";
      print BLD "#define __SEED_TRANDOM_ZERO__\n\n";
  }
  
  elsif($_ eq '--use_osc_numu') {
      print BLD " // Use osc numu mc templates \n";
      print BLD "#define __USE_OSC_NUMU_MC_TEMPLATES__\n\n";
  }

  elsif($_ eq '--use_osc_numubar') {
      print BLD " // Use osc numubar mc templates \n";
      print BLD "#define __USE_OSC_NUMUBAR_MC_TEMPLATES__\n\n";
  }
 
  elsif($_ eq '--use_old_osc_nuebar') {
      print BLD " // Use 2013 osc nuebar mc templates \n";
      print BLD "#define __USE_OLD_OSC_NUEBAR_MC_TEMPLATES__\n\n";
  }

  else {
     print "Unrecognised option: ",$_,"\n";
  }

}

print BLD "\n#endif\n\n";

close(BLD);

